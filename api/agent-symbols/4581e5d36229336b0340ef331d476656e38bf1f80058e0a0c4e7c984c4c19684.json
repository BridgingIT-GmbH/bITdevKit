{"schemaVersion":1,"source":"docfx-mref-page","file":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.yml","symbols":[{"uid":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions","name":"DevKitWebApplicationBuilderDevAppInstanceExtensions","fullName":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions","kind":"Class","namespace":"BridgingIT.DevKit.Presentation.Web","assembly":"BridgingIT.DevKit.Presentation.Web","summary":"Configures linked-worktree development isolation on a BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder. Isolation is on by default, so these extensions only change the defaults, turn isolation off or read the resolved context.","remarks":null,"syntax":{"content":"public static class DevKitWebApplicationBuilderDevAppInstanceExtensions","parameters":[],"returns":null},"parameters":[],"returns":null,"parent":"BridgingIT.DevKit.Presentation.Web","children":["BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.AddDevAppInstance(BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder)","BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.AddDevAppInstance(BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder,System.Action{BridgingIT.DevKit.Common.DevAppInstanceBuilder})","BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.ContextPropertyKey","BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.GetDevAppInstance(BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder)"],"extensionMethods":[],"examples":[],"url":"https://bridgingit-gmbh.github.io/bITdevKit/api/obj/api/BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.html","topics":["application","presentation"]},{"uid":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.ContextPropertyKey","name":"ContextPropertyKey","fullName":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.ContextPropertyKey","kind":"Field","namespace":"BridgingIT.DevKit.Presentation.Web","assembly":"BridgingIT.DevKit.Presentation.Web","summary":"The builder property key that holds the BridgingIT.DevKit.Common.DevAppInstanceSession with the resolved context.","remarks":null,"syntax":{"content":"public const string ContextPropertyKey = \u0022BridgingIT.DevKit.DevAppInstance.Context\u0022","parameters":[],"returns":{"type":"System.String","description":null}},"parameters":[],"returns":{"type":"System.String","description":null},"parent":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions","children":[],"extensionMethods":[],"examples":[],"url":"https://bridgingit-gmbh.github.io/bITdevKit/api/obj/api/BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.html#BridgingIT_DevKit_Presentation_Web_DevKitWebApplicationBuilderDevAppInstanceExtensions_ContextPropertyKey","topics":["application","presentation"]},{"uid":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.AddDevAppInstance(BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder)","name":"AddDevAppInstance(DevKitWebApplicationBuilder)","fullName":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.AddDevAppInstance(BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder)","kind":"Method","namespace":"BridgingIT.DevKit.Presentation.Web","assembly":"BridgingIT.DevKit.Presentation.Web","summary":"Configures linked-worktree development isolation with defaults only, and activates it now instead of at the first configuration consumer. Isolation is on by default, so this call is only needed to activate early.","remarks":"When isolation fails in a linked worktree, the host falls back to its configured ports and databases and writes the failure as a [BDK] warning. The context then reports BridgingIT.DevKit.Common.DevAppInstanceInactiveReasons.Fallback.","syntax":{"content":"public static DevKitWebApplicationBuilder AddDevAppInstance(this DevKitWebApplicationBuilder builder)","parameters":[{"id":"builder","type":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder","description":"The DevKit web application builder."}],"returns":{"type":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder","description":"The same builder for fluent chaining."}},"parameters":[{"id":"builder","type":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder","description":"The DevKit web application builder."}],"returns":{"type":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder","description":"The same builder for fluent chaining."},"parent":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions","children":[],"extensionMethods":[],"examples":[],"url":"https://bridgingit-gmbh.github.io/bITdevKit/api/obj/api/BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.html#BridgingIT_DevKit_Presentation_Web_DevKitWebApplicationBuilderDevAppInstanceExtensions_AddDevAppInstance_BridgingIT_DevKit_Presentation_Web_DevKitWebApplicationBuilder_","topics":["application","presentation"]},{"uid":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.AddDevAppInstance(BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder,System.Action{BridgingIT.DevKit.Common.DevAppInstanceBuilder})","name":"AddDevAppInstance(DevKitWebApplicationBuilder, Action)","fullName":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.AddDevAppInstance(BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder, System.Action)","kind":"Method","namespace":"BridgingIT.DevKit.Presentation.Web","assembly":"BridgingIT.DevKit.Presentation.Web","summary":"Configures linked-worktree development isolation and activates it now. Isolation is on by default for every DevKit web host, so call this only to change the defaults or to turn it off with BridgingIT.DevKit.Common.DevAppInstanceBuilder.Enabled(System.Boolean). Call after configuration composition and before logging, modules, DbContext registrations or the build, because the first of those activates the defaults. In the Development environment the database adapters of referenced EF Core provider packages are found automatically. Without BridgingIT.DevKit.Common.DevAppInstanceBuilder.WithAppId(System.String), the application ID derives from the host application name. Without BridgingIT.DevKit.Common.DevAppInstanceBuilder.WithHttpOffset(System.Int32%2cSystem.Nullable%7bSystem.Int32%7d), the registry assigns the port offsets.","remarks":"When isolation fails in a linked worktree, the host falls back to its configured ports and databases and writes the failure as a [BDK] warning. The context then reports BridgingIT.DevKit.Common.DevAppInstanceInactiveReasons.Fallback.","syntax":{"content":"public static DevKitWebApplicationBuilder AddDevAppInstance(this DevKitWebApplicationBuilder builder, Action configure)","parameters":[{"id":"builder","type":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder","description":"The DevKit web application builder."},{"id":"configure","type":"System.Action{BridgingIT.DevKit.Common.DevAppInstanceBuilder}","description":"The declaration callback."}],"returns":{"type":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder","description":"The same builder for fluent chaining."}},"parameters":[{"id":"builder","type":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder","description":"The DevKit web application builder."},{"id":"configure","type":"System.Action{BridgingIT.DevKit.Common.DevAppInstanceBuilder}","description":"The declaration callback."}],"returns":{"type":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder","description":"The same builder for fluent chaining."},"parent":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions","children":[],"extensionMethods":[],"examples":[],"url":"https://bridgingit-gmbh.github.io/bITdevKit/api/obj/api/BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.html#BridgingIT_DevKit_Presentation_Web_DevKitWebApplicationBuilderDevAppInstanceExtensions_AddDevAppInstance_BridgingIT_DevKit_Presentation_Web_DevKitWebApplicationBuilder_System_Action_BridgingIT_DevKit_Common_DevAppInstanceBuilder__","topics":["application","common","presentation"]},{"uid":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.GetDevAppInstance(BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder)","name":"GetDevAppInstance(DevKitWebApplicationBuilder)","fullName":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.GetDevAppInstance(BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder)","kind":"Method","namespace":"BridgingIT.DevKit.Presentation.Web","assembly":"BridgingIT.DevKit.Presentation.Web","summary":"Gets the resolved development instance context. Activates the defaults first when nothing activated isolation yet.","remarks":null,"syntax":{"content":"public static DevAppInstanceContext GetDevAppInstance(this DevKitWebApplicationBuilder builder)","parameters":[{"id":"builder","type":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder","description":"The DevKit web application builder."}],"returns":{"type":"BridgingIT.DevKit.Common.DevAppInstanceContext","description":"The context."}},"parameters":[{"id":"builder","type":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilder","description":"The DevKit web application builder."}],"returns":{"type":"BridgingIT.DevKit.Common.DevAppInstanceContext","description":"The context."},"parent":"BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions","children":[],"extensionMethods":[],"examples":[],"url":"https://bridgingit-gmbh.github.io/bITdevKit/api/obj/api/BridgingIT.DevKit.Presentation.Web.DevKitWebApplicationBuilderDevAppInstanceExtensions.html#BridgingIT_DevKit_Presentation_Web_DevKitWebApplicationBuilderDevAppInstanceExtensions_GetDevAppInstance_BridgingIT_DevKit_Presentation_Web_DevKitWebApplicationBuilder_","topics":["application","presentation"]}]}