{"schemaVersion":1,"source":"docfx-mref-page","file":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration.yml","symbols":[{"uid":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration","name":"CorsConfiguration","fullName":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration","kind":"Class","namespace":"BridgingIT.DevKit.Presentation.Web","assembly":"BridgingIT.DevKit.Presentation.Web","summary":"Configuration for Cross-Origin Resource Sharing (CORS) policies.","remarks":"CORS allows controlled access to resources from different origins (domains). Configure policies per environment to balance security with development flexibility. Example configuration in appsettings.json: { \u0022Cors\u0022: { \u0022Enabled\u0022: true, \u0022DefaultPolicy\u0022: \u0022DefaultPolicy\u0022, \u0022Policies\u0022: { \u0022DefaultPolicy\u0022: { \u0022AllowedOrigins\u0022: [\u0022https://example.com\u0022], \u0022AllowAnyMethod\u0022: true, \u0022AllowAnyHeader\u0022: true, \u0022AllowCredentials\u0022: true } } } } See: https://learn.microsoft.com/en-us/aspnet/core/security/cors","syntax":{"content":"public class CorsConfiguration","parameters":[],"returns":null},"parameters":[],"returns":null,"parent":"BridgingIT.DevKit.Presentation.Web","children":["BridgingIT.DevKit.Presentation.Web.CorsConfiguration.#ctor","BridgingIT.DevKit.Presentation.Web.CorsConfiguration.DefaultPolicy","BridgingIT.DevKit.Presentation.Web.CorsConfiguration.Enabled","BridgingIT.DevKit.Presentation.Web.CorsConfiguration.Policies"],"extensionMethods":[],"examples":[],"url":"https://bridgingit-gmbh.github.io/bITdevKit/api/obj/api/BridgingIT.DevKit.Presentation.Web.CorsConfiguration.html","topics":["presentation"]},{"uid":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration.#ctor","name":"CorsConfiguration()","fullName":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration.CorsConfiguration()","kind":"Constructor","namespace":"BridgingIT.DevKit.Presentation.Web","assembly":"BridgingIT.DevKit.Presentation.Web","summary":null,"remarks":null,"syntax":{"content":"public CorsConfiguration()","parameters":[],"returns":null},"parameters":[],"returns":null,"parent":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration","children":[],"extensionMethods":[],"examples":[],"url":"https://bridgingit-gmbh.github.io/bITdevKit/api/obj/api/BridgingIT.DevKit.Presentation.Web.CorsConfiguration.html#BridgingIT_DevKit_Presentation_Web_CorsConfiguration__ctor","topics":["presentation"]},{"uid":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration.Enabled","name":"Enabled","fullName":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration.Enabled","kind":"Property","namespace":"BridgingIT.DevKit.Presentation.Web","assembly":"BridgingIT.DevKit.Presentation.Web","summary":"Gets or sets a value indicating whether CORS is enabled.","remarks":"When false, CORS services and middleware are not registered, and all cross-origin requests will be blocked by the browser. Default: false","syntax":{"content":"public bool Enabled { get; set; }","parameters":[],"returns":{"type":"System.Boolean","description":null}},"parameters":[],"returns":{"type":"System.Boolean","description":null},"parent":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration","children":[],"extensionMethods":[],"examples":[],"url":"https://bridgingit-gmbh.github.io/bITdevKit/api/obj/api/BridgingIT.DevKit.Presentation.Web.CorsConfiguration.html#BridgingIT_DevKit_Presentation_Web_CorsConfiguration_Enabled","topics":["presentation"]},{"uid":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration.DefaultPolicy","name":"DefaultPolicy","fullName":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration.DefaultPolicy","kind":"Property","namespace":"BridgingIT.DevKit.Presentation.Web","assembly":"BridgingIT.DevKit.Presentation.Web","summary":"Gets or sets the name of the default policy to apply globally to all endpoints.","remarks":"If specified, this policy will be applied to all endpoints unless overridden by [EnableCors] attribute. The policy name must exist in the BridgingIT.DevKit.Presentation.Web.CorsConfiguration.Policies dictionary. Leave null to only use endpoint-level policy application via [EnableCors] attributes. Example: \u0022DefaultPolicy\u0022","syntax":{"content":"public string DefaultPolicy { get; set; }","parameters":[],"returns":{"type":"System.String","description":null}},"parameters":[],"returns":{"type":"System.String","description":null},"parent":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration","children":[],"extensionMethods":[],"examples":[],"url":"https://bridgingit-gmbh.github.io/bITdevKit/api/obj/api/BridgingIT.DevKit.Presentation.Web.CorsConfiguration.html#BridgingIT_DevKit_Presentation_Web_CorsConfiguration_DefaultPolicy","topics":["presentation"]},{"uid":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration.Policies","name":"Policies","fullName":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration.Policies","kind":"Property","namespace":"BridgingIT.DevKit.Presentation.Web","assembly":"BridgingIT.DevKit.Presentation.Web","summary":"Gets or sets the dictionary of named CORS policies.","remarks":"Key: Policy name (used in configuration and [EnableCors] attributes) Value: Policy options defining allowed origins, methods, headers, etc. At least one policy must be defined when BridgingIT.DevKit.Presentation.Web.CorsConfiguration.Enabled is true. Policies can be applied globally via BridgingIT.DevKit.Presentation.Web.CorsConfiguration.DefaultPolicy or per-endpoint using [EnableCors(\u0022PolicyName\u0022)] attributes.","syntax":{"content":"public Dictionary Policies { get; set; }","parameters":[],"returns":{"type":"System.Collections.Generic.Dictionary{System.String,BridgingIT.DevKit.Presentation.Web.CorsPolicyOptions}","description":null}},"parameters":[],"returns":{"type":"System.Collections.Generic.Dictionary{System.String,BridgingIT.DevKit.Presentation.Web.CorsPolicyOptions}","description":null},"parent":"BridgingIT.DevKit.Presentation.Web.CorsConfiguration","children":[],"extensionMethods":[],"examples":[],"url":"https://bridgingit-gmbh.github.io/bITdevKit/api/obj/api/BridgingIT.DevKit.Presentation.Web.CorsConfiguration.html#BridgingIT_DevKit_Presentation_Web_CorsConfiguration_Policies","topics":["presentation"]}]}