":"Method","namespace":"BridgingIT.DevKit.Common","assembly":"BridgingIT.DevKit.Common.Utilities","summary":"Detects the checkout that contains startDirectory.","remarks":null,"syntax":{"content":"public static GitCheckoutInfo Detect(string startDirectory, IGitCommandRunner gitRunner = null)","parameters":[{"id":"startDirectory","type":"System.String","description":"The directory to start from, for example the host content root."},{"id":"gitRunner","type":"BridgingIT.DevKit.Common.IGitCommandRunner","description":"The optional Git runner used for inconclusive metadata."}],"returns":{"type":"BridgingIT.DevKit.Common.GitCheckoutInfo","description":"The detected checkout information."}},"parameters":[{"id":"startDirectory","type":"System.String","description":"The directory to start from, for example the host content root."},{"id":"gitRunner","type":"BridgingIT.DevKit.Common.IGitCommandRunner","description":"The optional Git runner used for inconclusive metadata."}],"returns":{"type":"BridgingIT.DevKit.Common.GitCheckoutInfo","description":"The detected checkout information."},"parent":"BridgingIT.DevKit.Common.GitCheckoutDetector","children":[],"extensionMethods":[],"examples":[],"url":"https://bridgingit-gmbh.github.io/bITdevKit/api/obj/api/BridgingIT.DevKit.Common.GitCheckoutDetector.html#BridgingIT_DevKit_Common_GitCheckoutDetector_Detect_System_String_BridgingIT_DevKit_Common_IGitCommandRunner_","topics":["commands_queries","common","utilities"]},{"uid":"BridgingIT.DevKit.Common.GitCheckoutDetector.Canonicalize(System.String)","name":"Canonicalize(string)","fullName":"BridgingIT.DevKit.Common.GitCheckoutDetector.Canonicalize(string)","kind":"Method","namespace":"BridgingIT.DevKit.Common","assembly":"BridgingIT.DevKit.Common.Utilities","summary":"Returns the canonical form of a path with symbolic links resolved and trailing separators removed.","remarks":null,"syntax":{"content":"public static string Canonicalize(string path)","parameters":[{"id":"path","type":"Sys