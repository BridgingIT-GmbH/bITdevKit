@page "/streaming"
@using BridgingIT.DevKit.Examples.DoFiesta.Presentation.Web.Client.Services
@inject StreamingDemoClient Stream
@attribute [RequireAuthentication]
@implements IAsyncDisposable

<PageTitle>DoFiesta - Streaming</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-8">
    <section class="stream-heading">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Secondary">NDJSON streaming</MudText>
            <MudText Typo="Typo.h4">Records as they arrive</MudText>
            <MudText Class="mt-2">Choose a finite Todo export or live ticks. Read records here while the connection stays open.</MudText>
        </div>
        <span class="stream-state" data-testid="ndjson-state" data-state="@Stream.State" role="status">@Stream.State</span>
    </section>

    <MudPaper Outlined="true" Class="pa-5 mt-5">
        <div class="stream-controls">
            <label>Source
                <select data-testid="ndjson-source" value="@this.source" @onchange="ChangeSourceAsync">
                    <option value="finite-raw">Todos · raw records</option>
                    <option value="finite-envelope">Todos · with completion</option>
                    <option value="live">Live ticks</option>
                </select>
            </label>
            <label>Tick interval in milliseconds
                <input data-testid="ndjson-interval" type="number" min="1000" max="60000" step="1000" @bind="this.interval" disabled="@(this.source != "live")" />
            </label>
            <button class="stream-start" data-testid="ndjson-start" @onclick="StartAsync" disabled="@(Stream.State == "connecting" || (this.source == "live" && this.interval is < 1000 or > 60000))">Start stream</button>
            <button class="stream-cancel" data-testid="ndjson-cancel" @onclick="Stream.StopAsync" disabled="@(Stream.State is not ("connecting" or "streaming"))">Cancel</button>
        </div>
    </MudPaper>

    <div class="stream-stats">
        <div><span>Received</span><strong data-testid="ndjson-total" data-count="@Stream.TotalCount">@Stream.TotalCount.ToString("N0")</strong></div>
        <div><span>Recent history</span><strong>@Stream.History.Count <small>/ 200</small></strong></div>
        <div><span>Last heartbeat · UTC</span><strong data-testid="ndjson-heartbeat">@(Stream.LastHeartbeat?.ToString("HH:mm:ss") ?? "—")</strong></div>
    </div>

    @if (Stream.ReasonCode is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">Stream ended: @Stream.ReasonCode. Start a new stream to try again.</MudAlert>
    }

    <MudPaper Outlined="true" Class="stream-console">
        <div class="stream-console-heading"><span>Recent records</span><span>oldest → newest</span></div>
        @if (Stream.History.Count == 0)
        {
            <p class="stream-empty">Start a stream to receive records. Heartbeats keep a live connection active between records.</p>
        }
        <ol data-testid="ndjson-history" start="@(Stream.TotalCount - Stream.History.Count + 1)">
            @foreach (var line in Stream.History)
            {
                <li><code>@line</code></li>
            }
        </ol>
    </MudPaper>
</MudContainer>

@code {
    private string source = "finite-raw";
    private int interval = 1000;
    private bool disposed;

    protected override void OnInitialized() => Stream.Changed += this.Refresh;

    private Task StartAsync() => Stream.StartAsync(this.source, this.interval);

    private async Task ChangeSourceAsync(ChangeEventArgs args)
    {
        await Stream.StopAsync();
        this.source = args.Value?.ToString() ?? "finite-raw";
    }

    private void Refresh()
    {
        if (!this.disposed) { _ = this.InvokeAsync(() => { if (!this.disposed) { this.StateHasChanged(); } }); }
    }

    public async ValueTask DisposeAsync()
    {
        this.disposed = true;
        Stream.Changed -= this.Refresh;
        await Stream.StopAsync();
    }
}
