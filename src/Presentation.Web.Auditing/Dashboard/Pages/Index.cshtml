@inherits RazorSlice<AuditingViewModel>
@implements IUsesLayout<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages._DashboardLayout, DashboardLayoutModel>
<section class="audit-view" data-dashboard-view>
@(await RenderPartialAsync<Style>())
<div class="dashboard-page-toolbar">
    @if (Model.HasDetail) { <a href="@Model.Path" class="btn btn-outline-secondary btn-sm me-auto" title="Back to executions" aria-label="Back to executions"><i class="bi bi-arrow-left" aria-hidden="true"></i></a> }
    <span class="small text-muted">Updated @DateTimeOffset.UtcNow.ToString("HH:mm:ss 'UTC'")</span>
    <a href="@HttpContext.Request.Path@HttpContext.Request.QueryString" class="btn btn-outline-secondary btn-sm" title="Refresh current view" aria-label="Refresh current view"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></a>
    @if (Model.Diagnostics is null) { @(await RenderPartialAsync<Download, AuditingViewModel>(Model)) }
</div>
<nav class="nav nav-pills mb-2" aria-label="Audit review">
    <a class="nav-link @(Model.Diagnostics is null ? "active" : "")" data-dashboard-view="executions" aria-current="@(Model.Diagnostics is null ? "page" : null)" href="@Model.Path">Executions</a>
    <a class="nav-link @(Model.Diagnostics is not null ? "active" : "")" data-dashboard-view="diagnostics" aria-current="@(Model.Diagnostics is not null ? "page" : null)" href="@(Model.Path + "/diagnostics")">Diagnostics</a>
</nav>
@if (Model.Diagnostics is not null)
{
    @(await RenderPartialAsync<Diagnostics, AuditingViewModel>(Model))
}
else if (Model.HasDetail)
{
    @(await RenderPartialAsync<Detail, AuditingViewModel>(Model))
}
else
{
    <form action="@Model.Path" method="get" class="card card-body p-2 mb-2 dashboard-filter-panel" id="audit-filters">
    <div class="row g-2">
        <div class="col-8 col-lg"><label for="audit-key" class="form-label">Business key</label><input id="audit-key" name="key" maxlength="256" value="@HttpContext.Request.Query["key"]" placeholder="contains" title="Matches any part of the business key" class="form-control form-control-sm" /></div>
        <div class="col-4 col-lg"><label for="audit-outcome" class="form-label">Outcome</label><select id="audit-outcome" name="outcome" class="form-select form-select-sm"><option value="">Any</option>@foreach (var outcome in Enum.GetNames<BridgingIT.DevKit.Common.AuditOutcome>()) { <option value="@outcome" selected="@(HttpContext.Request.Query["outcome"] == outcome)">@outcome</option> }</select></div>
    </div>
    <div class="row g-2 mt-1">
        <div class="col-6 col-lg"><label for="audit-from" class="form-label">From UTC</label><div class="input-group input-group-sm">@(await RenderPartialAsync<DateRange, DashboardDateRangeModel>(new("audit-from", "audit-to")))<input id="audit-from" name="fromUtc" type="datetime-local" value="@HttpContext.Request.Query["fromUtc"]" class="form-control form-control-sm" /></div></div>
        <div class="col-6 col-lg"><label for="audit-to" class="form-label">To UTC</label><input id="audit-to" name="toUtc" type="datetime-local" value="@HttpContext.Request.Query["toUtc"]" class="form-control form-control-sm" /></div>
        <div class="col-6 col-lg"><label for="audit-lifecycle" class="form-label">Lifecycle</label><select id="audit-lifecycle" name="lifecycle" class="form-select form-select-sm">@foreach (var state in new[] { "Active", "Archived", "All" }) { <option value="@state" selected="@(HttpContext.Request.Query["lifecycle"].ToString() == state)">@state</option> }</select></div>
        <div class="col-auto ms-auto d-flex align-items-end">@(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages.FilterActions, DashboardFilterActionsModel>(new(ResetUrl: Model.Path + "?pageSize=" + Model.Records.PageSize)))</div>
    </div>
    <details open class="dashboard-secondary-filters"><summary>More filters</summary><div class="row g-2">        <div class="col-12 col-sm-6 col-lg"><label for="audit-actor" class="form-label">Actor ID</label><input id="audit-actor" name="actor" maxlength="256" value="@HttpContext.Request.Query["actor"]" class="form-control form-control-sm" /></div>
        <div class="col-12 col-sm-6 col-lg"><label for="audit-role" class="form-label">Actor role</label><select id="audit-role" name="actorRole" class="form-select form-select-sm"><option value="executing" selected="@(HttpContext.Request.Query["actorRole"] != "initiating")">Executing actor</option><option value="initiating" selected="@(HttpContext.Request.Query["actorRole"] == "initiating")">Initiating actor</option></select></div>
        <div class="col-12 col-sm-6 col-lg"><label for="audit-module" class="form-label">Module</label><input id="audit-module" name="module" maxlength="256" value="@HttpContext.Request.Query["module"]" class="form-control form-control-sm" /></div>
</div></details>
    <input type="hidden" id="audit-quick-filters" name="filter" value="@HttpContext.Request.Query["filter"]" />
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
        <div class="d-flex gap-2" aria-label="Quick filters">
            <button type="button" class="btn btn-outline-secondary btn-sm audit-filter-chip" data-field="HasErrors" title="Filter executions with captured errors" aria-label="Filter executions with captured errors"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></button>
            <button type="button" class="btn btn-outline-secondary btn-sm audit-filter-chip" data-field="HasCommittedChanges" title="Filter executions with committed changes" aria-label="Filter executions with committed changes"><i class="bi bi-database-check" aria-hidden="true"></i></button>
            <button type="button" class="btn btn-outline-secondary btn-sm audit-filter-chip" data-field="HasUnknownChanges" title="Filter executions with unknown change state" aria-label="Filter executions with unknown change state"><i class="bi bi-database-exclamation" aria-hidden="true"></i></button>
        </div>
    </div>
    <script>
    (() => {
        const input = document.getElementById('audit-quick-filters');
        const buttons = [...document.querySelectorAll('.audit-filter-chip')];
        const matches = (criterion, field) => (criterion.field ?? criterion.Field) === field
            && ['eq', 'equal'].includes(String(criterion.operator ?? criterion.Operator).toLowerCase())
            && (criterion.value ?? criterion.Value) === true;
        function render(filters) {
            buttons.forEach(button => {
                const selected = filters.some(criterion => matches(criterion, button.dataset.field));
                button.classList.toggle('btn-secondary', selected);
                button.classList.toggle('btn-outline-secondary', !selected);
                button.setAttribute('aria-pressed', String(selected));
            });
        }
        try { const filter = JSON.parse(input.value || '{}'); render(filter.Filters || filter.filters || []); } catch { }
        buttons.forEach(button => button.addEventListener('click', () => {
            try {
                const filter = JSON.parse(input.value || '{}');
                const filters = filter.Filters || filter.filters || [];
                filter.Filters = filters.some(criterion => matches(criterion, button.dataset.field))
                    ? filters.filter(criterion => !matches(criterion, button.dataset.field))
                    : [...filters, { field: button.dataset.field, operator: 'eq', value: true }];
                delete filter.filters;
                const json = JSON.stringify(filter);
                if (json.length > 16384) return;
                input.value = json;
                render(filter.Filters);
            } catch { }
        }));
    })();
    </script>
    </form>
    @(await RenderPartialAsync<Data, AuditingViewModel>(Model))
    @(await RenderPartialAsync<LoadMore>())
}
@if (Model.Diagnostics is null)
{
    @(await RenderPartialAsync<DetailDialog>())
}
</section>
@functions {
    /// <summary>Gets global dashboard layout metadata.</summary>
    /// <example><code>var title = this.LayoutModel.Title;</code></example>
    public DashboardLayoutModel LayoutModel => new() { Title = "Auditing" };
}
