@inherits RazorSlice
<script>
(() => {
    const footer = document.getElementById('audit-load-more');
    const table = document.getElementById('audit-records');
    const button = footer?.querySelector('[data-audit-load-more]');
    if (!button || !table) return;

    const status = footer.querySelector('[data-audit-load-status]');
    const query = new URLSearchParams(location.search);
    const ids = new Set([...table.querySelectorAll('tr[data-audit-id]')].map(row => row.dataset.auditId));

    button.addEventListener('click', async () => {
        if (button.disabled) return;
        const page = Number(button.dataset.nextPage);
        if (!Number.isInteger(page) || page <= Number(footer.dataset.page)) return;

        const hadFocus = document.activeElement === button;
        button.disabled = true;
        button.textContent = 'Loading...';
        table.setAttribute('aria-busy', 'true');
        status.textContent = '';
        status.classList.remove('text-danger');
        status.classList.add('text-muted');
        const url = new URL(footer.dataset.url, location.origin);
        url.search = query.toString();
        url.searchParams.set('page', page);

        try {
            const response = await fetch(url, {
                headers: { 'X-Requested-With': 'fetch' },
                cache: 'no-store',
                redirect: 'error'
            });
            if (!response.ok || response.redirected || !response.headers.get('content-type')?.includes('text/html')) {
                throw new Error('Audit results are unavailable.');
            }

            const template = document.createElement('template');
            template.innerHTML = await response.text();
            const nextTable = template.content.querySelector('#audit-records');
            const nextFooter = template.content.querySelector('#audit-load-more');
            const nextButton = nextFooter?.querySelector('[data-audit-load-more]');
            const nextPage = nextButton ? Number(nextButton.dataset.nextPage) : null;
            if (!nextTable?.tBodies[0] || Number(nextFooter?.dataset.page) !== page
                || (nextButton && (!Number.isInteger(nextPage) || nextPage <= page))) {
                throw new Error('Audit results are unavailable.');
            }

            const rows = [...nextTable.tBodies[0].rows];
            if (rows.some(row => !row.dataset.auditId)) throw new Error('Audit results are unavailable.');
            const fragment = document.createDocumentFragment();
            let count = 0;
            rows.forEach(row => {
                if (ids.has(row.dataset.auditId)) return;
                ids.add(row.dataset.auditId);
                fragment.appendChild(row);
                count++;
            });
            const firstLink = fragment.querySelector('[data-audit-detail-url]');
            table.tBodies[0].appendChild(fragment);
            footer.dataset.page = String(page);
            if (nextButton) button.dataset.nextPage = String(nextPage);
            else {
                if (hadFocus && [button, document.body].includes(document.activeElement)) {
                    (firstLink ?? status).focus({ preventScroll: true });
                }
                button.remove();
            }
            status.textContent = `Loaded ${count} more executions.`;
        } catch {
            status.classList.remove('text-muted');
            status.classList.add('text-danger');
            status.textContent = 'Could not load executions. Try again.';
        } finally {
            button.disabled = false;
            button.textContent = 'Load more';
            table.removeAttribute('aria-busy');
        }
    });
})();
</script>
