@using BridgingIT.DevKit.Presentation.Web.Dashboard
@using Microsoft.Extensions.DependencyInjection
@using JobsDashboardEndpoints = BridgingIT.DevKit.Presentation.Web.Jobs.Dashboard.DashboardEndpoints
@inherits RazorSlice

@{
    var diagnostics = HttpContext.Request.Path.Value?.EndsWith("/diagnostics", StringComparison.OrdinalIgnoreCase) == true;
    var dashboardOptions = HttpContext.RequestServices.GetService<DashboardEndpointsOptions>() ?? new DashboardEndpointsOptions();
    var realtimeDataPath = JobsDashboardEndpoints.BuildJobsRealtimeDataPath(dashboardOptions);
    var historyDataPath = JobsDashboardEndpoints.BuildJobsHistoryDataPath(dashboardOptions);
}

@if (diagnostics)
{
    @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages.WorkloadCharts, DashboardWorkloadChartsModel>(new("jobs", realtimeDataPath, JobsDashboardEndpoints.DiagnosticsCharts, historyDataPath)))
    return;
}

<style>
    #jobs-dashboard-root {
        height: auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: .75rem;
        overflow: hidden;
    }

    #jobs-dashboard-root .jobs-card-grid {
        flex: 0 0 auto;
    }

    #jobs-dashboard-root > #dashboard-jobs-content {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: .75rem;
        overflow: hidden;
    }

    #jobs-dashboard-root .jobs-data-zone {
        flex: 1 1 auto;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: .75rem;
        overflow: hidden;
    }

    #jobs-dashboard-root .jobs-panel {
        min-width: 0;
        border: 1px solid var(--bs-border-color);
        border-radius: .375rem;
        background: var(--bs-body-bg);
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    #jobs-dashboard-root .jobs-panel-header {
        padding: .6rem .75rem;
        border-bottom: 1px solid var(--bs-border-color);
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .5rem;
    }

    #jobs-dashboard-root .jobs-panel-body {
        max-height: 65vh;
        min-height: 0;
        overflow: auto;
        padding: .25rem .5rem .5rem .5rem;
    }





    #jobs-dashboard-root .jobs-history-window .btn {
        min-width: 4.25rem;
    }

</style>

<div class="dashboard-operational-root" id="jobs-dashboard-root">
    <div id="dashboard-jobs-content">
        @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Jobs.Dashboard.Pages.Data>())
    </div>
</div>
