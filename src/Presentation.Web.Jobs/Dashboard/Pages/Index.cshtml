@using BridgingIT.DevKit.Common
@using BridgingIT.DevKit.Application.Jobs
@using BridgingIT.DevKit.Presentation.Web.Dashboard
@using BridgingIT.DevKit.Presentation.Web.Dashboard.Pages
@using BridgingIT.DevKit.Presentation.Web.Jobs.Dashboard.Pages
@using Microsoft.Extensions.DependencyInjection
@using JobsDashboardEndpoints = BridgingIT.DevKit.Presentation.Web.Jobs.Dashboard.DashboardEndpoints
@inherits RazorSlice
@implements IUsesLayout<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages._DashboardLayout, DashboardLayoutModel>

@{
  var diagnostics = HttpContext.Request.Path.Value?.EndsWith("/diagnostics", StringComparison.OrdinalIgnoreCase) == true;
    var occurrences = HttpContext.Request.Path.Value?.EndsWith("/occurrences", StringComparison.OrdinalIgnoreCase) == true;
    var dashboardOptions = HttpContext.RequestServices.GetService<DashboardEndpointsOptions>() ?? new
DashboardEndpointsOptions();
  var contentPath = JobsDashboardEndpoints.BuildJobsDataContentPath(dashboardOptions);
  var actionBase = JobsDashboardEndpoints.BuildJobsActionBase(dashboardOptions);
  var purgePath = $"{actionBase}/purge";
  var logEntriesPath = BridgingIT.DevKit.Presentation.Web.Logging.Dashboard.DashboardEndpoints.BuildLogEntriesPath(dashboardOptions);
  var aliveEnabled = HttpContext.RequestServices.GetService<JobAliveOptions>()?.Enabled == true;
}

<div class="dashboard-page-toolbar">
    <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">

        @(await RenderPartialAsync<RefreshControls, DashboardRefreshModel>(new("jobs", "Refresh jobs")))
        <details class="dashboard-tools"><summary class="btn btn-outline-secondary btn-sm">Tools</summary><div class="dashboard-tools-menu">
            @if (aliveEnabled) { <button type="button" class="btn btn-outline-secondary btn-sm" title="Dispatch alive job" aria-label="Dispatch alive job" onclick="window.bdkJobsAction('@($"{actionBase}/alive")')"><i class="bi bi-broadcast" aria-hidden="true"></i></button> }
            <button type="button" class="btn btn-outline-danger btn-sm" title="Purge retained job occurrences" aria-label="Purge retained job occurrences" onclick="window.bdkJobsPurge('@purgePath')"><i class="bi bi-trash3" aria-hidden="true"></i></button>
        </div></details>
    </div>
</div>

<nav class="nav nav-pills dashboard-view-tabs mb-2" aria-label="Jobs views" data-dashboard-view>
    <a class="nav-link @(!diagnostics && !occurrences ? "active" : "")" href="@actionBase@HttpContext.Request.QueryString" aria-current="@(!diagnostics && !occurrences ? "page" : null)">Jobs</a>
    <a class="nav-link @(occurrences ? "active" : "")" href="@(actionBase + "/occurrences")@HttpContext.Request.QueryString" aria-current="@(occurrences ? "page" : null)">Occurrences</a>
    <a class="nav-link @(diagnostics ? "active" : "")" href="@(actionBase + "/diagnostics")@HttpContext.Request.QueryString" aria-current="@(diagnostics ? "page" : null)">Diagnostics</a>
</nav>

@if (!diagnostics && !occurrences)
{
    <form id="jobs-filter-form" class="dashboard-filter-panel" method="get">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4 col-lg"><label class="form-label" for="jobs-filter-name">Name</label><input id="jobs-filter-name" name="jobName" value="@HttpContext.Request.Query["jobName"]" class="form-control form-control-sm" placeholder="contains" /></div>
            <div class="col-12 col-md-3"><label class="form-label" for="jobs-filter-group">Group</label><input id="jobs-filter-group" name="jobGroup" value="@HttpContext.Request.Query["jobGroup"]" class="form-control form-control-sm" placeholder="contains" /></div>
            <div class="col-6 col-md-2"><label class="form-label" for="jobs-filter-enabled">Enabled</label><select id="jobs-filter-enabled" name="jobEnabled" class="form-select form-select-sm"><option value="">All</option><option value="true" selected="@(HttpContext.Request.Query["jobEnabled"] == "true")">Enabled</option><option value="false" selected="@(HttpContext.Request.Query["jobEnabled"] == "false")">Disabled</option></select></div>
            <div class="col-6 col-md-2"><label class="form-label" for="jobs-filter-paused">Paused</label><select id="jobs-filter-paused" name="jobPaused" class="form-select form-select-sm"><option value="">All</option><option value="true" selected="@(HttpContext.Request.Query["jobPaused"] == "true")">Paused</option><option value="false" selected="@(HttpContext.Request.Query["jobPaused"] == "false")">Not paused</option></select></div>
            <div class="col-12 col-lg-auto d-flex ms-auto">@(await RenderPartialAsync<FilterActions, DashboardFilterActionsModel>(new(ResetId: "jobs-filter-reset")))</div>
        </div>
    </form>
}

@if (occurrences)
{
    <form id="occurrences-filter-form" class="dashboard-filter-panel" method="get">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4 col-lg"><label class="form-label" for="occurrences-filter-job">Job</label><input id="occurrences-filter-job" name="occurrenceJob" value="@HttpContext.Request.Query["occurrenceJob"]" class="form-control form-control-sm" placeholder="contains" /></div>
            <div class="col-12 col-md-3"><label class="form-label" for="occurrences-filter-trigger">Trigger</label><input id="occurrences-filter-trigger" name="occurrenceTrigger" value="@HttpContext.Request.Query["occurrenceTrigger"]" class="form-control form-control-sm" placeholder="contains" /></div>
            <div class="col-6 col-md-2"><label class="form-label" for="occurrences-filter-status">Status</label><select id="occurrences-filter-status" name="occurrenceStatus" class="form-select form-select-sm"><option value="">All</option>@foreach (var status in Enum.GetNames<JobOccurrenceStatus>()) { <option value="@status" selected="@(HttpContext.Request.Query["occurrenceStatus"] == status)">@status</option> }</select></div>
            <div class="col-12 col-md-3"><label class="form-label" for="occurrences-filter-correlation">Correlation ID</label><input id="occurrences-filter-correlation" name="occurrenceCorrelation" value="@HttpContext.Request.Query["occurrenceCorrelation"]" class="form-control form-control-sm" placeholder="contains" /></div>
            <div class="col-12 col-lg-auto d-flex ms-auto">@(await RenderPartialAsync<FilterActions, DashboardFilterActionsModel>(new(ResetId: "occurrences-filter-reset")))</div>
        </div>
    </form>
}

  <div id="dashboard-jobs-shell">
    @(await RenderPartialAsync<Content>())
  </div>

  <div class="dashboard-dialog dashboard-tabbed-inspector modal fade" id="jobs-occurrence-context-modal" tabindex="-1" aria-labelledby="jobs-occurrence-context-title"
       aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <h5 class="modal-title" id="jobs-occurrence-context-title">Occurrence Context</h5>
            <div class="text-muted small" id="jobs-occurrence-context-subtitle">-</div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
<div class="px-2 pt-2 flex-shrink-0"><div class="row g-2 mb-3" id="jobs-occurrence-context-summary"></div>
                <div class="nav nav-tabs" role="tablist" aria-label="Details views">
                    <button class="nav-link active" id="jobs-occurrence-context-0-tab" type="button" role="tab" aria-selected="true" aria-controls="jobs-occurrence-context-0-pane" data-bs-toggle="tab" data-bs-target="#jobs-occurrence-context-0-pane">Overview</button>
                    <button class="nav-link" id="jobs-occurrence-context-1-tab" type="button" role="tab" aria-selected="false" aria-controls="jobs-occurrence-context-1-pane" data-bs-toggle="tab" data-bs-target="#jobs-occurrence-context-1-pane">Messages</button>
                    <button class="nav-link" id="jobs-occurrence-context-2-tab" type="button" role="tab" aria-selected="false" aria-controls="jobs-occurrence-context-2-pane" data-bs-toggle="tab" data-bs-target="#jobs-occurrence-context-2-pane">Properties</button>
                </div>
            </div>

            <div class="modal-body">
                <div class="tab-content">
                    <div class="tab-pane active" id="jobs-occurrence-context-0-pane" role="tabpanel" aria-labelledby="jobs-occurrence-context-0-tab" tabindex="0"><h6 class="mb-2">Details</h6>
          <div class="table-responsive mb-3">
            <table class="table table-sm align-middle mb-0 dashboard-detail-table">
              <tbody id="jobs-occurrence-context-details"></tbody>
            </table>
          </div>

          </div>
                    <div class="tab-pane" id="jobs-occurrence-context-1-pane" role="tabpanel" aria-labelledby="jobs-occurrence-context-1-tab" tabindex="0"><h6 class="mb-2">Messages</h6>
          <div id="jobs-occurrence-context-messages" class="d-flex flex-column gap-2"></div>


          </div>
                    <div class="tab-pane" id="jobs-occurrence-context-2-pane" role="tabpanel" aria-labelledby="jobs-occurrence-context-2-tab" tabindex="0"><h6 class="mb-2">Properties</h6>
          <div class="table-responsive mb-3">
            <table class="table table-sm align-middle mb-0 dashboard-detail-table">
              <tbody id="jobs-occurrence-context-properties"></tbody>
            </table>
          </div>
        </div></div></div>
@(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages.ModalActions, DashboardModalActionsModel>(new()))
        </div>
    </div>
  </div>

  <script>
    (() => {
      const shellElement = document.getElementById('dashboard-jobs-shell');
      const logEntriesPath = '@logEntriesPath';
      const occurrenceModalElement = document.getElementById('jobs-occurrence-context-modal');
      const occurrenceModal = occurrenceModalElement && window.bootstrap
        ? window.bootstrap.Modal.getOrCreateInstance(occurrenceModalElement)
        : null;
      let occurrenceModalOpen = false;

      let appliedUrl = new URL('@contentPath', location.origin);
      if (@(occurrences ? "true" : "false")) appliedUrl.searchParams.set('view', 'occurrences');
      for (const key of ['occurrenceTake', 'jobName', 'jobGroup', 'jobEnabled', 'jobPaused', 'occurrenceJob', 'occurrenceTrigger', 'occurrenceStatus', 'occurrenceCorrelation']) if (new URL(location.href).searchParams.has(key)) appliedUrl.searchParams.set(key, new URL(location.href).searchParams.get(key));
      let pendingUrl = null;
      let pendingList = null;
      const growingLists = window.bdkDashboard.createGrowingLists({
        owner: shellElement, root: () => shellElement.querySelector('#dashboard-jobs-content'),
        appliedUrl: () => new URL(appliedUrl), hasPending: key => pendingUrl !== null && (!key || key === pendingList),
        lists: [
          { key: 'jobs-occurrences', historyVersion: 2, cursor: 'occurrenceCursor', boundary: 'occurrenceBoundary', size: 'occurrenceTake' }
        ],
        onSizeChange: (list, size) => { pendingList = list.key; pendingUrl = new URL(pendingUrl || appliedUrl); pendingUrl.searchParams.set(list.size, size); refresher.refresh(true); }
      });
      const refresher = window.bdkDashboard.createRefresher({
        buildUrl: () => new URL(pendingUrl || appliedUrl),
        applyResponse: growingLists.applyResponse,
        onSuccess: () => { if (pendingUrl) { appliedUrl = pendingUrl; pendingUrl = null; const page = new URL(location.href); page.search = appliedUrl.search; page.searchParams.delete('view'); history.replaceState(null, '', page); } },
        onError: () => { pendingUrl = null; pendingList = null; },
        contentSelector: () => shellElement?.querySelector('#dashboard-jobs-content') ?? null,
        statusSelector: '#jobs-refresh-status',
        intervalSelector: @(diagnostics ? "true" : "false") ? null : '#jobs-refresh-interval',
        refreshButtonSelector: @(diagnostics ? "true" : "false") ? null : '#jobs-refresh-now',
        storageKey: 'bdk.dashboard.jobs.refreshInterval',
        shouldRefresh: () => @(diagnostics ? "false" : "true") && !occurrenceModalOpen && !growingLists.busy()
      });

      const occurrenceView = @(occurrences ? "true" : "false");
      const jobForm = document.getElementById(occurrenceView ? 'occurrences-filter-form' : 'jobs-filter-form');
      const jobFilterKeys = occurrenceView ? ['occurrenceJob', 'occurrenceTrigger', 'occurrenceStatus', 'occurrenceCorrelation'] : ['jobName', 'jobGroup', 'jobEnabled', 'jobPaused'];
      function applyJobFilters(reset = false) {
        pendingList = occurrenceView ? 'jobs-occurrences' : null;
        pendingUrl = new URL(appliedUrl);
        for (const key of jobFilterKeys) {
          const value = reset ? '' : jobForm.elements.namedItem(key).value.trim();
          if (value) pendingUrl.searchParams.set(key, value); else pendingUrl.searchParams.delete(key);
        }
        pendingUrl.searchParams.delete(occurrenceView ? 'occurrenceCursor' : 'jobCursor'); pendingUrl.searchParams.delete(occurrenceView ? 'occurrenceBoundary' : 'jobBoundary');
        growingLists.cancel();
        refresher.refresh(true);
      }
      jobForm?.addEventListener('submit', event => { event.preventDefault(); applyJobFilters(); });
      document.getElementById(occurrenceView ? 'occurrences-filter-reset' : 'jobs-filter-reset')?.addEventListener('click', () => {
        for (const key of jobFilterKeys) jobForm.elements.namedItem(key).value = '';
        applyJobFilters(true);
      });

      function text(value) {
        if (value === null || value === undefined || value === '') {
          return '-';
        }

        return value.toString();
      }

      function formatDate(value) {
        if (!value) {
          return '-';
        }

        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? text(value) : date.toISOString().replace('T', ' ').replace('Z', ' UTC');
      }

      function setText(id, value) {
        const element = document.getElementById(id);
        if (element) {
          element.textContent = text(value);
        }
      }

      function appendCell(container, label, value, cssClass) {
        const wrapper = document.createElement('div');
        wrapper.className = cssClass || 'col-6 col-lg-3';

        const card = document.createElement('div');
        card.className = 'border rounded p-2 h-100';

        const labelElement = document.createElement('div');
        labelElement.className = 'text-muted small';
        labelElement.textContent = label;

        const valueElement = document.createElement('div');
        valueElement.className = 'fw-semibold text-break';
        valueElement.textContent = text(value);

        card.append(labelElement, valueElement);
        wrapper.appendChild(card);
        container.appendChild(wrapper);
      }

      function appendRow(container, label, value) {
        const row = document.createElement('tr');
        const labelCell = document.createElement('td');
        labelCell.className = 'text-muted text-nowrap';
        labelCell.textContent = label;

        const valueCell = document.createElement('td');
        valueCell.className = 'text-break';
        if (label.toLowerCase().includes('correlation')) {
          appendCorrelationLink(valueCell, value);
        } else {
          valueCell.textContent = text(value);
        }

        row.append(labelCell, valueCell);
        container.appendChild(row);
      }

      function appendCorrelationLink(container, value) {
          window.bdkDashboard.appendCorrelationLink(container, value, logEntriesPath);
      }

      function renderEmpty(container, message) {
        const element = document.createElement('div');
        element.className = 'text-muted small';
        element.textContent = message;
        container.appendChild(element);
      }

      function showOccurrenceContext(payload) {
        if (!payload || !occurrenceModal) {
          return;
        }

        setText('jobs-occurrence-context-title', `${text(payload.jobName)} / ${text(payload.triggerName)}`);
        setText('jobs-occurrence-context-subtitle', payload.occurrenceId);

        const summary = document.getElementById('jobs-occurrence-context-summary');
        const details = document.getElementById('jobs-occurrence-context-details');
        const properties = document.getElementById('jobs-occurrence-context-properties');
        const messages = document.getElementById('jobs-occurrence-context-messages');
        summary.replaceChildren();
        details.replaceChildren();
        properties.replaceChildren();
        messages.replaceChildren();

        appendCell(summary, 'Status', payload.status);
        @* appendCell(summary, 'Correlation', payload.correlationId); *@
          appendCell(summary, 'Attempts', payload.attemptCount);
        appendCell(summary, 'Duration', payload.latestExecutionDurationSeconds ? `${Math.round(payload.latestExecutionDurationSeconds * 100) / 100}s` : '-');

        appendRow(details, 'Correlation ID', payload.correlationId);
        appendRow(details, 'Occurrence ID', payload.occurrenceId);
        appendRow(details, 'Occurrence Key', payload.occurrenceKey);
        appendRow(details, 'Trigger Type', payload.triggerType);
        @* appendRow(details, 'Idempotency Key', payload.idempotencyKey); *@
          appendRow(details, 'Scheduler', payload.leaseOwnerSchedulerInstanceId);
        appendRow(details, 'Due', formatDate(payload.dueUtc));
        appendRow(details, 'Scheduled', formatDate(payload.scheduledUtc));
        appendRow(details, 'Created', formatDate(payload.createdDate));
        appendRow(details, 'Updated', formatDate(payload.updatedDate));
        appendRow(details, 'Latest Execution', payload.latestExecutionStatus);
        appendRow(details, 'Started', formatDate(payload.latestExecutionStartedUtc));
        appendRow(details, 'Completed', formatDate(payload.latestExecutionCompletedUtc));
        appendRow(details, 'Data Type', payload.dataType);
        appendRow(details, 'Data', payload.dataPreview);
        appendRow(details, 'Dependencies', `${Number(payload.pendingDependencyCount || 0)} pending / ${Number(payload.failedDependencyCount || 0)} failed / ${Number(payload.dependencyCount || 0)} total`);
        appendRow(details, 'Blocked Reason', payload.blockedReason);
        appendRow(details, 'Batch', payload.externalBatchId || payload.batchInternalId);

        const propertyEntries = Object.entries(payload.properties || {});
        if (propertyEntries.length === 0) {
          const row = document.createElement('tr');
          const cell = document.createElement('td');
          cell.className = 'text-muted small';
          cell.colSpan = 2;
          cell.textContent = 'No properties available.';
          row.appendChild(cell);
          properties.appendChild(row);
        } else {
          propertyEntries.forEach(([key, value]) => appendRow(properties, key, value));
        }

        const messageItems = Array.isArray(payload.messages) ? payload.messages : [];
        if (messageItems.length === 0) {
          renderEmpty(messages, 'No execution messages available.');
        } else {
          messageItems.forEach(message => {
            const item = document.createElement('div');
            item.className = 'border rounded p-2 text-break';
            item.textContent = text(message);
            messages.appendChild(item);
          });
        }

        occurrenceModalOpen = true;
        occurrenceModal.show();
      }

      if (occurrenceModalElement) {
        occurrenceModalElement.addEventListener('shown.bs.modal', () => {
          occurrenceModalOpen = true;
        });

        occurrenceModalElement.addEventListener('hidden.bs.modal', () => {
          occurrenceModalOpen = false;
          refresher.schedule();
        });
      }

      shellElement?.addEventListener('click', event => {
        const button = event.target.closest('[data-job-occurrence-context]');
        if (!button) {
          return;
        }

        try {
          showOccurrenceContext(JSON.parse(button.getAttribute('data-job-occurrence-context') || '{}'));
        } catch {
          // ignore invalid row payload
        }
      });

      // Global action helper — called from inline buttons in Content.cshtml
      window.bdkJobsAction = async function (url) {
        if (occurrenceModal) {
          occurrenceModal.hide();
        }

        await window.bdkDashboard.postAction(url, {
          refresh: refresher.refresh,
          errorMessage: 'Job action failed:'
        });
      };

      window.bdkJobsPurge = async function(url) {
        if (!await window.bdkDashboard.confirmAction({ title: 'Purge job occurrences', message: 'Purge retained terminal job occurrences? This cannot be undone.', confirmText: 'Purge' })) {
          return;
        }

        await window.bdkJobsAction(url);
      };
    })();
  </script>

@functions {
  public DashboardLayoutModel LayoutModel => new() { Title = "Jobs" };
}
