@using BridgingIT.DevKit.Application.Messaging
@using MessagingDashboardEndpoints = BridgingIT.DevKit.Presentation.Web.Messaging.Dashboard.DashboardEndpoints
@inherits RazorSlice
@implements IUsesLayout<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages._DashboardLayout, DashboardLayoutModel>

@{
    var diagnostics = HttpContext.Request.Path.Value?.EndsWith("/diagnostics", StringComparison.OrdinalIgnoreCase) == true;
    var messages = HttpContext.Request.Path.Value?.EndsWith("/messages", StringComparison.OrdinalIgnoreCase) == true;
    var dashboardOptions = HttpContext.RequestServices.GetService<DashboardEndpointsOptions>() ?? new DashboardEndpointsOptions();
    var contentPath = MessagingDashboardEndpoints.BuildMessagingContentPath(dashboardOptions);
    var actionBase = MessagingDashboardEndpoints.BuildMessagingActionBase(dashboardOptions);
    var purgePath = $"{actionBase}/purge";
    var logEntriesPath = BridgingIT.DevKit.Presentation.Web.Logging.Dashboard.DashboardEndpoints.BuildLogEntriesPath(dashboardOptions);
    var aliveEnabled = HttpContext.RequestServices.GetService<MessagingAliveOptions>()?.Enabled == true;
}

<div class="dashboard-page-toolbar">
    <div class="d-flex flex-wrap justify-content-end align-items-center gap-2">

        @(await RenderPartialAsync<RefreshControls, DashboardRefreshModel>(new("messaging", "Refresh messaging")))
        <details class="dashboard-tools"><summary class="btn btn-outline-secondary btn-sm">Tools</summary><div class="dashboard-tools-menu">
        @if (aliveEnabled)
        {
            <button type="button" class="btn btn-outline-primary btn-sm" title="Publish alive message" onclick="window.bdkMessagingAction('@($"{actionBase}/alive")')" aria-label="Publish alive message">
                <i class="bi bi-broadcast" aria-hidden="true"></i>
            </button>
        }
        <button type="button" class="btn btn-outline-danger btn-sm" title="Purge broker messages" onclick="window.bdkMessagingPurge('@purgePath')" aria-label="Purge broker messages">
            <i class="bi bi-trash3" aria-hidden="true"></i>
        </button>
        </div></details>
    </div>
</div>

<nav class="nav nav-pills dashboard-view-tabs mb-2" aria-label="Messaging views" data-dashboard-view>
    <a class="nav-link @(!diagnostics && !messages ? "active" : "")" href="@actionBase@HttpContext.Request.QueryString" aria-current="@(!diagnostics && !messages ? "page" : null)">Overview</a>
    <a class="nav-link @(messages ? "active" : "")" href="@(actionBase + "/messages")@HttpContext.Request.QueryString" aria-current="@(messages ? "page" : null)">Messages</a>
    <a class="nav-link @(diagnostics ? "active" : "")" href="@(actionBase + "/diagnostics")@HttpContext.Request.QueryString" aria-current="@(diagnostics ? "page" : null)">Diagnostics</a>
</nav>

@if (messages)
{
<div class="dashboard-filter-panel">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-lg-2">
                <label class="form-label small mb-1" for="messaging-status-filter">Status</label>
                <select id="messaging-status-filter" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option>Pending</option>
                    <option>Processing</option>
                    <option>Succeeded</option>
                    <option>Failed</option>
                    <option>DeadLettered</option>
                    <option>Expired</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label small mb-1" for="messaging-archive-filter">Archive</label>
                <select id="messaging-archive-filter" class="form-select form-select-sm">
                    <option value="active">Active</option>
                    <option value="archived">Archived</option>
                    <option value="all">All</option>
                </select>
            </div>

            <div class="col-12 col-lg">
                <label class="form-label small mb-1" for="messaging-type-filter">Type</label>
                <input id="messaging-type-filter" class="form-control form-control-sm" placeholder="contains">
            </div>
            <div class="col-12 col-lg">
                <label class="form-label small mb-1" for="messaging-id-filter">Message Id</label>
                <input id="messaging-id-filter" class="form-control form-control-sm" placeholder="exact or contains">
            </div>
            <div class="col-12 col-lg-auto d-flex ms-auto">
                @(await RenderPartialAsync<FilterActions, DashboardFilterActionsModel>(new("messaging-filter-apply", "messaging-filter-reset", Submit: false)))
            </div>
        </div>
    </div>
</div>

}

<div id="dashboard-messaging-shell">
    @(await RenderPartialAsync<Content>())
</div>

<div class="dashboard-dialog modal fade" id="messaging-message-context-modal" tabindex="-1" aria-labelledby="messaging-message-context-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="messaging-message-context-title">Broker Message</h5>
                    <div class="text-muted small" id="messaging-message-context-subtitle">-</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="px-3 pt-2 flex-shrink-0">
                <div class="row g-2 mb-2" id="messaging-message-context-summary"></div>
                <div class="nav nav-tabs" role="tablist" aria-label="Message details">
                    <button class="nav-link active" id="messaging-message-context-overview-tab" data-bs-toggle="tab" data-bs-target="#messaging-message-context-overview-pane" type="button" role="tab" aria-controls="messaging-message-context-overview-pane" aria-selected="true">Overview</button>
                    <button class="nav-link" id="messaging-message-context-processing-tab" data-bs-toggle="tab" data-bs-target="#messaging-message-context-processing-pane" type="button" role="tab" aria-controls="messaging-message-context-processing-pane" aria-selected="false">Processing</button>
                    <button class="nav-link" id="messaging-message-context-properties-tab" data-bs-toggle="tab" data-bs-target="#messaging-message-context-properties-pane" type="button" role="tab" aria-controls="messaging-message-context-properties-pane" aria-selected="false">Properties</button>
                    <button class="nav-link" id="messaging-message-context-payload-tab" data-bs-toggle="tab" data-bs-target="#messaging-message-context-payload-pane" type="button" role="tab" aria-controls="messaging-message-context-payload-pane" aria-selected="false">Payload</button>
                </div>
            </div>
            <div class="modal-body">
                <div class="tab-content">
                    <div class="tab-pane show active" id="messaging-message-context-overview-pane" role="tabpanel" aria-labelledby="messaging-message-context-overview-tab" tabindex="0">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0" style="table-layout: fixed; min-width: 0; width: 100%">
                                <tbody id="messaging-message-context-details"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane" id="messaging-message-context-processing-pane" role="tabpanel" aria-labelledby="messaging-message-context-processing-tab" tabindex="0">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0" style="table-layout: fixed; min-width: 0; width: 100%">
                                <tbody id="messaging-message-context-processing"></tbody>
                            </table>
                        </div>
                        <h6 class="mt-3 mb-2">Handlers</h6>
                        <div id="messaging-message-context-handlers" class="d-flex flex-column gap-2"></div>
                    </div>
                    <div class="tab-pane" id="messaging-message-context-properties-pane" role="tabpanel" aria-labelledby="messaging-message-context-properties-tab" tabindex="0">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0" style="table-layout: fixed; min-width: 0; width: 100%">
                                <tbody id="messaging-message-context-properties"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane" id="messaging-message-context-payload-pane" role="tabpanel" aria-labelledby="messaging-message-context-payload-tab" tabindex="0">
                        <pre class="small border rounded p-2 mb-0" style="white-space: pre-wrap; overflow-wrap: anywhere" id="messaging-message-context-payload">-</pre>
                    </div>
                </div>
            </div>
        @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages.ModalActions, DashboardModalActionsModel>(new()))
        </div>
    </div>
</div>

<script>
    (() => {
        const shellElement = document.getElementById('dashboard-messaging-shell');
        const logEntriesPath = '@logEntriesPath';
        const resetButton = document.getElementById('messaging-filter-reset');
        const messageModalElement = document.getElementById('messaging-message-context-modal');
        const messageModal = messageModalElement && window.bootstrap
            ? window.bootstrap.Modal.getOrCreateInstance(messageModalElement)
            : null;
        let messageModalOpen = false;

        function readFilterUrl() {
            const url = new URL('@contentPath', window.location.origin);
            if (@(messages ? "false" : "true")) { url.search = location.search; url.searchParams.delete("view"); return url; }
            url.searchParams.set("view", "messages");
            const fields = [
                ['status', document.getElementById('messaging-status-filter')?.value],
                ['archive', document.getElementById('messaging-archive-filter')?.value],
                ['take', document.getElementById('messaging-take-filter')?.value],
                ['type', document.getElementById('messaging-type-filter')?.value],
                ['messageId', document.getElementById('messaging-id-filter')?.value],
            ];
            fields.forEach(([key, value]) => {
                if (value) {
                    url.searchParams.set(key, value);
                }
            });
            return url;
        }

        const initial = new URLSearchParams(location.search);
        if (initial.has('status') && document.getElementById('messaging-status-filter')) document.getElementById('messaging-status-filter').value = initial.get('status');
        if (initial.has('archive') && document.getElementById('messaging-archive-filter')) document.getElementById('messaging-archive-filter').value = initial.get('archive');
        if (initial.has('take') && document.getElementById('messaging-take-filter')) document.getElementById('messaging-take-filter').value = initial.get('take');
        if (initial.has('type') && document.getElementById('messaging-type-filter')) document.getElementById('messaging-type-filter').value = initial.get('type');
        if (initial.has('messageId') && document.getElementById('messaging-id-filter')) document.getElementById('messaging-id-filter').value = initial.get('messageId');
        const filters = window.bdkDashboard.createAppliedFilters(readFilterUrl);
        const buildContentUrl = () => filters.request();
        document.querySelector('.dashboard-filter-panel')?.addEventListener('keydown', event => {
            if (event.key === 'Enter' && event.target.tagName === 'INPUT') { event.preventDefault(); filters.stage(); refresher.refresh(true); }
        });
        const growingLists = window.bdkDashboard.createGrowingLists({
            owner: shellElement,
            root: () => shellElement.querySelector('#dashboard-messaging-content'),
            appliedUrl: () => filters.applied(), hasPending: () => filters.hasPending(),
            lists: @(messages ? "true" : "false") ? [{ key: 'messaging', historyVersion: 2, cursor: 'cursor', boundary: 'boundary', size: 'take' }] : [],
            onSizeChange: (list, size) => { filters.stageApplied(url => url.searchParams.set(list.size, size)); refresher.refresh(true); }
        });
        const refresher = window.bdkDashboard.createRefresher({
            applyResponse: growingLists.applyResponse,
            onSuccess: () => filters.accept(),
            onError: () => filters.reject(),
            buildUrl: buildContentUrl,
            contentSelector: () => shellElement?.querySelector('#dashboard-messaging-content') ?? null,
            statusSelector: '#messaging-refresh-status',
            intervalSelector: @(diagnostics ? "true" : "false") ? null : '#messaging-refresh-interval',
            refreshButtonSelector: @(diagnostics ? "true" : "false") ? null : '#messaging-refresh-now',
            storageKey: 'bdk.dashboard.messaging.refreshInterval',
            shouldRefresh: () => @(diagnostics ? "false" : "true") && !messageModalOpen && !growingLists.busy()
        });

        function text(value) {
            return value === null || value === undefined || value === '' ? '-' : value.toString();
        }

        function formatDate(value) {
            if (!value) {
                return '-';
            }

            const date = new Date(value);
            return Number.isNaN(date.getTime()) ? text(value) : date.toISOString().replace('T', ' ').replace('Z', ' UTC');
        }

        function setText(id, value) {
            const element = document.getElementById(id);
            if (element) {
                element.textContent = text(value);
            }
        }

        function appendCell(container, label, value) {
            const wrapper = document.createElement('div');
            wrapper.className = 'col-6 col-lg-3';
            const card = document.createElement('div');
            card.className = 'border rounded p-2 h-100';
            const labelElement = document.createElement('div');
            labelElement.className = 'text-muted small';
            labelElement.textContent = label;
            const valueElement = document.createElement('div');
            valueElement.className = 'fw-semibold text-break';
            valueElement.textContent = text(value);
            card.append(labelElement, valueElement);
            wrapper.appendChild(card);
            container.appendChild(wrapper);
        }

        function appendRow(container, label, value) {
            const row = document.createElement('tr');
            const labelCell = document.createElement('td');
            labelCell.className = 'text-muted text-break';
            labelCell.style.width = '30%';
            labelCell.textContent = label;
            const valueCell = document.createElement('td');
            valueCell.className = 'text-break';
            if (label.toLowerCase().includes('correlation')) {
                appendCorrelationLink(valueCell, value);
            } else {
                valueCell.textContent = text(value);
            }
            row.append(labelCell, valueCell);
            container.appendChild(row);
        }

        function appendCorrelationLink(container, value) {
            window.bdkDashboard.appendCorrelationLink(container, value, logEntriesPath);
        }

        function renderProperties(container, properties) {
            const entries = Object.entries(properties || {});
            if (entries.length === 0) {
                appendRow(container, 'Properties', 'No properties available.');
                return;
            }

            entries.forEach(([key, value]) => appendRow(container, key, value));
        }

        function formatPayload(value) {
            if (!value) {
                return '-';
            }

            try {
                return JSON.stringify(JSON.parse(value), null, 2);
            } catch {
                return value.toString();
            }
        }

        function renderHandlers(container, handlers) {
            container.replaceChildren();
            if (!Array.isArray(handlers) || handlers.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'text-muted small';
                empty.textContent = 'No handler details available.';
                container.appendChild(empty);
                return;
            }

            handlers.forEach(handler => {
                const item = document.createElement('div');
                item.className = 'border rounded p-2';

                const title = document.createElement('div');
                title.className = 'fw-semibold text-break';
                title.textContent = text(handler.handlerType);

                const meta = document.createElement('div');
                meta.className = 'text-muted small text-break';
                meta.textContent = `${text(handler.status)} | attempts: ${text(handler.attemptCount)} | processed: ${formatDate(handler.processedDate)}`;

                item.append(title, meta);
                if (handler.lastError) {
                    const error = document.createElement('div');
                    error.className = 'text-danger small text-break mt-1';
                    error.textContent = handler.lastError;
                    item.appendChild(error);
                }

                container.appendChild(item);
            });
        }

        function showMessageContext(payload) {
            if (!payload || !messageModal) {
                return;
            }

            setText('messaging-message-context-subtitle', payload.messageId);

            const summary = document.getElementById('messaging-message-context-summary');
            const details = document.getElementById('messaging-message-context-details');
            const processing = document.getElementById('messaging-message-context-processing');
            const properties = document.getElementById('messaging-message-context-properties');
            const handlers = document.getElementById('messaging-message-context-handlers');
            const content = document.getElementById('messaging-message-context-payload');
            summary.replaceChildren();
            details.replaceChildren();
            processing.replaceChildren();
            properties.replaceChildren();

            appendCell(summary, 'Status', payload.status);
            appendCell(summary, 'Attempts', payload.attemptCount);
            appendCell(summary, 'Archived', payload.isArchived ? 'Yes' : 'No');
            appendCell(summary, 'Handlers', Array.isArray(payload.handlers) ? payload.handlers.length : 0);

            appendRow(details, 'Internal ID', payload.id);
            appendRow(details, 'Message ID', payload.messageId);
            appendRow(details, 'Type', payload.type);
            appendRow(details, 'Created', formatDate(payload.createdDate));
            appendRow(details, 'Expires', formatDate(payload.expiresOn));
            appendRow(processing, 'Locked By', payload.lockedBy);
            appendRow(processing, 'Locked Until', formatDate(payload.lockedUntil));
            appendRow(processing, 'Processed', formatDate(payload.processedDate));
            appendRow(details, 'Archived', formatDate(payload.archivedDate));
            appendRow(details, 'Content Hash', payload.contentHash);
            appendRow(processing, 'Last Error', payload.lastError);

            renderProperties(properties, payload.properties);
            renderHandlers(handlers, payload.handlers);
            content.textContent = formatPayload(payload.content);
            window.bootstrap.Tab.getOrCreateInstance(document.getElementById('messaging-message-context-overview-tab')).show();
            messageModalElement.querySelector('.modal-body').scrollTop = 0;
            messageModalOpen = true;
            messageModal.show();
        }

        if (messageModalElement) {
            messageModalElement.addEventListener('shown.bs.tab', () => {
                messageModalElement.querySelector('.modal-body').scrollTop = 0;
            });

            messageModalElement.addEventListener('shown.bs.modal', () => {
                messageModalOpen = true;
            });

            messageModalElement.addEventListener('hidden.bs.modal', () => {
                messageModalOpen = false;
                refresher.schedule();
            });
        }

        shellElement?.addEventListener('click', event => {
            const button = event.target.closest('[data-messaging-message-context]');
            if (!button) {
                return;
            }

            try {
                showMessageContext(JSON.parse(button.getAttribute('data-messaging-message-context') || '{}'));
            } catch {
                // ignore invalid row payload
            }
        });

        document.getElementById('messaging-filter-apply')?.addEventListener('click', () => { filters.stage(); refresher.refresh(true); });
        resetButton?.addEventListener('click', () => {
            document.getElementById('messaging-status-filter').value = '';
            document.getElementById('messaging-archive-filter').value = 'active';
            document.getElementById('messaging-type-filter').value = '';
            document.getElementById('messaging-id-filter').value = '';
            filters.stage(); refresher.refresh(true);
        });

        window.bdkMessagingAction = async function(url) {
            if (messageModal) {
                messageModal.hide();
            }

            await window.bdkDashboard.postAction(url, {
                refresh: refresher.refresh,
                errorMessage: 'Messaging action failed:'
            });
        };

        window.bdkMessagingPurge = async function(url) {
            if (!await window.bdkDashboard.confirmAction({ title: 'Purge broker messages', message: 'Purge retained broker messages? This cannot be undone.', confirmText: 'Purge' })) {
                return;
            }

            await window.bdkMessagingAction(url);
        };
    })();
</script>

@functions {
    public DashboardLayoutModel LayoutModel => new() { Title = "Messaging" };
}
