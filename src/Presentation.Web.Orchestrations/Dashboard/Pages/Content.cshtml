@using OrchestrationsDashboardEndpoints = BridgingIT.DevKit.Presentation.Web.Orchestrations.Dashboard.DashboardEndpoints
@inherits RazorSlice

@{
    var diagnostics = HttpContext.Request.Path.Value?.EndsWith("/diagnostics", StringComparison.OrdinalIgnoreCase) == true;
    var dashboardOptions = HttpContext.RequestServices.GetService<DashboardEndpointsOptions>() ?? new DashboardEndpointsOptions();
    var realtimeDataPath = OrchestrationsDashboardEndpoints.BuildOrchestrationsRealtimeDataPath(dashboardOptions);
    var historyDataPath = OrchestrationsDashboardEndpoints.BuildOrchestrationsHistoryDataPath(dashboardOptions);
}

@if (diagnostics)
{
    @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages.WorkloadCharts, DashboardWorkloadChartsModel>(new("orchestrations", realtimeDataPath, OrchestrationsDashboardEndpoints.DiagnosticsCharts, historyDataPath, "Retained orchestration history", "instances", ["completed", "failed", "running", "waiting", "problem"])))
    return;
}

<style>
    #orchestrations-dashboard-root {
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: .75rem;
        overflow: visible;
    }

    #orchestrations-dashboard-root > #dashboard-orchestrations-content {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: .75rem;
        overflow: visible;
    }

    #orchestrations-dashboard-root .orchestrations-data-zone {
        flex: 1 1 auto;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: .75rem;
        overflow: visible;
    }

    #orchestrations-dashboard-root .orchestrations-panel {
        min-width: 0;
        border: 1px solid var(--bs-border-color);
        border-radius: .375rem;
        background: var(--bs-body-bg);
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    #orchestrations-dashboard-root .orchestrations-panel-header {
        padding: .6rem .75rem;
        border-bottom: 1px solid var(--bs-border-color);
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .5rem;
    }

    #orchestrations-dashboard-root .orchestrations-panel-body {
        min-height: 0;
        overflow: auto;
        padding: .25rem .5rem .5rem .5rem;
    }

    #orchestrations-dashboard-root .orchestrations-side-zone {
        min-height: 0;
        display: flex;
        flex-direction: row;
        gap: .75rem;
        overflow: visible;
    }

    #orchestrations-dashboard-root .orchestrations-side-zone > section { flex: 1; }

    @@media (max-width: 767px) {
        #orchestrations-dashboard-root .orchestrations-side-zone { flex-direction: column; }
    }

</style>

<div class="dashboard-operational-root" id="orchestrations-dashboard-root">
    <div id="dashboard-orchestrations-content">
        @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Orchestrations.Dashboard.Pages.Data>())
    </div>
</div>
