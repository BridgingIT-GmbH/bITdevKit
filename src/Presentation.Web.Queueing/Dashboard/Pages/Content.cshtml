@using QueueingDashboardEndpoints = BridgingIT.DevKit.Presentation.Web.Queueing.Dashboard.DashboardEndpoints
@inherits RazorSlice

@{
    var diagnostics = HttpContext.Request.Path.Value?.EndsWith("/diagnostics", StringComparison.OrdinalIgnoreCase) == true;
    var dashboardOptions = HttpContext.RequestServices.GetService<DashboardEndpointsOptions>() ?? new DashboardEndpointsOptions();
    var realtimeDataPath = QueueingDashboardEndpoints.BuildQueueingRealtimeDataPath(dashboardOptions);
}

@if (diagnostics)
{
    @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages.WorkloadCharts, DashboardWorkloadChartsModel>(new("queueing", realtimeDataPath, QueueingDashboardEndpoints.DiagnosticsCharts)))
    return;
}

<style>
    #queueing-dashboard-root {
        height: auto;
        min-height: 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: .75rem;
        overflow: hidden;
    }

    #queueing-dashboard-root > #dashboard-queueing-content {
        flex: 1 1 auto;
        min-height: 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: .75rem;
        overflow: hidden;
    }

    #queueing-dashboard-root .queueing-data-zone {
        flex: 1 1 auto;
        min-height: 0;
        min-width: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: .75rem;
        overflow: hidden;
    }

    #queueing-dashboard-root .queueing-panel {
        border: 1px solid var(--bs-border-color);
        border-radius: .375rem;
        background: var(--bs-body-bg);
        display: flex;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
    }

    #queueing-dashboard-root .queueing-panel-header {
        padding: .6rem .75rem;
        border-bottom: 1px solid var(--bs-border-color);
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .5rem;
    }

    #queueing-dashboard-root .queueing-panel-body {
        max-height: 65vh;
        min-height: 0;
        min-width: 0;
        overflow: auto;
        padding: .25rem .5rem .5rem .5rem;
    }

    #queueing-dashboard-root .queueing-side-zone {
        min-height: 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: .75rem;
        overflow: hidden;
        overflow-wrap: anywhere;
    }

    #queueing-dashboard-root .queueing-side-zone .btn {
        flex-shrink: 0;
        white-space: nowrap;
    }



    @@media (max-width: 1399.98px) {
        #queueing-dashboard-root {
            height: auto;
            min-height: 0;
            overflow: visible;
        }

        #queueing-dashboard-root > #dashboard-queueing-content,
        #queueing-dashboard-root .queueing-data-zone,
        #queueing-dashboard-root .queueing-side-zone {
            flex: 0 0 auto;
            overflow: visible;
        }

        #queueing-dashboard-root .queueing-panel-body {
        max-height: 65vh;
            max-height: 28rem;
        }
    }
</style>

<div class="dashboard-operational-root" id="queueing-dashboard-root">
    <div id="dashboard-queueing-content">
        @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Queueing.Dashboard.Pages.Data>())
    </div>
</div>
