@using BlobStorageDashboardRoutes = BridgingIT.DevKit.Presentation.Web.Storage.Blobs.Dashboard.BlobStorageDashboardRoutes
@inherits RazorSlice
@implements IUsesLayout<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages._DashboardLayout, DashboardLayoutModel>

@{
    var dashboardOptions = HttpContext.RequestServices.GetService<DashboardEndpointsOptions>() ?? new DashboardEndpointsOptions();
    var contentPath = BlobStorageDashboardRoutes.BuildBlobsContentPath(dashboardOptions);
    var actionBase = BlobStorageDashboardRoutes.BuildBlobsActionBase(dashboardOptions);
}

<div class="dashboard-page-toolbar">
    <div class="d-flex align-items-center gap-2">
        @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages.RefreshControls, BridgingIT.DevKit.Presentation.Web.Dashboard.DashboardRefreshModel>(new("blobs", "Refresh blobs", true)))
    </div>
</div>
<nav class="nav nav-pills mb-2" aria-label="Storage views" data-dashboard-view="explorer">
    <a class="nav-link active" aria-current="page" href="@(BlobStorageDashboardRoutes.BuildBlobsPath(dashboardOptions))">Explorer</a>
    <a class="nav-link" href="@(BlobStorageDashboardRoutes.BuildBlobsPath(dashboardOptions) + "/diagnostics")">Diagnostics</a>
</nav>

<div id="dashboard-blobs-shell">
    @(await RenderPartialAsync<Content>())
</div>

<div class="dashboard-dialog modal fade" id="blobs-upload-modal" tabindex="-1" aria-hidden="true" aria-labelledby="blobs-upload-modal-title">
    <div class="modal-dialog modal-dialog-scrollable">
        <form class="modal-content" data-blobs-action="@($"{actionBase}/upload")" enctype="multipart/form-data">
            <div class="modal-header">
                <h5 class="modal-title" id="blobs-upload-modal-title">Upload Blob</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="store">
                <input type="hidden" name="container">
                <input type="hidden" name="prefix">
                <input type="hidden" name="mode" value="new">
                <input type="hidden" name="etag">
                <label class="form-label" for="blobs-upload-name">Blob name</label>
                <input id="blobs-upload-name" class="form-control mb-3" name="name" autocomplete="off" placeholder="Use file name">
                <label class="form-label" for="blobs-upload-file">File</label>
                <input id="blobs-upload-file" class="form-control mb-3" type="file" name="file" required>
                <label class="form-label" for="blobs-upload-expires">Expires at (UTC)</label>
                <input id="blobs-upload-expires" class="form-control form-control-sm mb-3" type="datetime-local" name="expiresAt">
                <div class="mb-3" data-blobs-upload-properties>
                    <label class="form-label small" for="blobs-upload-properties">Properties JSON</label>
                    <textarea id="blobs-upload-properties" class="form-control form-control-sm font-monospace"
                              name="properties" rows="4" spellcheck="false" placeholder="{}"></textarea>
                </div>
                @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Storage.Dashboard.Pages.DimensionFields>())
                <div class="small text-body-secondary mb-3" data-blobs-replace-metadata-note hidden>Properties, dimensions, and expiration are kept.</div>
                <div class="form-check">
                    <input id="blobs-upload-overwrite" class="form-check-input" type="checkbox" name="forceOverwrite" value="true" disabled>
                    <label class="form-check-label" for="blobs-upload-overwrite">Force overwrite</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm">Upload</button>
            </div>
        </form>
    </div>
</div>

<div class="dashboard-dialog modal fade" id="blobs-details-modal" tabindex="-1" aria-hidden="true" aria-labelledby="blobs-details-modal-title">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <form class="modal-content" data-blobs-action="@($"{actionBase}/metadata")">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="blobs-details-modal-title">Blob Details</h5>
                    <div class="text-muted small" data-blobs-details-subtitle></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2 small mb-3">
                    <div class="col-12 col-md-6"><span class="text-muted">Store</span><div data-blobs-details-store></div></div>
                    <div class="col-12 col-md-6"><span class="text-muted">Content type</span><div data-blobs-details-content-type></div></div>
                    <div class="col-12 col-md-4"><span class="text-muted">Size</span><div data-blobs-details-size></div></div>
                    <div class="col-12 col-md-4"><span class="text-muted">Created</span><div data-blobs-details-created></div></div>
                    <div class="col-12 col-md-4"><span class="text-muted">Modified</span><div data-blobs-details-modified></div></div>
                    <div class="col-12 col-md-4"><span class="text-muted">Expires</span><div data-blobs-details-expires></div></div>
                    <div class="col-12 col-md-8"><span class="text-muted">ETag</span><div class="font-monospace text-break" data-blobs-details-etag></div></div>
                    <div class="col-12"><span class="text-muted">Content hash</span><div class="font-monospace text-break" data-blobs-details-hash></div></div>
                </div>
                <label class="form-label small" for="blobs-details-properties">Properties JSON</label>
                <textarea id="blobs-details-properties" class="form-control form-control-sm font-monospace mb-3"
                          name="properties" rows="5" spellcheck="false"></textarea>
                @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Storage.Dashboard.Pages.DimensionFields>())
                <div data-blobs-readonly-dimensions hidden>
                    <div class="form-label small mb-1" id="blobs-details-dimensions-label">Dimensions</div>
                    <div class="small text-muted" data-blobs-no-dimensions>None</div>
                    <table class="table table-sm small text-break mb-0" aria-labelledby="blobs-details-dimensions-label"
                           style="min-width: 0; table-layout: fixed" data-blobs-details-dimensions hidden>
                        <thead><tr><th scope="col">Key</th><th scope="col">Type</th><th scope="col">Value</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
                <input type="hidden" name="store"><input type="hidden" name="container"><input type="hidden" name="name"><input type="hidden" name="etag">
                <label class="form-label small mt-3" for="blobs-details-expires-input">Expires at</label>
                <div class="input-group"><input id="blobs-details-expires-input" class="form-control form-control-sm" type="datetime-local" name="expiresAt"><button class="btn btn-outline-secondary btn-sm" type="button" title="Clear expiration" aria-label="Clear expiration" data-blobs-clear-expiration><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
                <details class="mt-3" data-blobs-preview
                         data-preview-url="@BlobStorageDashboardRoutes.BuildBlobsPreviewPath(dashboardOptions)"
                         data-download-url="@BlobStorageDashboardRoutes.BuildBlobsDownloadPath(dashboardOptions)">
                    <summary class="small">Preview content</summary>
                    <div class="mt-2">
                        <div class="small text-muted mb-2" role="status" data-preview-status></div>
                        <pre class="border rounded p-2 mb-2 small text-break" style="white-space: pre-wrap; max-height: 24rem; overflow: auto"
                             tabindex="0" aria-label="Blob text preview" data-preview-text hidden></pre>
                        <img class="img-fluid mb-2" style="max-height: 24rem; object-fit: contain" alt="Blob content preview" data-preview-image hidden>
                        <a class="btn btn-outline-secondary btn-sm" data-preview-download>Download</a>
                    </div>
                </details>
            </div>
            @(await RenderPartialAsync<ModalActions, DashboardModalActionsModel>(new("Save changes")))
        </form>
    </div>
</div>

<div class="dashboard-dialog modal fade" id="blobs-delete-modal" tabindex="-1" aria-hidden="true" aria-labelledby="blobs-delete-modal-title">
    <div class="modal-dialog">
        <form class="modal-content" data-blobs-action="@($"{actionBase}/delete")">
            <div class="modal-header">
                <h5 class="modal-title" id="blobs-delete-modal-title">Delete Blob</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="store">
                <input type="hidden" name="container">
                <input type="hidden" name="name">
                <input type="hidden" name="etag">
                <p class="mb-0" data-blobs-delete-message></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </div>
        </form>
    </div>
</div>

@(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Storage.Dashboard.Pages.DimensionQueryScript>())
@(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Storage.Dashboard.Pages.DimensionFieldsScript>())
@(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Storage.Dashboard.Pages.DimensionExplorerScript>())
@(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Storage.Dashboard.Pages.DimensionFilterNavigationScript>())

<script>
    (() => {
        const shellElement = document.getElementById('dashboard-blobs-shell');
        const uploadForm = document.querySelector('#blobs-upload-modal form');
        const uploadDimensions = window.bdkDashboard.createDimensionFields(uploadForm);
        const detailsForm = document.querySelector('#blobs-details-modal form');
        const detailsModal = detailsForm.closest('.modal');
        const detailsDimensions = window.bdkDashboard.createDimensionFields(detailsForm);
        const dimensionExplorer = window.bdkDashboard.createDimensionExplorer({
            owner: shellElement,
            root: getRoot,
            scope: () => getState().store,
            applyFilter: dimensionFilter =>
                refreshContent({ ...getState(), dimensionFilter, continuationToken: '' }, true, true)
        });
        const baseContentUrl = '@contentPath';
        const dimensionNavigation = window.bdkDashboard.createDimensionFilterNavigation({
            root: getRoot,
            buildQuery: () => buildContentUrl(getState())
        });
        const fullScanStorageKey = 'bdk.blobStorage.allowFullScan';
        const prefixHistoryStorageKey = 'bdk.blobStorage.prefixHistory';
        const prefixHistoryLimit = 20;
        const preview = detailsForm.querySelector('[data-blobs-preview]');
        const previewStatus = preview.querySelector('[data-preview-status]');
        const previewText = preview.querySelector('[data-preview-text]');
        const previewImage = preview.querySelector('[data-preview-image]');
        let previewQuery;
        let previewController;
        let previewImageUrl;

        function getRoot() {
            return shellElement?.querySelector('#blobs-dashboard-root');
        }

        function getState() {
            const root = getRoot();
            return {
                store: root?.dataset.store || '',
                dimensionFilter: root?.dataset.dimensionFilter || '',
                container: root?.dataset.container || '',
                prefix: root?.dataset.prefix || '',
                take: root?.dataset.take || '100',
                allowFullScan: root?.dataset.allowFullScan === 'true',
                continuationToken: root?.dataset.continuationToken || ''
            };
        }

        function setUrl(state) {
            const url = new URL(window.location.href);
            for (const key of ['store', 'container', 'prefix', 'take', 'continuationToken', 'dimensionFilter']) {
                if (state[key]) {
                    url.searchParams.set(key, state[key]);
                } else {
                    url.searchParams.delete(key);
                }
            }

            url.searchParams.set('allowFullScan', state.allowFullScan ? 'true' : 'false');

            window.history.replaceState({}, '', url);
        }

        function buildContentUrl(state) {
            const url = new URL(baseContentUrl, window.location.origin);
            for (const key of ['store', 'container', 'prefix', 'take', 'continuationToken', 'dimensionFilter']) {
                if (state[key]) {
                    url.searchParams.set(key, state[key]);
                }
            }

            url.searchParams.set('allowFullScan', state.allowFullScan ? 'true' : 'false');

            return url;
        }

        let contentController = null;
        async function refreshContent(state, updateUrl, preserveDraft = false, acceptQueryError = false) {
            listPending = true;
            growingList.cancel();
            refresher.cancel(); contentController?.abort();
            const controller = new AbortController(); contentController = controller;
            const previous = getState();
            const sameSelection = ['store', 'container', 'prefix', 'take', 'allowFullScan', 'dimensionFilter'].every(key => String(state[key] ?? '') === String(previous[key] ?? ''));
            try {
                const response = await fetch(buildContentUrl(state).toString(), { cache: 'no-store', headers: { 'X-Requested-With': 'fetch' }, signal: controller.signal });
                if (!response.ok || response.redirected || !(response.headers.get('content-type') || '').includes('text/html')) throw new Error('Blobs could not be loaded.');
                const html = await response.text();
                if (controller.signal.aborted || contentController !== controller) return;
                const validation = document.createElement('template'); validation.innerHTML = html;
                const queryError = validation.content.querySelector('[data-dashboard-query-error]');
                if (queryError && !acceptQueryError && state.store === previous.store) {
                    dimensionExplorer.showQueryError(queryError);
                    document.getElementById('blobs-refresh-status').textContent = 'Filters could not be applied';
                    return;
                }
                const editedDimensionFilter = shellElement.querySelector('[name="dimensionFilter"]')?.value || '';
                const keepDimensionDraft = editedDimensionFilter !== (state.dimensionFilter || '');
                const draft = (sameSelection || preserveDraft || keepDimensionDraft) ? window.bdkDashboard.captureFilterDraft(shellElement, '[data-blobs-filter-form]') : null;
                growingList.applyResponse(shellElement, html);
                if (draft) window.bdkDashboard.restoreFilterDraft(shellElement, '[data-blobs-filter-form]', draft);
                dimensionExplorer.mount();
                if (updateUrl) setUrl(state);
                window.bdkDashboard.clearRefreshError(shellElement);
                document.getElementById('blobs-refresh-status').textContent = `Updated ${new Date().toISOString().slice(11, 19)} UTC`;
                populatePrefixHistory();
            } catch (error) {
                if (error.name !== 'AbortError' && contentController === controller) {
                    window.bdkDashboard.showRefreshError(shellElement);
                    document.getElementById('blobs-refresh-status').textContent = 'Refresh failed; displayed data is stale';
                }
            } finally { if (contentController === controller) { contentController = null; listPending = false; refresher.schedule(); } }
        }

        function prefixHistoryScope(state) {
            return `${state.store || 'default'}:${state.container || 'default'}`;
        }

        function readPrefixHistoryMap() {
            try {
                const value = window.bdkDashboard.state.getJson(prefixHistoryStorageKey, {});
                if (Array.isArray(value)) {
                    return { default: value };
                }

                return value && typeof value === 'object' ? value : {};
            } catch {
                return {};
            }
        }

        function getPrefixHistory(state) {
            const map = readPrefixHistoryMap();
            const values = map[prefixHistoryScope(state)] || map.default || [];
            return Array.isArray(values)
                ? values.filter(value => typeof value === 'string' && value.trim().length > 0)
                : [];
        }

        function rememberPrefix(state) {
            const normalized = (state.prefix || '').trim();
            if (!normalized) return;
            const map = readPrefixHistoryMap();
            const scope = prefixHistoryScope(state);
            const values = Array.isArray(map[scope]) ? map[scope] : [];
            map[scope] = [normalized, ...values.filter(value => value !== normalized)].slice(0, prefixHistoryLimit);
            window.bdkDashboard.state.setJson(prefixHistoryStorageKey, map);
        }

        function populatePrefixHistory(state = getState()) {
            const list = shellElement.querySelector('#blobs-prefix-history');
            if (!list) return;
            list.replaceChildren(...getPrefixHistory(state).map(value => {
                const option = document.createElement('option');
                option.value = value;
                return option;
            }));
        }

        function formatSize(bytes) {
            const value = Number(bytes || 0);
            if (value >= 1073741824) return `${(value / 1073741824).toFixed(2).replace(/\.00$/, '')} GB`;
            if (value >= 1048576) return `${(value / 1048576).toFixed(2).replace(/\.00$/, '')} MB`;
            if (value >= 1024) return `${(value / 1024).toFixed(2).replace(/\.00$/, '')} KB`;
            return `${value} B`;
        }

        function formatTimestamp(value) {
            if (!value) return '-';
            const timestamp = new Date(value);
            return Number.isNaN(timestamp.valueOf()) ? value : timestamp.toISOString().replace('T', ' ').replace('Z', ' UTC');
        }

        function toDateTimeLocal(value) {
            if (!value) return '';
            const date = new Date(value);
            return Number.isNaN(date.valueOf()) ? '' : new Date(date.getTime() - date.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
        }

        function clearPreview() {
            previewController?.abort();
            previewController = null;
            if (previewImageUrl) URL.revokeObjectURL(previewImageUrl);
            previewImageUrl = null;
            previewImage.removeAttribute('src');
            previewImage.hidden = true;
            previewText.textContent = '';
            previewText.hidden = true;
            previewStatus.textContent = '';
        }

        preview.addEventListener('toggle', async () => {
            clearPreview();
            if (!preview.open || !previewQuery) return;
            const controller = new AbortController();
            previewController = controller;
            previewStatus.textContent = 'Loading preview…';
            try {
                const response = await fetch(preview.dataset.previewUrl + '?' + previewQuery, {
                    cache: 'no-store',
                    signal: controller.signal
                });
                if (!response.ok || response.redirected) {
                    const problem = await response.json().catch(() => null);
                    if (!controller.signal.aborted) previewStatus.textContent = problem?.detail || 'Preview could not be loaded.';
                    return;
                }
                const contentType = response.headers.get('content-type') || '';
                if (contentType.startsWith('image/')) {
                    const image = await response.blob();
                    if (controller.signal.aborted) return;
                    previewImageUrl = URL.createObjectURL(image);
                    previewImage.src = previewImageUrl;
                    previewImage.hidden = false;
                    previewStatus.textContent = '';
                } else if (contentType.startsWith('text/plain')) {
                    const text = await response.text();
                    if (controller.signal.aborted) return;
                    previewText.textContent = text;
                    previewText.hidden = !text;
                    previewStatus.textContent = text ? '' : 'This blob is empty.';
                } else {
                    previewStatus.textContent = 'This file type cannot be previewed.';
                }
            } catch (error) {
                if (!controller.signal.aborted) previewStatus.textContent = 'Preview could not be loaded.';
            }
        });
        previewImage.addEventListener('error', () => {
            if (!previewImageUrl) return;
            clearPreview();
            previewStatus.textContent = 'This image cannot be previewed.';
        });
        detailsModal.addEventListener('hidden.bs.modal', () => {
            preview.open = false;
            clearPreview();
        });

        function showDetails(target) {
            const modal = detailsModal;
            const value = selector => target.dataset[selector] || '-';
            modal.querySelector('[data-blobs-details-subtitle]').textContent = `${target.dataset.container || ''} / ${target.dataset.name || ''}`;
            modal.querySelector('[data-blobs-details-store]').textContent = getState().store || '-';
            modal.querySelector('[data-blobs-details-content-type]').textContent = value('contentType');
            modal.querySelector('[data-blobs-details-size]').textContent = formatSize(target.dataset.length);
            modal.querySelector('[data-blobs-details-created]').textContent = formatTimestamp(target.dataset.createdAt);
            modal.querySelector('[data-blobs-details-modified]').textContent = formatTimestamp(target.dataset.modifiedAt);
            modal.querySelector('[data-blobs-details-expires]').textContent = formatTimestamp(target.dataset.expiresAt);
            modal.querySelector('[data-blobs-details-etag]').textContent = value('etag');
            modal.querySelector('[data-blobs-details-hash]').textContent = value('contentHash');
            const form = detailsForm;
            form.elements.store.value = getState().store || '';
            form.elements.container.value = target.dataset.container || '';
            form.elements.name.value = target.dataset.name || '';
            form.elements.etag.value = target.dataset.etag || '';
            preview.open = false;
            clearPreview();
            previewQuery = new URLSearchParams({
                store: form.elements.store.value, container: form.elements.container.value, name: form.elements.name.value
            }).toString();
            preview.querySelector('[data-preview-download]').href = preview.dataset.downloadUrl + '?' + previewQuery;
            form.querySelector('[data-etag-conflict-actions]')?.remove();
            form.elements.expiresAt.defaultValue = form.elements.expiresAt.value = toDateTimeLocal(target.dataset.expiresAt);
            form.elements.properties.defaultValue = form.elements.properties.value = target.dataset.properties || '{}';
            const canEditDimensions = getRoot()?.dataset.supportsDimensionUpdates === 'true';
            const dimensions = target.closest('[data-dashboard-row-id]')?.dataset.dimensions || '{}';
            detailsDimensions.load(canEditDimensions ? dimensions : null, canEditDimensions,
                (key, value) => dimensionExplorer.filterAction(key, value, modal));
            showReadonlyDimensions(modal, canEditDimensions ? null : dimensions);
            window.bdkDashboard.markDialogSaved(modal);
            showModal(modal.id);
        }

        function showReadonlyDimensions(modal, json) {
            const section = modal.querySelector('[data-blobs-readonly-dimensions]');
            section.hidden = json === null;
            const dimensions = Object.entries(JSON.parse(json || '{}'));
            const table = section.querySelector('[data-blobs-details-dimensions]');
            table.hidden = dimensions.length === 0;
            modal.querySelector('[data-blobs-no-dimensions]').hidden = !table.hidden;
            const rows = table.tBodies[0];
            rows.replaceChildren();
            for (const [key, dimension] of dimensions) {
                const row = rows.insertRow();
                row.insertCell().textContent = key;
                row.insertCell().textContent = dimension.type;
                const cell = row.insertCell();
                cell.style.whiteSpace = 'pre-wrap';
                cell.textContent = dimension.value === '' ? '""' : String(dimension.value);
                const filter = dimensionExplorer.filterAction(key, dimension, modal);
                if (filter) {
                    const button = window.bdkDashboard.createDimensionFilterButton(key, filter);
                    button.classList.add('ms-2');
                    cell.append(button);
                }
            }
        }

        let listPending = false;
        const growingList = window.bdkDashboard.createGrowingLists({
            owner: shellElement, root: () => shellElement,
            appliedUrl: () => buildContentUrl(getState()), hasPending: () => listPending,
            lists: [{ key: 'blobs', cursor: 'continuationToken', boundary: 'listBoundary', size: 'take' }],
            onAppended: dimensionExplorer.renderColumns,
            onRestored: dimensionExplorer.renderColumns,
            onSizeChange: (list, value) => {
                const state = getState(); state.take = value; state.continuationToken = '';
                refreshContent(state, true, true);
            }
        });

        const refresher = window.bdkDashboard.createRefresher({
            applyResponse: growingList.applyResponse,
            buildUrl: () => buildContentUrl(getState()),
            contentSelector: () => shellElement,
            preserveDraftSelector: "[data-blobs-filter-form]",
            statusSelector: '#blobs-refresh-status',
            intervalSelector: '#blobs-refresh-interval',
            refreshButtonSelector: '#blobs-refresh-now',
            storageKey: 'bdk.dashboard.blobs.refreshInterval',
            shouldRefresh: () => !growingList.busy() && contentController === null &&
                document.querySelector('#blobs-upload-modal.show, #blobs-details-modal.show, #blobs-delete-modal.show') === null &&
                !shellElement.querySelector('[data-dimension-columns][open]'),
            onSuccess: () => { populatePrefixHistory(); dimensionExplorer.mount(); }
        });

        function showModal(id) {
            const modalElement = document.getElementById(id);
            const modal = window.bootstrap.Modal.getOrCreateInstance(modalElement);
            modal.show();
            return modalElement;
        }

        function hideModal(form) {
            const modalElement = form.closest('.modal');
            if (modalElement) {
                window.bdkDashboard.markDialogSaved(modalElement);
                window.bootstrap.Modal.getOrCreateInstance(modalElement).hide();
            }
        }

        function setContextFields(form) {
            const state = getState();
            form.elements.store.value = state.store;
            if (form.elements.container) {
                form.elements.container.value = state.container;
            }
            if (form.elements.prefix) {
                form.elements.prefix.value = state.prefix;
            }
        }

        function showConflictActions(form) {
            form.querySelector('[data-etag-conflict-actions]')?.remove();
            const actions = document.createElement('div');
            actions.dataset.etagConflictActions = '';
            actions.className = 'd-flex flex-wrap gap-2 p-3';
            const reload = document.createElement('button');
            reload.type = 'button'; reload.className = 'btn btn-outline-secondary btn-sm'; reload.textContent = 'Reload current item';
            reload.onclick = async () => {
                if (!await window.bdkDashboard.confirmAction({ title: 'Reload current item', message: 'Discard your changes and reload the current item?', confirmText: 'Reload' })) return;
                await refreshContent(getState(), false);
                const row = Array.from(shellElement.querySelectorAll('[data-blobs-command="details"]')).find(item => item.dataset.container === form.elements.container.value && item.dataset.name === form.elements.name.value);
                if (!row) { window.bdkDashboard.showDialogError(form.closest('.modal'), 'The item was deleted or is no longer in this list.'); return; }
                if (form.elements.mode) {
                    form.elements.etag.value = row.dataset.etag;
                    form.elements.file.value = '';
                    form.elements.forceOverwrite.checked = false;
                    form.elements.expiresAt.value = toDateTimeLocal(row.dataset.expiresAt);
                } else { showDetails(row); }
                actions.remove();
            };
            const force = document.createElement('button');
            force.type = 'button'; force.className = 'btn btn-outline-danger btn-sm'; force.textContent = 'Force overwrite';
            force.onclick = () => submitForm(form, form.dataset.blobsAction, true);
            actions.append(reload, force); form.querySelector('.modal-body').append(actions);
        }

        async function submitForm(form, actionUrl, forceOverwrite = false) {
            const button = form.querySelector('[type="submit"]');
            if (button?.disabled || !form.reportValidity()) return;
            if (button) {
                button.disabled = true;
            }

            try {
                const payload = new FormData(form);
                if (form === uploadForm) uploadDimensions.write(payload);
                if (form === detailsForm) {
                    detailsDimensions.write(payload);
                    const { properties, expiresAt } = form.elements;
                    if (properties.value === properties.defaultValue) payload.delete('properties');
                    if (expiresAt.value === expiresAt.defaultValue) payload.delete('expiresAt');
                    else if (expiresAt.value) payload.set('expiresAt', new Date(expiresAt.value).toISOString());
                }
                if (forceOverwrite) payload.set('forceOverwrite', 'true');
                const response = await fetch(actionUrl, {
                    method: 'POST',
                    body: payload,
                    headers: { 'X-Requested-With': 'fetch' }
                });

                if (response.status === 409 && !actionUrl.endsWith('/delete') && (!form.elements.mode || form.elements.mode.value === 'edit')) {
                    window.bdkDashboard.showDialogError(form.closest('.modal'), 'The stored item changed. Your changes have been kept.');
                    showConflictActions(form);
                    return;
                }
                if (!response.ok) {
                    const problem = response.status === 400 ? await response.json().catch(() => null) : null;
                    window.bdkDashboard.showDialogError(form.closest('.modal'),
                        problem?.detail || 'The action failed. Your changes have been kept.');
                    return;
                }

                hideModal(form);
                form.reset();
                growingList.lists.get('blobs').appended = false;
                await refresher.refresh(true);
            } catch (error) {
                window.bdkDashboard.showDialogError(form.closest('.modal'), 'The action failed. Your changes have been kept; try again.');
                console.error('Blob action error:', error);
            } finally {
                if (button) {
                    button.disabled = false;
                }
            }
        }

        shellElement.addEventListener('submit', async event => {
            const form = event.target.closest('[data-blobs-filter-form]');
            if (!form) {
                return;
            }

            event.preventDefault();
            const data = new FormData(form);
            const state = {
                store: data.get('store') || '',
                dimensionFilter: data.get('dimensionFilter') || '',
                container: data.get('container') || '',
                prefix: data.get('prefix') || '',
                take: data.get('take') || '100',
                allowFullScan: data.get('allowFullScan') === 'true',
                continuationToken: ''
            };

            window.bdkDashboard.state.set(fullScanStorageKey, state.allowFullScan ? 'true' : 'false');
            rememberPrefix(state);

            await refreshContent(state, true);
        });

        shellElement.addEventListener('click', async event => {
            const target = event.target.closest('[data-blobs-command], #blobs-filter-reset');
            if (!target) {
                return;
            }

            const command = target.id === "blobs-filter-reset" ? "clear-filter" : target.dataset.blobsCommand;
            if (command === 'upload') {
                const modal = showModal('blobs-upload-modal');
                const form = modal.querySelector('form');
                form.reset();
                form.querySelector('[data-etag-conflict-actions]')?.remove();
                setContextFields(form);
                form.querySelector('[name="name"]').value = '';
                form.elements.name.readOnly = false;
                form.elements.mode.value = 'new';
                form.elements.expiresAt.disabled = false;
                form.elements.properties.disabled = false;
                form.querySelector('[data-blobs-upload-properties]').hidden = false;
                uploadDimensions.load(null, getRoot()?.dataset.supportsDimensions === 'true');
                form.querySelector('[data-blobs-replace-metadata-note]').hidden = true;
                form.elements.etag.value = '';
                form.elements.forceOverwrite.checked = false;
                form.elements.forceOverwrite.disabled = true;
                return;
            }

            if (command === 'replace') {
                const modal = showModal('blobs-upload-modal');
                const form = modal.querySelector('form');
                form.reset();
                form.querySelector('[data-etag-conflict-actions]')?.remove();
                setContextFields(form);
                form.elements.container.value = target.dataset.container;
                form.elements.prefix.value = '';
                form.elements.name.value = target.dataset.name;
                form.elements.name.readOnly = true;
                form.elements.mode.value = 'edit';
                form.elements.expiresAt.value = toDateTimeLocal(target.dataset.expiresAt);
                form.elements.expiresAt.disabled = true;
                form.elements.properties.disabled = true;
                form.querySelector('[data-blobs-upload-properties]').hidden = true;
                uploadDimensions.load(null, false);
                form.querySelector('[data-blobs-replace-metadata-note]').hidden = false;
                form.elements.etag.value = target.dataset.etag;
                form.elements.forceOverwrite.disabled = false;
                return;
            }

            if (command === 'delete') {
                const modal = showModal('blobs-delete-modal');
                const form = modal.querySelector('form');
                setContextFields(form);
                form.elements.name.value = target.dataset.name || '';
                form.elements.etag.value = target.dataset.etag || '';
                modal.querySelector('[data-blobs-delete-message]').textContent =
                    `Delete blob '${target.dataset.container}/${target.dataset.name}'?`;
                return;
            }

            if (command === 'details') {
                showDetails(target);
                return;
            }

            if (command === 'clear-filter') {
                const state = getState();
                state.prefix = '';
                state.dimensionFilter = '';
                state.allowFullScan = false;
                state.continuationToken = '';
                dimensionNavigation.reset();
                window.bdkDashboard.storageDimensions.clear(shellElement.querySelector('[data-blobs-filter-form]'));
                await refreshContent(state, true, false, true);
                return;
            }

        });

        shellElement.addEventListener('change', async event => {
            if (!event.target.matches('#blobs-store, #blobs-container')) {
                return;
            }

            const form = event.target.closest('[data-blobs-filter-form]');
            if (!form) {
                return;
            }

            const data = new FormData(form);
            if (event.target.name === 'store') {
                window.bdkDashboard.storageDimensions.clear(form);
                await refreshContent({ ...getState(), store: data.get('store') || '', container: '', prefix: '', dimensionFilter: '', continuationToken: '' }, true);
                return;
            }

            populatePrefixHistory({
                store: data.get('store') || '',
                container: data.get('container') || ''
            });
        });

        document.querySelectorAll('[data-blobs-action]').forEach(form => {
            form.addEventListener('submit', async event => {
                event.preventDefault();
                await submitForm(form, form.dataset.blobsAction);
            });
        });

        document.querySelector('[data-blobs-clear-expiration]')?.addEventListener('click', () => {
            const input = document.getElementById('blobs-details-expires-input');
            input.value = '';
            input.focus();
        });

        shellElement.addEventListener('submit', async event => {
            const form = event.target.closest('[data-permalink-copy-form]');
            if (!form) return;
            event.preventDefault();
            const button = event.submitter;
            const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
            if (!response.ok) return;
            const payload = await response.json();
            await navigator.clipboard.writeText(new URL(payload.url, location.origin).href);
            const icon = button?.querySelector('i');
            if (icon) { icon.className = 'bi bi-check-lg'; setTimeout(() => icon.className = 'bi bi-clipboard', 1200); }
        });

        if (dimensionNavigation.resume()) return;
        const restoredDimensionDraft = dimensionNavigation.restoreDraft();
        populatePrefixHistory();
        dimensionExplorer.mount();
        const storedFullScan = window.bdkDashboard.state.get(fullScanStorageKey);
        if (storedFullScan === null) {
            window.bdkDashboard.state.set(fullScanStorageKey, 'true');
        } else if (!restoredDimensionDraft && !new URLSearchParams(location.search).has('allowFullScan')) {
            const desired = storedFullScan === 'true';
            const state = getState();
            if (state.allowFullScan !== desired) {
                state.allowFullScan = desired;
                state.continuationToken = '';
                refreshContent(state, true);
            }
        }
    })();
</script>

@functions {
    public DashboardLayoutModel LayoutModel => new() { Title = "Blobs" };
}
