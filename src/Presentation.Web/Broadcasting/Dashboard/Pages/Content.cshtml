@using BridgingIT.DevKit.Common
@using BridgingIT.DevKit.Presentation.Web
@using Microsoft.Extensions.DependencyInjection
@using RazorSlices
@inherits RazorSlice

@{
    var diagnostics = this.HttpContext.RequestServices.GetService<IBroadcastingDiagnostics>();
    var metrics = this.HttpContext.RequestServices.GetService<IMetricsSnapshotService>();
    BroadcastingDiagnosticSnapshot snapshot = null;
    string loadError = null;
    double? publishedCount = null;
    double? acceptedLocallyCount = null;

    if (diagnostics is not null)
    {
        try
        {
            snapshot = await diagnostics.GetAsync(this.HttpContext.RequestAborted);
        }
        catch (OperationCanceledException) when (this.HttpContext.RequestAborted.IsCancellationRequested)
        {
            throw;
        }
        catch
        {
            loadError = "Registry diagnostics could not be loaded.";
        }
    }

    if (metrics is not null)
    {
        try
        {
            var metricsSnapshot = metrics.GetSnapshot();
            publishedCount = 0;
            acceptedLocallyCount = 0;
            if (metricsSnapshot.Features.TryGetValue("broadcasting", out var broadcastingMetrics))
            {
                publishedCount = SumCounters(
                    broadcastingMetrics,
                    "broadcasting_publish_"
                );
                acceptedLocallyCount = SumCounters(
                    broadcastingMetrics,
                    "broadcasting_receiver_",
                    "_accepted"
                );
            }
        }
        catch
        {
            // Metrics are optional; registry diagnostics remain useful when a snapshot is unavailable.
        }
    }

    var registrations = (snapshot?.Scopes ?? [])
        .SelectMany(scope => scope.Nodes)
        .GroupBy(node => node.NodeIdentity, StringComparer.OrdinalIgnoreCase)
        .Select(group =>
        {
            var registration = group.OrderByDescending(node => node.RegisteredUtc).First();
            return registration with
            {
                Scopes = group
                    .SelectMany(node => node.Scopes)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(scope => scope, StringComparer.OrdinalIgnoreCase)
                    .ToArray()
            };
        })
        .OrderByDescending(node => node.IsActive)
        .ThenBy(node => node.NodeIdentity, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    var activeCount = registrations.Count(node => node.IsActive);
}

@if (diagnostics is null)
{
    <div class="alert alert-warning py-2 mb-2">
        Broadcasting is not registered for this host.
    </div>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-danger py-2 mb-2">@loadError</div>
}
else if (snapshot?.Enabled != true)
{
    <div class="alert alert-secondary py-2 mb-2">
        Broadcasting is configured but disabled. No node registration or receiver is active.
    </div>
}

<div class="row row-cols-2 row-cols-lg-5 g-2 mb-3">
    <div class="col">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase">Published</div>
                <div class="fs-4 fw-semibold">@FormatCounter(publishedCount)</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase">Accepted locally</div>
                <div class="fs-4 fw-semibold text-success">@FormatCounter(acceptedLocallyCount)</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase">Scopes</div>
                <div class="fs-4 fw-semibold">@((snapshot?.Scopes.Count ?? 0).ToString("N0", CultureInfo.InvariantCulture))</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase">Active nodes</div>
                <div class="fs-4 fw-semibold text-success">@activeCount.ToString("N0", CultureInfo.InvariantCulture)</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase">Inactive nodes</div>
                <div class="fs-4 fw-semibold @(registrations.Length > activeCount ? "text-warning" : "")">
                    @((registrations.Length - activeCount).ToString("N0", CultureInfo.InvariantCulture))
                </div>
            </div>
        </div>
    </div>
</div>

<section>
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h6 class="mb-0">Node registrations</h6>
        </div>
        <span class="badge text-bg-secondary">@registrations.Length.ToString("N0", CultureInfo.InvariantCulture)</span>
    </div>

    @if (registrations.Length == 0)
    {
        <div class="card">
            <div class="card-body py-4 text-center text-muted">
                <i class="bi bi-broadcast-pin fs-3 d-block mb-2"></i>
                No node registrations are available.
            </div>
        </div>
    }
    else
    {
        <div class="card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                    <tr>
                        <th class="ps-3">Node</th>
                        <th>Scopes</th>
                        <th>Receiver</th>
                        <th>Reachability</th>
                        <th>Registration</th>
                        <th class="pe-3">Lease</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var node in registrations)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="rounded-circle @(node.IsActive ? "bg-success" : "bg-secondary")"
                                          style="width:.55rem;height:.55rem"
                                          title="@(node.IsActive ? "Active" : "Inactive")"></span>
                                    <div>
                                        <div class="fw-semibold text-break">@node.NodeIdentity</div>
                                        <div class="text-muted small">Protocol @node.ProtocolVersion</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var scope in node.Scopes)
                                    {
                                        <span class="badge text-bg-light border">@scope</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (node.AdvertisedAddress is null)
                                {
                                    <span class="text-muted">Local only</span>
                                }
                                else
                                {
                                    <code class="small text-break">@node.AdvertisedAddress</code>
                                }
                            </td>
                            <td>
                                <div class="small">
                                    <div>
                                        <span class="text-muted">Success</span>
                                        @FormatTimestamp(node.LastSuccessUtc)
                                    </div>
                                    <div class="@(node.ConsecutiveFailureCount > 0 ? "text-danger" : "text-muted")">
                                        @node.ConsecutiveFailureCount consecutive failures
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(node.LastFailure))
                                    {
                                        <div class="text-danger text-break">@node.LastFailure</div>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="small">
                                    <div><span class="text-muted">Started</span> @FormatTimestamp(node.ProcessStartedUtc)</div>
                                    <div><span class="text-muted">Written</span> @FormatTimestamp(node.RegisteredUtc)</div>
                                </div>
                            </td>
                            <td class="pe-3">
                                <div class="small">
                                    @if (node.LeaseExpiresUtc is null)
                                    {
                                        <span class="text-muted">Not enabled</span>
                                    }
                                    else
                                    {
                                        <div><span class="text-muted">Renewed</span> @FormatTimestamp(node.LeaseRenewedUtc)</div>
                                        <div><span class="text-muted">Expires</span> @FormatTimestamp(node.LeaseExpiresUtc)</div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

@functions {
    private static double SumCounters(
        BdkFeatureSnapshotModel feature,
        string prefix,
        string suffix = null
    )
    {
        return feature.Counters
            .Where(counter =>
                counter.Key.StartsWith(prefix, StringComparison.Ordinal)
                && (
                    suffix is null
                    || counter.Key.EndsWith(suffix, StringComparison.Ordinal)
                )
            )
            .Sum(counter => counter.Value);
    }

    private static string FormatCounter(double? value)
    {
        return value?.ToString("N0", CultureInfo.InvariantCulture) ?? "-";
    }

    private static string FormatTimestamp(DateTimeOffset? value)
    {
        return value?.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) ?? "-";
    }
}
