@using BridgingIT.DevKit.Presentation.Web.Broadcasting.Dashboard.Pages
@using BridgingIT.DevKit.Presentation.Web.Dashboard
@using BridgingIT.DevKit.Presentation.Web.Dashboard.Pages
@using Microsoft.Extensions.DependencyInjection
@inherits RazorSlice
@implements IUsesLayout<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages._DashboardLayout, DashboardLayoutModel>

@{
    var dashboardOptions = HttpContext.RequestServices.GetService<DashboardEndpointsOptions>() ?? new DashboardEndpointsOptions();
    var contentPath = BridgingIT.DevKit.Presentation.Web.Broadcasting.Dashboard.DashboardEndpoints.BuildBroadcastingContentPath(dashboardOptions);
    var publishPath = BridgingIT.DevKit.Presentation.Web.Broadcasting.Dashboard.DashboardEndpoints.BuildBroadcastingPublishPath(dashboardOptions);
    var broadcastingOptions = HttpContext.RequestServices.GetService<BridgingIT.DevKit.Common.BroadcastingOptions>();
    var probeEnabled = HttpContext.RequestServices.GetService<BridgingIT.DevKit.Common.IBroadcastService>() is not null
        && broadcastingOptions?.Enabled != false;
}

<div class="dashboard-page-toolbar">
    <div class="d-flex align-items-center gap-2">
        @if (probeEnabled)
        {
            <button type="button"
                    class="btn btn-outline-primary btn-sm"
                    title="Publish broadcast probe to the default scope"
                    onclick="window.bdkBroadcastingAction('@publishPath')" aria-label="Publish broadcast probe to the default scope">
                <i class="bi bi-broadcast" aria-hidden="true"></i>
            </button>
        }
        @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages.RefreshControls, BridgingIT.DevKit.Presentation.Web.Dashboard.DashboardRefreshModel>(new("broadcasting", "Refresh Broadcasting registrations", true)))
    </div>
</div>

<div id="dashboard-broadcasting-content">
    @(await RenderPartialAsync<Content>())
</div>

<script>
    (() => {
        const refresher = window.bdkDashboard.createRefresher({
            contentUrl: '@contentPath',
            contentSelector: '#dashboard-broadcasting-content',
            statusSelector: '#broadcasting-refresh-status',
            intervalSelector: '#broadcasting-refresh-interval',
            refreshButtonSelector: '#broadcasting-refresh-now',
            storageKey: 'bdk.dashboard.broadcasting.refreshInterval'
        });

        window.bdkBroadcastingAction = async function(url) {
            await window.bdkDashboard.postAction(url, {
                refresh: refresher.refresh,
                errorMessage: 'Broadcasting probe failed:'
            });
        };
    })();
</script>

@functions {
    public DashboardLayoutModel LayoutModel => new() { Title = "Broadcasting" };
}
