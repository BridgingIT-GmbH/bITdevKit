@using System.Globalization
@using BridgingIT.DevKit.Presentation.Web.ConsoleCommands.Dashboard.Pages
@using BridgingIT.DevKit.Presentation.Web.Dashboard
@using BridgingIT.DevKit.Presentation.Web.Dashboard.Pages
@using Microsoft.Extensions.DependencyInjection
@inherits DashboardPageSlice

@{
    var dashboardOptions = HttpContext.RequestServices.GetService<DashboardEndpointsOptions>() ?? new DashboardEndpointsOptions();
    var view = McpDashboardEndpoints.GetView(HttpContext);
    var contentPath = McpDashboardEndpoints.BuildMcpContentPath(dashboardOptions, view);
}

<div class="dashboard-page-toolbar">
    <div class="d-flex align-items-center gap-2">
        @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages.RefreshControls, BridgingIT.DevKit.Presentation.Web.Dashboard.DashboardRefreshModel>(new("mcp", "Refresh MCP diagnostics", true)))
    </div>
</div>

@(await RenderPartialAsync<McpViewNavigation, string>(view))

@if (view == "operations")
{
    <div class="dashboard-filter-panel"><div class="row g-2 align-items-end">
        <div class="col"><label class="form-label small" for="mcp-operation-search">Search operations</label><input id="mcp-operation-search" type="search" class="form-control form-control-sm" placeholder="Name, feature, toolset or handler" /></div>
        <div class="col-auto"><button id="mcp-operation-reset" type="button" class="btn btn-outline-secondary btn-sm" title="Reset filters" aria-label="Reset filters"><i class="bi bi-x-circle" aria-hidden="true"></i></button></div>
        <div class="col-auto"><span id="mcp-operation-count" class="small text-muted" role="status"></span></div>
    </div></div>
}

<div id="dashboard-mcp-content">
    @(await RenderPartialAsync<McpContent>())
</div>

<div class="dashboard-dialog modal fade" id="dashboard-mcp-schema-modal" tabindex="-1" aria-labelledby="dashboard-mcp-schema-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="dashboard-mcp-schema-title">Argument schema</h5>
                    <div id="dashboard-mcp-schema-operation" class="dashboard-mcp-description"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <pre id="dashboard-mcp-schema-content" class="dashboard-mcp-schema-pre bg-body-tertiary border rounded p-3 mb-0"></pre>
            </div>
            @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages.ModalActions, BridgingIT.DevKit.Presentation.Web.Dashboard.DashboardModalActionsModel>(new()))
        </div>
    </div>
</div>

<script>
    (() => {
        const modal = document.getElementById('dashboard-mcp-schema-modal');
        const operationElement = document.getElementById('dashboard-mcp-schema-operation');
        const schemaElement = document.getElementById('dashboard-mcp-schema-content');
        let schemaModalOpen = false;

        const search = document.getElementById('mcp-operation-search');
        function filterOperations() {
            const query = (search?.value || '').trim().toLocaleLowerCase();
            const rows = [...document.querySelectorAll('.dashboard-mcp-operations-table tbody > tr')];
            let count = 0;
            rows.forEach(row => { row.hidden = !row.textContent.toLocaleLowerCase().includes(query); if (!row.hidden) count++; });
            const status = document.getElementById('mcp-operation-count');
            if (status) status.textContent = `${count} of ${rows.length} operations`;
        }
        search?.addEventListener('input', filterOperations);
        document.getElementById('mcp-operation-reset')?.addEventListener('click', () => { search.value = ''; filterOperations(); search.focus(); });
        filterOperations();

        const refresher = window.bdkDashboard.createRefresher({
            contentUrl: '@contentPath',
            contentSelector: '#dashboard-mcp-content',
            statusSelector: '#mcp-refresh-status',
            intervalSelector: '#mcp-refresh-interval',
            refreshButtonSelector: '#mcp-refresh-now',
            storageKey: 'bdk.dashboard.mcp.refreshInterval',
            onSuccess: filterOperations,
            shouldRefresh: () => !schemaModalOpen
        });

        if (!modal || !operationElement || !schemaElement) {
            return;
        }

        modal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            schemaModalOpen = true;
            operationElement.textContent = button?.dataset?.operation || '';
            schemaElement.textContent = button?.dataset?.schema || '{}';
        });

        modal.addEventListener('hidden.bs.modal', () => {
            schemaModalOpen = false;
            refresher.schedule();
        });
    })();
</script>

@functions {
    public override string PageTitle => "MCP";

}
