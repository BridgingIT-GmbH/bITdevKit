@using BridgingIT.DevKit.Presentation.Web.Dashboard
@using BridgingIT.DevKit.Presentation.Web.Dashboard.Pages
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.AspNetCore.WebUtilities
@inherits RazorSlice<DashboardIndexModel>
@implements IUsesLayout<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages._DashboardLayout, DashboardLayoutModel>

@{
    var dashboardOptions = HttpContext.RequestServices.GetService<DashboardEndpointsOptions>() ?? new DashboardEndpointsOptions();
    var indexPath = DashboardPath.Combine(dashboardOptions.GroupPath, "/");
    var contentPath = QueryHelpers.AddQueryString(DashboardPath.Combine(dashboardOptions.GroupPath, dashboardOptions.EndpointPaths.IndexContent), "group", Model.SelectedGroup);
}

<div class="dashboard-page-toolbar">
  <div class="d-flex align-items-center gap-2">
      @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages.RefreshControls, BridgingIT.DevKit.Presentation.Web.Dashboard.DashboardRefreshModel>(new("dashboard-index", "Refresh dashboard cards", true)))
  </div>
</div>

@if (Model.Groups.Count > 0)
{
    <nav class="nav nav-pills mb-2" aria-label="Overview groups" data-dashboard-view="@Model.SelectedGroup">
        @foreach (var group in Model.Groups)
        {
            var selected = group == Model.SelectedGroup;
            <a class="nav-link @(selected ? "active" : "")" aria-current="@(selected ? "page" : null)" href="@QueryHelpers.AddQueryString(indexPath, "group", group)">@group</a>
        }
    </nav>
}

<section id="dashboard-index-content" aria-label="Overview cards">
    @(await RenderPartialAsync<DashboardIndexContent, DashboardIndexModel>(Model))
</section>

<script>
    (() => {
        window.bdkDashboard.createRefresher({
            contentUrl: '@contentPath',
            contentSelector: '#dashboard-index-content',
            statusSelector: '#dashboard-index-refresh-status',
            intervalSelector: '#dashboard-index-refresh-interval',
            refreshButtonSelector: '#dashboard-index-refresh-now',
            storageKey: 'bdk.dashboard.index.refreshInterval'
        });
    })();
</script>

@functions {
    public DashboardLayoutModel LayoutModel => new() { Title = "Overview" };
}
