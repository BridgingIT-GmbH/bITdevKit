@using BridgingIT.DevKit.Presentation.Web.Dashboard
@inherits RazorSlice<DashboardIndexModel>

@if (Model.Cards.Count == 0)
{
    <div class="alert alert-secondary py-2">
        No dashboard plugin cards are available.
    </div>
}
else
{
    <div class="row g-2">
        @foreach (var card in Model.Cards)
        {
            var featureIcon = DashboardFeatureIcons.GetSvg(card.FeatureKey) ?? DashboardFeatureIcons.GetSvg(card.PageKey);
            <div class="col-12 col-md-6 col-xl-4">
                <a class="card dashboard-overview-card h-100 text-decoration-none text-reset" data-dashboard-feature="@(card.FeatureKey ?? card.Icon)" href="@card.Url">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <div class="min-w-0" style="min-width: 0">
                                <div class="text-muted small">@DisplayValue(card.Subtitle)</div>
                                <h6 class="card-title mb-2">@card.Title</h6>
                                @if (!string.IsNullOrWhiteSpace(card.Value))
                                {
                                    <div class="fs-4 fw-semibold">@card.Value</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(card.Detail))
                                {
                                    <div class="text-muted small text-truncate text-start" title="@card.Detail">@card.Detail</div>
                                }
                            </div>
                            @if (featureIcon is not null)
                            {
                                <span class="dashboard-card-icon flex-shrink-0">@featureIcon</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(card.Icon))
                            {
                                <i class="bi bi-@card.Icon fs-3 dashboard-card-icon" aria-hidden="true"></i>
                            }
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

@functions {
    private static string DisplayValue(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Plugin page" : value;
    }
}
