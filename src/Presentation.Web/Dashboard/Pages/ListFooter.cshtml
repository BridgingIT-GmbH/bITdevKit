@using BridgingIT.DevKit.Presentation.Web.Dashboard
@inherits RazorSlice<DashboardListFooterModel>
<div id="@(Model.Prefix + "-load-more")" class="dashboard-list-footer" data-dashboard-list-footer="@Model.Prefix" data-boundary="@Model.Boundary">
    <button type="button" id="@(Model.Prefix + "-load-more-button")" class="btn btn-outline-secondary btn-sm" data-dashboard-load-more data-next-cursor="@Model.NextCursor" data-next-batch="@Model.NextCursor" disabled="@(!Model.HasMore)">Load more</button>
    @if (Model.Sizes is null || Model.Sizes.Count > 0)
    {
        <select id="@(Model.SelectorId ?? Model.Prefix + "-page-size")" form="@Model.FormId" name="@Model.SizeName" class="form-select form-select-sm" data-dashboard-batch-size aria-label="Rows per load" title="Rows per load">
            @foreach (var size in (Model.Sizes ?? new[] { 10, 25, 50, 100, 200 }).Append(Model.BatchSize).Distinct().Order())
            {
                <option value="@size" selected="@(size == Model.BatchSize)">@size</option>
            }
        </select>
    }
    <span class="small text-muted" role="status" data-dashboard-list-status>@(Model.LoadedCount.HasValue ? $"{Model.LoadedCount} rows loaded" : null)</span>
    <button type="button" class="btn btn-outline-secondary btn-sm" data-dashboard-restart-list hidden>Start new list</button>
</div>
