@using BridgingIT.DevKit.Presentation.Web.Dashboard
@inherits RazorSlice<DashboardRefreshModel>
<span id="@(Model.Prefix + "-refresh-status")" class="text-muted small" role="status">Updated @DateTimeOffset.UtcNow.ToString("HH:mm:ss 'UTC'", CultureInfo.InvariantCulture)</span>
@if (Model.TailId is not null)
{
    <div class="form-check form-switch mb-0"><input id="@Model.TailId" class="form-check-input" type="checkbox" role="switch"><label class="form-check-label small" for="@Model.TailId">Tail</label></div>
}
@if (Model.Intervals)
{
    <select id="@(Model.Prefix + "-refresh-interval")" class="form-select form-select-sm dashboard-refresh-interval" aria-label="Refresh interval">
        <option value="">Off</option>
        <option value="1000">1 sec</option>
        <option value="5000">5 sec</option>
        <option value="15000">15 sec</option>
        <option value="30000">30 sec</option>
    </select>
}
<button id="@(Model.Prefix + "-refresh-now")" type="button" class="btn btn-outline-secondary btn-sm" title="@Model.Label" aria-label="@Model.Label"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
