@using System.Diagnostics
@using System.Reflection
@using System.Runtime
@using System.Runtime.CompilerServices
@using System.Runtime.InteropServices
@using BridgingIT.DevKit.Presentation.Web.Dashboard
@using BridgingIT.DevKit.Presentation.Web.Dashboard.Pages
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Hosting
@inherits RazorSlice
@implements IUsesLayout<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages._DashboardLayout, DashboardLayoutModel>

@{
    var environment = HttpContext.RequestServices.GetService<IHostEnvironment>();
    var cards = CreateCards(environment);
}

@(await RenderPartialAsync<SystemStyles>())

<div class="dashboard-page-toolbar">
    <div class="d-flex align-items-center gap-2">
        <span class="text-muted small" role="status">Updated @DateTimeOffset.UtcNow.ToString("HH:mm:ss 'UTC'", CultureInfo.InvariantCulture)</span>
        <button type="button" class="btn btn-outline-secondary btn-sm" title="Refresh process details" aria-label="Refresh process details" data-system-reload>
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
    </div>
</div>

@(await RenderPartialAsync<SystemViewNavigation, string>("process"))

<div class="dashboard-system-grid" data-system-process>
    @foreach (var card in cards)
    {
        <section class="card dashboard-system-span-6" data-system-process-card="@card.Title.ToLowerInvariant()">
            <div class="card-body p-3">
                <h6 class="card-title">@card.Title</h6>
                <table class="table table-sm align-middle mb-0">
                    <tbody>
                    @foreach (var row in card.Rows)
                    {
                        <tr>
                            <td class="dashboard-system-env-key text-nowrap">@row.Name</td>
                            <td class="text-end">
                                <span class="dashboard-system-env-value" title="@row.Hint">@row.Value</span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

<script>
    document.querySelector('[data-system-reload]')?.addEventListener('click', () => location.reload());
</script>

@functions {
    public DashboardLayoutModel LayoutModel => new() { Title = "System" };

    private static IReadOnlyList<DashboardProcessCardModel> CreateCards(IHostEnvironment environment)
    {
        using var process = Safe(Process.GetCurrentProcess);
        var gcMemory = GC.GetGCMemoryInfo();

        return
        [
            new("Application",
            [
                Row("Name", () => environment?.ApplicationName),
                Row("Version", () => GetVersion(Assembly.GetEntryAssembly())),
                Row("Environment", () => environment?.EnvironmentName),
                Row("Content root", () => environment?.ContentRootPath),
                Row("Base directory", () => AppContext.BaseDirectory),
                Row("DevKit", () => GetVersion(typeof(DashboardEndpointsOptions).Assembly)),
                Row("ASP.NET Core", () => GetVersion(typeof(Microsoft.AspNetCore.Builder.WebApplication).Assembly))
            ]),
            new("Runtime",
            [
                Row("Framework", () => RuntimeInformation.FrameworkDescription),
                Row("Version", () => Environment.Version.ToString()),
                Row("Runtime identifier", () => RuntimeInformation.RuntimeIdentifier),
                Row("Process architecture", () => RuntimeInformation.ProcessArchitecture.ToString()),
                Row("GC mode", () => GCSettings.IsServerGC ? "Server" : "Workstation", "Server GC uses one heap per logical processor."),
                Row("GC latency mode", () => GCSettings.LatencyMode.ToString()),
                Row("Tiered compilation", () => AppContext.GetData("System.Runtime.TieredCompilation")?.ToString() ?? "default"),
                Row("Dynamic code", () => RuntimeFeature.IsDynamicCodeCompiled ? "JIT" : "Native AOT or interpreted"),
                Row("Debugger attached", () => Debugger.IsAttached ? "Yes" : "No")
            ]),
            new("Server",
            [
                Row("Machine", () => Environment.MachineName),
                Row("Operating system", () => RuntimeInformation.OSDescription),
                Row("OS architecture", () => RuntimeInformation.OSArchitecture.ToString()),
                Row("OS version", () => Environment.OSVersion.VersionString),
                Row("Logical processors", () => Environment.ProcessorCount.ToString(CultureInfo.InvariantCulture)),
                Row("Available memory", () => FormatBytes(gcMemory.TotalAvailableMemoryBytes), "Memory available to the runtime, including container limits."),
                Row("System uptime", () => FormatDuration(TimeSpan.FromMilliseconds(Environment.TickCount64))),
                Row("Time zone", () => TimeZoneInfo.Local.Id),
                Row("Culture", () => CultureInfo.CurrentCulture.Name is { Length: > 0 } name ? name : "invariant"),
                Row("User", () => Environment.UserName)
            ]),
            new("Process",
            [
                Row("Name", () => process?.ProcessName),
                Row("PID", () => Environment.ProcessId.ToString(CultureInfo.InvariantCulture)),
                Row("Executable", () => Environment.ProcessPath),
                Row("Started", () => process?.StartTime.ToString("g", CultureInfo.InvariantCulture)),
                Row("Uptime", () => process is null ? null : FormatDuration(DateTime.Now - process.StartTime)),
                Row("CPU time", () => process is null ? null : FormatDuration(process.TotalProcessorTime)),
                Row("Working set", () => process is null ? null : FormatBytes(process.WorkingSet64)),
                Row("Peak working set", () => process is null ? null : FormatBytes(process.PeakWorkingSet64)),
                Row("Private memory", () => process is null ? null : FormatBytes(process.PrivateMemorySize64)),
                Row("Managed heap", () => FormatBytes(gcMemory.HeapSizeBytes)),
                Row("Total allocated", () => FormatBytes(GC.GetTotalAllocatedBytes())),
                Row("Fragmented", () => FormatBytes(gcMemory.FragmentedBytes)),
                Row("GC collections", () => $"{GC.CollectionCount(0)} / {GC.CollectionCount(1)} / {GC.CollectionCount(2)}", "Gen0 / Gen1 / Gen2"),
                Row("Threads", () => process?.Threads.Count.ToString(CultureInfo.InvariantCulture)),
                Row("Handles", () => process?.HandleCount.ToString(CultureInfo.InvariantCulture))
            ])
        ];
    }

    private static DashboardProcessRowModel Row(string name, Func<string> value, string hint = null)
    {
        // some values are not available on every platform or in restricted containers
        var result = Safe(value);

        return new(name, string.IsNullOrEmpty(result) ? "-" : result, hint);
    }

    private static T Safe<T>(Func<T> value)
    {
        try
        {
            return value();
        }
        catch (Exception)
        {
            return default;
        }
    }

    private static string GetVersion(Assembly assembly)
    {
        return assembly?.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
            ?? assembly?.GetName().Version?.ToString();
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double value = bytes;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return $"{value.ToString(unit == 0 ? "0" : "0.##", CultureInfo.InvariantCulture)} {units[unit]}";
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalDays >= 1)
        {
            return $"{(int)duration.TotalDays}d {duration.Hours}h {duration.Minutes}m";
        }

        if (duration.TotalHours >= 1)
        {
            return $"{(int)duration.TotalHours}h {duration.Minutes}m";
        }

        return $"{duration.Minutes}m {duration.Seconds}s";
    }

    private sealed record DashboardProcessCardModel(string Title, IReadOnlyList<DashboardProcessRowModel> Rows);

    private sealed record DashboardProcessRowModel(string Name, string Value, string Hint = null);
}
