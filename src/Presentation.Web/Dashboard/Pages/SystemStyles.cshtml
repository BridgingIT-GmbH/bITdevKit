@inherits RazorSlice

<style>
    .dashboard-system-grid {
        display: grid;
        gap: .75rem;
        grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .dashboard-system-span-3 { grid-column: span 3; }
    .dashboard-system-span-4 { grid-column: span 4; }
    .dashboard-system-span-6 { grid-column: span 6; }
    .dashboard-system-span-8 { grid-column: span 8; }
    .dashboard-system-span-12 { grid-column: span 12; }

    .dashboard-system-kpi {
        min-height: 8.5rem;
    }

    .dashboard-system-label {
        color: var(--bs-secondary-color);
        font-size: .78rem;
        text-transform: uppercase;
    }

    .dashboard-system-value {
        font-size: clamp(1.5rem, 2vw, 2.25rem);
        font-weight: 650;
        line-height: 1.05;
    }

    .dashboard-system-subvalue {
        color: var(--bs-secondary-color);
        font-size: .84rem;
    }

    .dashboard-system-meter {
        background: rgba(var(--bs-secondary-rgb), .14);
        border-radius: 999px;
        height: .55rem;
        overflow: hidden;
    }

    .dashboard-system-meter > span {
        background: var(--bs-primary);
        display: block;
        height: 100%;
        width: var(--meter-value, 0%);
    }

    .dashboard-system-meter-success > span { background: var(--bs-success); }
    .dashboard-system-meter-warning > span { background: var(--bs-warning); }
    .dashboard-system-meter-danger > span { background: var(--bs-danger); }

    .dashboard-system-gauge {
        align-items: center;
        display: grid;
        grid-template-columns: 6.25rem minmax(0, 1fr);
        gap: .75rem;
    }

    .dashboard-system-gauge svg {
        height: 6.25rem;
        width: 6.25rem;
    }

    .dashboard-system-gauge-track {
        fill: none;
        stroke: rgba(var(--bs-secondary-rgb), .18);
        stroke-width: 10;
    }

    .dashboard-system-gauge-value {
        fill: none;
        stroke: var(--bs-primary);
        stroke-linecap: round;
        stroke-width: 10;
        transform: rotate(-90deg);
        transform-origin: 50% 50%;
    }

    .dashboard-system-statusbar {
        display: flex;
        height: .8rem;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(var(--bs-secondary-rgb), .14);
    }

    .dashboard-system-statusbar span {
        width: var(--segment-value, 0%);
    }

    .dashboard-system-chip {
        border: 1px solid var(--bs-border-color);
        border-radius: 999px;
        color: var(--bs-secondary-color);
        display: inline-flex;
        font-size: .8rem;
        gap: .35rem;
        padding: .25rem .5rem;
    }

    .dashboard-system-env-scroll {
        max-height: 28rem;
        overflow: auto;
    }

    .dashboard-system-env-table {
        table-layout: fixed;
    }

    .dashboard-system-env-table th:first-child,
    .dashboard-system-env-table td:first-child {
        width: clamp(16rem, 32%, 30rem);
    }

    .dashboard-system-env-key {
        font-family: var(--bs-font-monospace);
        font-size: .82rem;
        overflow-wrap: anywhere;
    }

    .dashboard-system-env-value {
        font-family: var(--bs-font-monospace);
        font-size: .82rem;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .dashboard-system-env-filter {
        max-width: 22rem;
        min-width: min(16rem, 100%);
    }

    .dashboard-system-db-grid {
        display: grid;
        gap: .75rem;
        grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    }

    .dashboard-system-db-heading {
        align-items: center;
        display: flex;
        gap: .7rem;
    }

    .dashboard-system-db-icon {
        align-items: center;
        background: rgba(var(--bs-primary-rgb), .12);
        border: 1px solid rgba(var(--bs-primary-rgb), .24);
        border-radius: .45rem;
        color: var(--bs-primary);
        display: inline-flex;
        height: 2.15rem;
        justify-content: center;
        width: 2.15rem;
    }

    .dashboard-system-db-summary {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: .45rem;
        justify-content: flex-end;
    }

    .dashboard-system-db-pill {
        align-items: center;
        border: 1px solid var(--bs-border-color);
        border-radius: 999px;
        color: var(--bs-secondary-color);
        display: inline-flex;
        font-size: .78rem;
        gap: .35rem;
        padding: .25rem .55rem;
    }

    .dashboard-system-db-pill strong {
        color: var(--bs-body-color);
        font-weight: 650;
    }

    .dashboard-system-db-context {
        min-width: 0;
        grid-template-columns: minmax(0, 1fr);
        display: grid;
        gap: .65rem;
    }

    .dashboard-system-db-title {
        font-size: 1rem;
        font-weight: 650;
        line-height: 1.15;
    }

    .dashboard-system-db-provider {
        overflow-wrap: anywhere;
        color: var(--bs-secondary-color);
        font-size: .78rem;
        margin-top: .1rem;
    }

    .dashboard-system-db-name {
        color: var(--bs-secondary-color);
        font-size: .82rem;
        overflow-wrap: anywhere;
    }

    .dashboard-system-db-status {
        align-items: center;
        border-radius: 999px;
        display: inline-flex;
        font-size: .74rem;
        font-weight: 650;
        gap: .35rem;
        padding: .27rem .6rem;
        white-space: nowrap;
    }

    .dashboard-system-db-status i {
        font-size: .65rem;
    }

    .dashboard-system-db-metrics {
        display: grid;
        gap: .85rem 1rem;
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .dashboard-system-db-value {
        min-width: 0;
    }

    .dashboard-system-db-value span {
        color: var(--bs-secondary-color);
        display: block;
        font-size: .72rem;
        line-height: 1.1;
    }

    .dashboard-system-db-value strong {
        display: block;
        font-size: .95rem;
        font-weight: 650;
        line-height: 1.25;
        margin-top: .25rem;
        overflow-wrap: anywhere;
    }

    .dashboard-system-db-wide {
        grid-column: span 2;
    }

    .dashboard-system-db-alert {
        border: 1px solid rgba(var(--bs-danger-rgb), .35);
        border-radius: .38rem;
        color: var(--bs-danger);
        font-size: .82rem;
        padding: .55rem .65rem;
    }

    @@media (max-width: 1199.98px) {
        .dashboard-system-span-3,
        .dashboard-system-span-4,
        .dashboard-system-span-6,
        .dashboard-system-span-8 {
            grid-column: span 6;
        }
    }

    @@media (max-width: 767.98px) {
        .dashboard-system-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .dashboard-system-span-3,
        .dashboard-system-span-4,
        .dashboard-system-span-6,
        .dashboard-system-span-8,
        .dashboard-system-span-12 {
            grid-column: span 1;
        }

        .dashboard-system-db-metrics {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 459.98px) {
        .dashboard-system-db-context > .d-flex { flex-wrap: wrap; }
        .dashboard-system-db-context > .d-flex > div { min-width: 0; }
        .dashboard-system-db-summary {
            justify-content: flex-start;
            width: 100%;
        }

    }
</style>
