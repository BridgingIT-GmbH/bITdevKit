    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <style>
        :root {
            --bs-border-radius: .125rem;
            --bs-border-radius-sm: .1rem;
            --bs-border-radius-lg: .2rem;
            --dashboard-sidebar-width: 13.5rem;
            --dashboard-sidebar-collapsed-width: 4.25rem;
        }

        body {
            font-size: .875rem;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
            background: var(--bs-body-bg);
            /* transition: background-color 0.3s ease, color 0.3s ease; */
        }

        [data-dashboard-texture="on"] body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: 1040;
            pointer-events: none;
            background:
                repeating-linear-gradient(
                    to bottom,
                    rgba(var(--dashboard-border-rgb), .055),
                    rgba(var(--dashboard-border-rgb), .055) 1px,
                    transparent 1px,
                    transparent 4px),
                linear-gradient(
                    90deg,
                    rgba(var(--dashboard-border-rgb), .028) 1px,
                    transparent 1px);
            background-size: auto, 48px 48px;
            mix-blend-mode: soft-light;
            opacity: .55;
        }

        [data-dashboard-texture="on"] .navbar,
        [data-dashboard-texture="on"] .sidebar {
            background-image: linear-gradient(rgba(var(--dashboard-border-rgb), .025) 50%, transparent 50%);
            background-size: 100% 4px;
        }

        .feather {
            width: 16px;
            height: 16px;
            vertical-align: text-bottom;
        }

        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
            padding: 48px 0 0;
            width: var(--dashboard-sidebar-width);
            background-color: var(--bs-body-bg);
            border-right: 1px solid var(--bs-border-color);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            /* transition: margin-left 0.3s ease-in-out; */
        }

        .sidebar {
            background-color: var(--dashboard-sidebar-bg);
        }

        .sidebar-sticky {
            position: relative;
            top: 0;
            height: 100%;
            min-height: 0;
            padding: .5rem .35rem 4.5rem;
            overflow-x: hidden;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(var(--bs-secondary-rgb), .45) transparent;
        }

        .sidebar-sticky::-webkit-scrollbar {
            width: .45rem;
        }

        .sidebar-sticky::-webkit-scrollbar-thumb {
            background-color: rgba(var(--bs-secondary-rgb), .45);
            border-radius: 999px;
        }

        .dashboard-sidebar-group {
            padding: .15rem 0;
        }

        .dashboard-sidebar-group + .dashboard-sidebar-group {
            margin-top: .25rem;
            padding-top: .35rem;
        }

        .dashboard-sidebar-group-toggle {
            width: 100%;
            min-height: 1.35rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .5rem;
            padding: .05rem .55rem;
            border: 0;
            background: transparent;
            color: var(--bs-secondary-color);
            font-size: .64rem;
            font-weight: 700;
            letter-spacing: .05em;
            text-transform: uppercase;
            text-align: left;
        }

        .dashboard-sidebar-group-toggle:hover,
        .dashboard-sidebar-group-toggle:focus {
            color: var(--bs-emphasis-color);
        }

        .dashboard-sidebar-group-toggle .bi {
            font-size: .7rem;
            transition: transform .12s ease;
        }

        .dashboard-sidebar-group-toggle[aria-expanded="true"] .bi {
            transform: rotate(90deg);
        }

        .dashboard-sidebar-group-items {
            margin-bottom: .25rem !important;
        }

        .dashboard-sidebar-group-items[hidden] {
