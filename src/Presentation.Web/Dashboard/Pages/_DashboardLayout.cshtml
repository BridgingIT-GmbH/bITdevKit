            font-weight: 700;
            letter-spacing: .02em;
            max-width: min(17rem, 44vw);
            overflow: hidden;
            padding-left: 0 !important;
            padding-right: 0 !important;
            text-align: left;
            text-overflow: ellipsis;
            white-space: nowrap;
            direction: ltr;
        }

        .dashboard-brand-logo {
            width: 2rem;
            height: 2rem;
            flex-shrink: 0;
            fill: var(--dashboard-info-text);
        }

        .dashboard-brand-logo .dashboard-brand-logo-accent {
            fill: var(--dashboard-danger-text);
        }

        .dashboard-brand-name {
            min-width: 0;
            overflow: hidden;
