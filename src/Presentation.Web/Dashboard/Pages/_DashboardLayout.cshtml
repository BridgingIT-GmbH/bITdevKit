            border-color: var(--bs-border-color);
        }

        [data-bs-theme="dark"] .btn-close {
            filter: invert(1) grayscale(100%) brightness(200%);
        }

        .modal-header,
        .modal-footer {
            padding: .55rem .7rem;
            border-color: var(--bs-border-color);
        }

        .modal-body {
            padding: .7rem;
        }

        .nav-tabs {
            border-color: var(--bs-border-color);
        }

        .nav-tabs .nav-link {
            border-radius: 0;
            color: var(--bs-secondary-color);
            padding: .32rem .55rem;
        }

        .nav-tabs .nav-link:hover {
            border-color: transparent;
            color: var(--bs-body-color);
        }

        .nav-tabs .nav-link.active {
            background: transparent;
            border-color: var(--bs-border-color) var(--bs-border-color) var(--bs-body-bg);
        }

        code,
        pre,
        kbd {
            color: var(--bs-code-color);
        }

        pre {
            background: var(--dashboard-code-bg);
            border: 1px solid var(--bs-border-color);
            border-radius: .1rem;
            padding: .55rem;
        }

        a {
            color: var(--bs-link-color);
        }

            a:hover {
                color: var(--bs-link-hover-color);
            }

        .alert-primary {
            --bs-alert-color: var(--dashboard-primary-text);
            --bs-alert-bg: rgba(var(--bs-primary-rgb), 0.1);
            --bs-alert-border-color: rgba(var(--bs-primary-rgb), 0.2);
        }

        .progress {
            --bs-progress-bar-bg: var(--bs-primary);
        }

        .list-group-item.active {
            color: var(--dashboard-selected-fg);
            background-color: var(--dashboard-selected-bg);
            border-color: var(--bs-border-color);
        }

        .nav-tabs .nav-link.active {
            color: var(--dashboard-active-fg);
            background: var(--dashboard-active-bg);
            border-color: var(--bs-primary);
        }
    </style>
</head>

<body>
    @(await RenderPartialAsync<_DashboardDialogs>())
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <div class="dashboard-navbar-heading">
            <a class="navbar-brand me-0 px-3" href="@dashboardHomePath" title="@dashboardTitle" aria-label="@dashboardTitle">
                @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Pages._DashboardLogo>())
                <span class="dashboard-brand-name">@dashboardBrandTitle</span>
            </a>
            <div class="dashboard-navbar-title" title="@pageTitle">@pageTitle</div>
        </div>
        @if (!hideSideBar)
        {
            <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false" aria-label="Toggle navigation" title="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        }

        <div class="navbar-nav">
            <div class="nav-item dashboard-header-actions text-nowrap d-flex align-items-center">
                <span id="dashboard-connection-indicator" class="badge rounded-pill text-bg-warning d-none me-2" title="Dashboard connection issue">
                    <i class="bi bi-wifi-off me-1"></i>Offline
                </span>
                <a class="btn dashboard-header-action dashboard-docs-link" href="https://bridgingit-gmbh.github.io/bITdevKit/" target="_blank" rel="noopener noreferrer" aria-label="Open documentation" title="Documentation">
                    <i class="bi bi-book" aria-hidden="true"></i>
                </a>
                @if (mcpPage is not null)
                {
                    <a class="btn dashboard-header-action dashboard-mcp-toggle @(mcpStatus.IsConnected ? "dashboard-mcp-toggle-connected" : "") @(mcpActive ? "active" : "")"
                       href="@mcpPage.Url"
                       aria-label="@mcpStatus.Title"
                       title="@mcpStatus.Title"
                       data-mcp-status="@mcpStatus.Status"
                       data-mcp-status-url="@mcpStatusPath"
                       aria-current="@(mcpActive ? "page" : null)">
                        <i class="bi bi-robot"></i>
                    </a>
                }
                <button class="btn dashboard-header-action dashboard-window-toggle" type="button" aria-label="Open current dashboard page in a new window" title="Open in new window">
                    <i class="bi bi-box-arrow-up-right"></i>
                </button>
                @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Pages._DashboardThemePicker>())
                <button class="btn dashboard-header-action dashboard-texture-toggle" type="button" aria-label="Toggle terminal texture" aria-pressed="false" title="Toggle terminal texture">
                    <i class="bi bi-grid-3x3-gap"></i>
                </button>
                @if (isAuthenticated)
                {
                    <form method="post" action="@signOutPath" class="m-0">
                        <input type="hidden" name="returnUrl" value="@currentDashboardUrl" />
                        <button class="btn dashboard-header-action dashboard-signout-toggle" type="submit" aria-label="Sign out of dashboard" title="Sign out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                }
            </div>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            @if (!hideSideBar)
            {
                var pageSidebarItems = new List<DashboardSidebarItem>();
                foreach (var page in dashboardPages.Where(page => page.ShowInSidebar))
                {
                    pageSidebarItems.Add(new DashboardSidebarItem(page.Title, page.Icon, page.Url)
                    {
                        Group = page.Group,
                        GroupOrder = page.GroupOrder,
                        Order = page.Order,
                        Tooltip = string.IsNullOrWhiteSpace(page.Tooltip) ? page.Description : page.Tooltip,
                        HasBadge = page.Badge is not null,
                        BadgeCount = page.Badge is null ? null : await page.Badge(HttpContext)
                    });
                }
                var customSidebarItems = HttpContext.RequestServices
                    .GetServices<IDashboardNavigationProvider>()
                    .SelectMany(provider => provider.GetItems(HttpContext))
                    .Where(item => item is not null);
                var sidebarItems = pageSidebarItems
                    .Concat(customSidebarItems)
                    .ToArray();

                @(await RenderPartialAsync<_DashboardSideBar, DashboardSidebarItem[]>(
                    sidebarItems))
                @await RenderSectionAsync("nav-menu")
                <button class="btn sidebar-toggle d-none d-md-flex" type="button" aria-label="Toggle sidebar">
                    <i class="bi bi-layout-sidebar"></i>
                </button>
            }

            <main class="dashboard-main @(hideSideBar ? "dashboard-main-full col-12" : "") px-md-4">
                <div class="@(!hideSideBar ? "container-fluid px-0" : "")">
                    @await RenderBodyAsync()
                </div>
            </main>
        </div>
    </div>

    @(await RenderPartialAsync<DateRangeScript>())
    @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard.Pages.Navigation>())

    <script>
        function setupSidebarToggle() {
            const toggle = document.querySelector('.sidebar-toggle');
            const sidebar = document.querySelector('.sidebar');
            const mainContent = document.querySelector('main');
            if (!toggle || !sidebar || !mainContent) {
                return;
            }

            const icon = toggle.querySelector('i');

            const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
            if (isCollapsed) {
                sidebar.classList.add('sidebar-collapsed');
                mainContent.classList.add('expanded');
                toggle.classList.add('sidebar-toggle-collapsed');
                icon.classList.replace('bi-layout-sidebar', 'bi-layout-sidebar-inset');
            }

            syncSidebarTooltips();

            toggle.addEventListener('click', () => {
                sidebar.classList.toggle('sidebar-collapsed');
                mainContent.classList.toggle('expanded');
                toggle.classList.toggle('sidebar-toggle-collapsed');
                const isNowCollapsed = sidebar.classList.contains('sidebar-collapsed');
                localStorage.setItem('sidebarCollapsed', isNowCollapsed);

                if (isNowCollapsed) {
                    icon.classList.replace('bi-layout-sidebar', 'bi-layout-sidebar-inset');
                } else {
                    icon.classList.replace('bi-layout-sidebar-inset', 'bi-layout-sidebar');
                }

                applySidebarGroupState();
                syncSidebarTooltips();
            });
        }

        function getSidebarGroupState() {
            try {
                return JSON.parse(localStorage.getItem('dashboardSidebarGroups') || '{}') || {};
            } catch {
                return {};
            }
        }

        function setSidebarGroupState(state) {
            localStorage.setItem('dashboardSidebarGroups', JSON.stringify(state || {}));
        }

        function applySidebarGroupState() {
            const sidebar = document.querySelector('.sidebar');
            if (!sidebar) {
                return;
            }

            const state = getSidebarGroupState();
            const sidebarIsCollapsed = sidebar.classList.contains('sidebar-collapsed');

            sidebar.querySelectorAll('[data-sidebar-group]').forEach(group => {
                const key = group.dataset.sidebarGroupKey;
                const toggle = group.querySelector('[data-sidebar-group-toggle]');
                const items = group.querySelector('[data-sidebar-group-items]');
                if (!toggle || !items) {
                    return;
                }

                const expanded = sidebarIsCollapsed || state[key] !== false;
                toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                items.hidden = !expanded;
            });
        }

        function setupSidebarGroups() {
            const sidebar = document.querySelector('.sidebar');
            if (!sidebar) {
                return;
            }

            applySidebarGroupState();

            sidebar.addEventListener('click', event => {
                const toggle = event.target.closest('[data-sidebar-group-toggle]');
                if (!toggle || sidebar.classList.contains('sidebar-collapsed')) {
                    return;
                }

                const group = toggle.closest('[data-sidebar-group]');
                const items = group?.querySelector('[data-sidebar-group-items]');
                if (!group || !items) {
                    return;
                }

                const key = group.dataset.sidebarGroupKey;
                const expanded = toggle.getAttribute('aria-expanded') === 'true';
                const state = getSidebarGroupState();
                state[key] = !expanded;
                setSidebarGroupState(state);
                applySidebarGroupState();
            });
        }

        function setupTooltips() {
            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(element => {
                bootstrap.Tooltip.getOrCreateInstance(element, {
                    trigger: 'hover focus',
                    container: 'body'
                });
            });
            document.querySelectorAll('header .dashboard-header-action, header .navbar-toggler').forEach(element => {
                const tooltip = bootstrap.Tooltip.getOrCreateInstance(element, {
                    trigger: 'hover focus',
                    container: 'body',
                    placement: 'bottom',
                    customClass: 'dashboard-header-tooltip',
                    title: () => element.getAttribute('data-bs-original-title') || element.getAttribute('title')
                });
                element.addEventListener('click', () => tooltip.hide());
            });
            syncSidebarTooltips();
        }

        function setupTextureToggle() {
            const toggle = document.querySelector('.dashboard-texture-toggle');
            if (!toggle) {
                return;
            }

            window.bdkTheme.applyTexture(window.bdkTheme.getCurrentTexture(), false);
            toggle.addEventListener('click', () => {
                window.bdkTheme.applyTexture(document.documentElement.getAttribute('data-dashboard-texture') !== 'on');
            });
        }

        function setupDashboardWindowToggle() {
            const toggle = document.querySelector('.dashboard-window-toggle');
            if (!toggle) {
                return;
            }

            toggle.addEventListener('click', () => {
                const url = new URL(window.location.href);
                url.searchParams.set('dashboardView', 'window');
                const popup = window.open(
                    url.toString(),
                    '_blank',
                    'popup=yes,width=1280,height=900,resizable=yes,scrollbars=yes,noopener'
                );
                popup?.focus();
            });
        }

        function setupMcpStatusToggle() {
            const toggle = document.querySelector('.dashboard-mcp-toggle[data-mcp-status-url]');
            if (!toggle) {
                return;
            }

            const refreshIntervalMs = 10000;
            const apply = state => {
                toggle.classList.toggle('dashboard-mcp-toggle-connected', state.connected === true);
                toggle.dataset.mcpStatus = state.status;
                toggle.title = state.title;
                toggle.setAttribute('data-bs-original-title', state.title);
                toggle.setAttribute('aria-label', state.title);
            };
            const refresh = async () => {
                if (document.hidden) {
                    return;
                }

                try {
                    const response = await fetch(toggle.dataset.mcpStatusUrl, { cache: 'no-store', headers: { 'X-Requested-With': 'fetch' } });
                    if (response.ok) {
                        apply(await response.json());
                    }
                } catch {
                    // keep the last known state when the status request fails
                }
            };

            window.setInterval(refresh, refreshIntervalMs);
            document.addEventListener('visibilitychange', refresh);
        }

        function setupDashboardDatePickers() {
            document.addEventListener('click', event => {
                const button = event.target.closest('[data-dashboard-date-picker-button]');
                if (!button) {
                    return;
                }

                const targetId = button.getAttribute('data-dashboard-date-picker-button');
                const input = (targetId ? document.getElementById(targetId) : null)
                    || button.closest('.input-group')?.querySelector('input[type="date"], input[type="datetime-local"]');
                if (!input) {
                    return;
                }

                if (typeof input.showPicker === 'function') {
                    input.showPicker();
                    return;
                }

                input.focus();
            });
        }

        function syncSidebarTooltips() {
            const sidebar = document.querySelector('.sidebar');
            if (!sidebar) {
                return;
            }

            const enabled = sidebar.classList.contains('sidebar-collapsed');
            sidebar.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(element => {
                const tooltip = bootstrap.Tooltip.getOrCreateInstance(element, {
                    trigger: 'hover focus',
                    container: 'body'
                });

                if (enabled) {
                    tooltip.enable();
                } else {
                    tooltip.hide();
                    tooltip.disable();
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            window.bdkTheme.initialize();
            setupTextureToggle();
            setupDashboardWindowToggle();
            setupMcpStatusToggle();
            setupDashboardDatePickers();
            setupSidebarToggle();
            setupSidebarGroups();
            setupTooltips();
            window.bdkDashboard.updateConnectionIndicator();
        });
    </script>
</body>
</html>
