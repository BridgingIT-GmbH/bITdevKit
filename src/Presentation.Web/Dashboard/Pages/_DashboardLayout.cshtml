@using BridgingIT.DevKit.Presentation.Web.Dashboard
@using BridgingIT.DevKit.Presentation.Web.Dashboard.Pages
@using Microsoft.Extensions.DependencyInjection
@inherits RazorLayoutSlice<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages.DashboardLayoutModel>

@{
    var dashboardOptions = HttpContext.RequestServices.GetService<DashboardEndpointsOptions>() ?? new DashboardEndpointsOptions();
    var dashboardTitle = string.IsNullOrWhiteSpace(Model.ProductName) ? dashboardOptions.Title : Model.ProductName;
    var dashboardBrandTitle = string.Equals(dashboardTitle, "BDK", StringComparison.OrdinalIgnoreCase)
        ? string.Empty
        : dashboardTitle?.StartsWith("BDK ", StringComparison.OrdinalIgnoreCase) == true ? dashboardTitle[4..] : dashboardTitle;
    var dashboardLogoUrl = "data:image/svg+xml;base64,";
    var pageTitle = string.IsNullOrWhiteSpace(Model.Title) ? dashboardTitle : Model.Title;
    var detachedView = string.Equals(HttpContext.Request.Query["dashboardView"].ToString(), "window", StringComparison.OrdinalIgnoreCase);
    var hideSideBar = Model.HideSideBar || detachedView;
    var isAuthenticated = HttpContext.User.Identity?.IsAuthenticated == true;
    var signOutPath = DashboardPath.Combine(dashboardOptions.GroupPath, dashboardOptions.EndpointPaths.SignOut);
    var dashboardHomePath = DashboardPath.Combine(HttpContext.Request.PathBase, dashboardOptions.GroupPath);
    var currentDashboardUrl = $"{HttpContext.Request.PathBase}{HttpContext.Request.Path}{HttpContext.Request.QueryString}";
    IReadOnlyList<DashboardPage> dashboardPages = hideSideBar ? [] : HttpContext.GetDashboardPages();
    var mcpPage = dashboardPages.FirstOrDefault(page => string.Equals(page.Key, "mcp", StringComparison.OrdinalIgnoreCase));
    var mcpStatus = mcpPage is null ? null : BridgingIT.DevKit.Presentation.Web.ConsoleCommands.Dashboard.McpDashboardStatus.Get(HttpContext.RequestServices);
    var mcpStatusPath = BridgingIT.DevKit.Presentation.Web.ConsoleCommands.Dashboard.McpDashboardEndpoints.BuildMcpStatusPath(dashboardOptions);
    var mcpActive = mcpPage is not null && HttpContext.Request.Path.Value?.TrimEnd('/').StartsWith(mcpPage.Url.Split('?')[0].TrimEnd('/'), StringComparison.OrdinalIgnoreCase) == true;
}

<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@dashboardTitle - @pageTitle</title>
    <base href="/" />
    <script>
        window.bdkDashboard = window.bdkDashboard || {};
        window.bdkDashboard.refreshErrors = window.bdkDashboard.refreshErrors || new Set();
        window.bdkDashboard.updateConnectionIndicator = function() {
            const indicator = document.getElementById('dashboard-connection-indicator');
            if (!indicator) {
                return;
            }

            const hasErrors = window.bdkDashboard.refreshErrors.size > 0;
            indicator.classList.toggle('d-none', !hasErrors);
        };
        window.bdkDashboard.showRefreshError = function(contentElement, message) {
            if (contentElement === null || contentElement === undefined) {
                return;
            }

            const id = `${contentElement.id || 'dashboard-content'}-refresh-error`;
            window.bdkDashboard.refreshErrors.add(id);
            window.bdkDashboard.updateConnectionIndicator();
        };

        window.bdkDashboard.clearRefreshError = function(contentElement) {
            if (contentElement === null || contentElement === undefined) {
                return;
            }

            window.bdkDashboard.refreshErrors.delete(`${contentElement.id || 'dashboard-content'}-refresh-error`);
            window.bdkDashboard.updateConnectionIndicator();
        };

        window.bdkDashboard.assets = window.bdkDashboard.assets || {
            plotly: 'https://cdn.plot.ly/plotly-2.35.2.min.js'
        };

        window.bdkDashboard.loadedScripts = window.bdkDashboard.loadedScripts || {};
        window.bdkDashboard.loadScriptOnce = function(key, src) {
            if (window.bdkDashboard.loadedScripts[key]) {
                return window.bdkDashboard.loadedScripts[key];
            }

            window.bdkDashboard.loadedScripts[key] = new Promise((resolve, reject) => {
                const existing = document.querySelector(`script[data-bdk-script="${key}"]`);
                if (existing) {
                    existing.addEventListener('load', () => resolve(existing), { once: true });
                    existing.addEventListener('error', () => reject(new Error(`Failed to load ${src}.`)), { once: true });
                    return;
                }

                const script = document.createElement('script');
                script.src = src;
                script.async = true;
                script.dataset.bdkScript = key;
                script.onload = () => resolve(script);
                script.onerror = () => reject(new Error(`Failed to load ${src}.`));
                document.head.appendChild(script);
            });

            return window.bdkDashboard.loadedScripts[key];
        };

        window.bdkDashboard.loadPlotly = async function() {
            if (window.Plotly) {
                return window.Plotly;
            }

            await window.bdkDashboard.loadScriptOnce('plotly', window.bdkDashboard.assets.plotly);
            return window.Plotly;
        };

        window.bdkDashboard.getCssValue = function(name, fallback) {
            const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
            return value || fallback;
        };

        window.bdkDashboard.getChartTheme = function() {
            const css = window.bdkDashboard.getCssValue;
            return {
                background: css('--bs-body-bg'),
                text: css('--bs-body-color'),
                muted: css('--bs-secondary-color'),
                grid: css('--dashboard-panel-border'),
                primary: css('--bs-primary'),
                secondary: css('--dashboard-palette-magenta'),
                success: css('--bs-success'),
                info: css('--bs-info'),
                warning: css('--bs-warning'),
                danger: css('--bs-danger'),
                accent: css('--dashboard-palette-accent'),
                quiet: css('--bs-secondary-color')
            };
        };

        window.bdkDashboard.applySeriesColors = function(root = document) {
            const elements = [...root.querySelectorAll('[data-dashboard-series-key]')];
            if (root.matches?.('[data-dashboard-series-key]')) elements.unshift(root);
            for (const element of elements) {
                let hash = 0;
                for (const character of element.dataset.dashboardSeriesKey.toUpperCase()) hash = ((hash * 31) + character.codePointAt(0)) >>> 0;
                const series = hash % 8 + 1;
                element.style.setProperty('--dashboard-kind-color', `var(--dashboard-series-${series})`);
                element.style.setProperty('--dashboard-kind-text', `var(--dashboard-series-${series}-text)`);
            }
        };
        document.addEventListener('DOMContentLoaded', () => window.bdkDashboard.applySeriesColors());

        window.bdkDashboard.createPlotlyLayout = function(options) {
            const settings = options || {};
            const theme = window.bdkDashboard.getChartTheme();

            return {
                margin: settings.margin || { l: 36, r: 16, t: 16, b: 28 },
                paper_bgcolor: 'rgba(0,0,0,0)',
                plot_bgcolor: 'rgba(0,0,0,0)',
                font: { color: theme.muted, size: 11 },
                hovermode: 'x unified',
                hoverlabel: {
                    bgcolor: theme.background,
                    bordercolor: theme.grid,
                    font: { color: theme.text },
                    namelength: -1
                },
                xaxis: {
                    hoverformat: '%Y-%m-%d %H:%M:%S',
                    showgrid: settings.xGrid === true,
                    zeroline: false,
                    gridcolor: theme.grid,
                    color: theme.muted
                },
                yaxis: {
                    rangemode: 'tozero',
                    showgrid: settings.yGrid !== false,
                    gridcolor: theme.grid,
                    zeroline: false,
                    color: theme.muted
                },
                legend: settings.legend || { orientation: 'h', x: 0, y: -0.2 },
                showlegend: settings.showlegend,
                dragmode: false
            };
        };

        window.bdkDashboard.appendCorrelationLink = function(container, value, logsPath) {
            if (!value) { container.textContent = '—'; return; }
            const identifier = String(value);
            const url = new URL(logsPath, location.origin);
            url.searchParams.set('level', 'All');
            url.searchParams.set('pageSize', '100');
            url.searchParams.set('from', new Date().toISOString().slice(0, 10));
            url.searchParams.set('correlationId', identifier);
            const wrapper = document.createElement('span');
            wrapper.className = 'd-inline-flex align-items-center gap-1 mw-100';
            wrapper.setAttribute('data-dashboard-correlation', '');
            const link = document.createElement('a');
            link.className = 'text-break text-decoration-none';
            link.href = url.toString();
            link.textContent = identifier;
            link.title = 'Show logs for correlation ' + identifier;
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'btn btn-link btn-sm p-0 text-muted flex-shrink-0';
            button.dataset.dashboardCopy = identifier;
            button.title = 'Copy correlation ID';
            button.setAttribute('aria-label', button.title);
            const icon = document.createElement('i');
            icon.className = 'bi bi-copy';
            icon.setAttribute('aria-hidden', 'true');
            button.append(icon);
            wrapper.append(link, button);
            container.append(wrapper);
        };
        document.addEventListener('click', async event => {
            const button = event.target.closest('[data-dashboard-copy]');
            if (!button) return;
            let copied = false;
            try { await navigator.clipboard.writeText(button.dataset.dashboardCopy); copied = true; }
            catch {
                const input = document.createElement('textarea');
                input.value = button.dataset.dashboardCopy;
                input.style.cssText = 'position:fixed;left:-9999px;top:0';
                document.body.append(input);
                input.select();
                try { copied = document.execCommand('copy'); } catch { }
                input.remove();
                button.focus();
            }
            button.title = copied ? 'Copied' : 'Copy failed';
            button.setAttribute('aria-label', copied ? 'Correlation ID copied' : 'Copy correlation ID failed');
            const icon = button.querySelector('i');
            if (icon) icon.className = copied ? 'bi bi-check2' : 'bi bi-copy';
            clearTimeout(button.copyFeedbackTimeout);
            button.copyFeedbackTimeout = setTimeout(() => {
                button.title = 'Copy correlation ID';
                button.setAttribute('aria-label', button.title);
                if (icon) icon.className = 'bi bi-copy';
            }, 1500);
        });
        window.bdkDashboard.resolveElement = function(value) {
            if (typeof value === 'function') {
                return value();
            }

            if (typeof value === 'string') {
                return document.querySelector(value);
            }

            return value || null;
        };

        window.bdkDashboard.createRefresher = function(options) {
            const settings = options || {};
            const selectElement = window.bdkDashboard.resolveElement(settings.intervalSelector || settings.intervalElement);
            const statusElement = window.bdkDashboard.resolveElement(settings.statusSelector || settings.statusElement);
            const refreshButton = window.bdkDashboard.resolveElement(settings.refreshButtonSelector || settings.refreshButton);
            const cacheBust = settings.cacheBust !== false;

            let timeoutId = null;
            let abortController = null;
            let inFlight = null;
            let pendingRefresh = false;
            let generation = 0;

            function getContentElement() {
                return window.bdkDashboard.resolveElement(settings.contentSelector || settings.contentElement);
            }

            function getSelectedInterval() {
                if (!selectElement) {
                    return null;
                }

                const value = Number(selectElement.value);
                return Number.isFinite(value) && value > 0 ? value : null;
            }

            function setStatus(text, isError) {
                if (!statusElement) {
                    return;
                }

                statusElement.textContent = text;
                statusElement.classList.toggle('text-danger', isError === true);
                statusElement.classList.toggle('text-muted', isError !== true);
            }

            function clearScheduledRefresh() {
                if (timeoutId !== null) {
                    window.clearTimeout(timeoutId);
                    timeoutId = null;
                }
            }

            function buildUrl() {
                const rawUrl = typeof settings.buildUrl === 'function'
                    ? settings.buildUrl()
                    : settings.contentUrl;

                const url = rawUrl instanceof URL
                    ? rawUrl
                    : new URL(rawUrl, window.location.origin);

                if (cacheBust) {
                    url.searchParams.set('_', Date.now().toString());
                }

                return url.toString();
            }

            function restoreActiveTab(contentElement, activeTabTarget) {
                if (!settings.preserveActiveTab || activeTabTarget === null || activeTabTarget === undefined) {
                    return;
                }

                const activeTab = contentElement.querySelector(`[data-bs-target="${activeTabTarget}"]`);
                if (activeTab !== null && window.bootstrap !== undefined) {
                    window.bootstrap.Tab.getOrCreateInstance(activeTab).show();
                }
            }

            function scheduleNextRefresh() {
                clearScheduledRefresh();
                const interval = getSelectedInterval();
                if (interval === null || document.hidden) {
                    return;
                }

                timeoutId = window.setTimeout(() => refresh(true), interval);
            }

            function cancel() {
                clearScheduledRefresh();
                generation++;
                pendingRefresh = false;
                abortController?.abort();
            }

            function refresh(scheduleAfter = true) {
                clearScheduledRefresh();
                if (document.hidden || (typeof settings.shouldRefresh === 'function' && settings.shouldRefresh() === false)) {
                    if (scheduleAfter) scheduleNextRefresh();
                    return Promise.resolve();
                }
                if (inFlight !== null) {
                    pendingRefresh = true;
                    generation++;
                    abortController?.abort();
                    return inFlight;
                }
                const contentElement = getContentElement();
                if (!contentElement) return Promise.resolve();
                const ownController = new AbortController();
                abortController = ownController;
                const version = ++generation;
                inFlight = Promise.resolve().then(async () => {
                    try {
                        const activeTabTarget = settings.preserveActiveTab
                            ? contentElement.querySelector('.nav-link.active')?.getAttribute('data-bs-target') : null;
                        const details = new Map([...contentElement.querySelectorAll('details[data-preserve-key]')].map(value => [value.dataset.preserveKey, value.open]));
                        const scrollPosition = { x: window.scrollX, y: window.scrollY };
                        const response = await fetch(buildUrl(), { cache: 'no-store', headers: { 'X-Requested-With': 'fetch' }, signal: ownController.signal });
                        if (!response.ok) throw new Error(`HTTP ${response.status}`);
                        const responseText = await response.text();
                        if (version !== generation || ownController.signal.aborted) return;
                        if (typeof settings.applyResponse === 'function') await settings.applyResponse(contentElement, responseText);
                        else contentElement.innerHTML = responseText;
                        restoreActiveTab(contentElement, activeTabTarget);
                        contentElement.querySelectorAll('details[data-preserve-key]').forEach(value => { if (details.has(value.dataset.preserveKey)) value.open = details.get(value.dataset.preserveKey); });
                        window.scrollTo(scrollPosition.x, scrollPosition.y);
                        if (typeof settings.onSuccess === 'function') await settings.onSuccess(contentElement);
                        if (version !== generation || ownController.signal.aborted) return;
                        window.bdkDashboard.clearRefreshError(contentElement);
                        const updatedAt = new Date();
                        setStatus(typeof settings.formatUpdatedAt === 'function' ? settings.formatUpdatedAt(updatedAt) : `Updated ${updatedAt.toISOString()} UTC`, false);
                    } catch (error) {
                        if (error.name !== 'AbortError' && version === generation) {
                            window.bdkDashboard.showRefreshError(contentElement);
                            setStatus(settings.errorText || 'Refresh failed; displayed data is stale', true);
                        }
                    } finally {
                        if (abortController === ownController) abortController = null;
                        inFlight = null;
                        if (pendingRefresh && !document.hidden) {
                            pendingRefresh = false;
                            refresh(scheduleAfter);
                        } else if (scheduleAfter && version === generation) scheduleNextRefresh();
                    }
                });
                return inFlight;
            }

            if (selectElement && settings.storageKey) {
                const savedInterval = localStorage.getItem(settings.storageKey);
                if (savedInterval !== null) {
                    selectElement.value = savedInterval;
                }

                selectElement.addEventListener('change', () => {
                    localStorage.setItem(settings.storageKey, selectElement.value);

                    cancel();
                    scheduleNextRefresh();
                });
            }

            if (refreshButton) {
                refreshButton.addEventListener('click', () => refresh(true));
            }

            document.addEventListener('visibilitychange', () => {
                if (document.hidden) {
                    cancel();
                    return;
                }

                if (getSelectedInterval() !== null) {
                    refresh(true);
                }
            });

            scheduleNextRefresh();

            return {
                refresh,
                schedule: scheduleNextRefresh,
                clear: clearScheduledRefresh,
                cancel,
                getSelectedInterval
            };
        };

        window.bdkDashboard.postAction = async function(url, options) {
            const settings = options || {};
            const button = settings.button || document.activeElement;
            if (button) {
                button.disabled = true;
            }

            try {
                const response = await fetch(url, {
                    method: settings.method || 'POST',
                    headers: { 'X-Requested-With': 'fetch' }
                });

                if (!response.ok) {
                    console.error(settings.errorMessage || 'Dashboard action failed:', await response.text().catch(() => response.statusText));
                }
            } catch (error) {
                console.error(settings.errorMessage || 'Dashboard action error:', error);
            } finally {
                if (button) {
                    button.disabled = false;
                }

                if (settings.refresh) {
                    await settings.refresh(true);
                }
            }
        };
    </script>
    @* Favicon source: docs/assets/bITDevKit_Icon.svg *@
