@using BridgingIT.DevKit.Presentation.Web.IdentityProvider.Pages
@using BridgingIT.DevKit.Presentation.Web.Dashboard.Pages
@using RazorSlices
@inherits RazorSlice<SigninViewModel>
@implements IUsesLayout<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages._DashboardLayout, DashboardLayoutModel>

@{
    var client = Model.Options?.Clients?.FirstOrDefault(c => c.ClientId == Model.Request.ClientId);
    var isValidRedirectUri = client?.RedirectUris?.Contains(Model.Request.RedirectUri) ?? false;
    var showUserCards = Model.Options.EnableUserCards && Model.Options?.Users?.Where(u => u.IsEnabled).Any() == true;
    var showManualLogin = Model.Options.EnableLoginCard;
    var workspaceClass = showUserCards && showManualLogin ? "identity-workspace" : "identity-workspace identity-workspace-single";
}

@(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.IdentityProvider.Pages._SigninStyles>())

<section class="identity-signin">
    <header class="identity-page-header">
        <h1 class="identity-page-title">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            Sign in
        </h1>
        <div class="identity-page-tools">
            <button type="button"
                    class="identity-icon-button"
                    onclick="openConfiguration()"
                    aria-label="Open OpenID configuration"
                    title="OpenID configuration"
                    data-bs-toggle="tooltip">
                <i class="bi bi-gear" aria-hidden="true"></i>
            </button>
            <button type="button"
                    class="identity-icon-button"
                    onclick="openDebugInfo()"
                    aria-label="Open identity provider debug information"
                    title="Debug information"
                    data-bs-toggle="tooltip">
                <i class="bi bi-bug" aria-hidden="true"></i>
            </button>
        </div>
    </header>

    @if (showUserCards || showManualLogin)
    {
        <div class="@workspaceClass">
            @if (showUserCards)
            {
                <section class="identity-panel" aria-labelledby="identity-users-heading">
                    <header class="identity-panel-header">
                        <h2 id="identity-users-heading" class="identity-panel-title">
                            <i class="bi bi-people" aria-hidden="true"></i>
                            Available identities
                        </h2>
                    </header>
                    <div class="identity-panel-body">
                        <div class="identity-user-grid">
                            @foreach (var user in Model.Options.Users.Where(u => u.IsEnabled))
                            {
                                <button type="button"
                                        class="identity-user-option"
                                        data-identity-user
                                        data-email="@user.Email"
                                        data-password="@user.Password"
                                        aria-label="Sign in as @user.Name">
                                    <span class="identity-user-icon" aria-hidden="true">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <span>
                                        <strong class="identity-user-name">@user.Name</strong>
                                        <span class="identity-user-email">@user.Email</span>
                                        <span class="identity-user-roles">
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="badge">@role</span>
                                            }
                                        </span>
                                    </span>
                                    <i class="identity-user-arrow bi bi-arrow-right" aria-hidden="true"></i>
                                </button>
                            }
                        </div>
                    </div>
                </section>
            }

            @if (showManualLogin)
            {
                <section class="identity-panel" aria-labelledby="identity-login-heading">
                    <header class="identity-panel-header">
                        <h2 id="identity-login-heading" class="identity-panel-title">
                            <i class="bi bi-terminal" aria-hidden="true"></i>
                            Manual login
                        </h2>
                    </header>
                    <div class="identity-panel-body">
                        <form class="identity-login-form" onsubmit="submitLogin(event)">
                            <div>
                                <label class="identity-form-label" for="username">Email</label>
                                <input type="email"
                                       class="identity-form-control"
                                       id="username"
                                       name="username"
                                       autocomplete="username"
                                       placeholder="developer@example.com"
                                       required>
                            </div>
                            <div>
                                <label class="identity-form-label" for="password">Password</label>
                                <input type="password"
                                       class="identity-form-control"
                                       id="password"
                                       name="password"
                                       autocomplete="current-password"
                                       placeholder="Optional">
                            </div>
                            <button type="submit" class="identity-login-button">
                                <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>
                                Sign in
                            </button>
                        </form>
                    </div>
                </section>
            }
        </div>
    }

    <div class="identity-client-context">
        @if (client != null)
        {
            <section class="identity-client-panel" aria-label="Authorization client">
                <span class="identity-client-icon" aria-hidden="true">
                    <i class="bi bi-window-stack"></i>
                </span>
                <div class="identity-client-copy">
                    <span class="identity-field-label">Client</span>
                    <strong class="identity-client-name">@client.Name</strong>
                    <span class="identity-client-id">@client.ClientId</span>
                </div>
                <span class="identity-provider-tag">@Model.Options.TokenProvider</span>
            </section>

            @if (!isValidRedirectUri)
            {
                <div class="identity-alert" role="alert">
                    <div class="identity-alert-title">
                        <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                        Invalid redirect URI
                    </div>
                    <code>@Model.Request.RedirectUri</code>
                    <div class="mt-2">Configured URIs:</div>
                    <ul>
                        @foreach (var uri in client.RedirectUris)
                        {
                            <li><code>@uri</code></li>
                        }
                    </ul>
                </div>
            }
        }
        else
        {
            <div class="identity-alert" role="alert">
                <div class="identity-alert-title">
                    <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                    Invalid client
                </div>
                <code>@Model.Request.ClientId</code>
            </div>
        }
    </div>
</section>

<script>
    function openConfiguration() {
        window.open('/@Model.Options.GroupPath.Trim('/')/@Model.Options.EndpointPaths.WellKnownConfiguration?.Trim('/')', '_blank');
    }

    function openDebugInfo() {
        window.open('/@Model.Options.GroupPath.Trim('/')/@Model.Options.EndpointPaths.DebugInfo?.Trim('/')', '_blank');
    }

    function selectUser(email, password) {
        const params = new URLSearchParams(window.location.search);
        params.append('email', email);
        params.append('password', password || '');
        window.location.href = '/@Model.Options.GroupPath.Trim('/')/@Model.Options.EndpointPaths.AuthorizeCallback?.Trim('/')?' + params.toString();
    }

    function submitLogin(event) {
        event.preventDefault();
        const username = document.getElementById('username').value;
        const password = document.getElementById('password').value;
        selectUser(username, password);
    }

    document.querySelectorAll('[data-identity-user]').forEach(user => {
        user.addEventListener('click', () => selectUser(user.dataset.email, user.dataset.password));
    });
</script>

@functions {
    public DashboardLayoutModel LayoutModel => new()
    {
        ProductName = "BDK Identity Provider",
        Title = "Sign in",
        HideSideBar = true
    };
}
