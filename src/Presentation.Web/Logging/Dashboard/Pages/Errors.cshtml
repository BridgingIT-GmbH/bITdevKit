@using System.Globalization
@using BridgingIT.DevKit.Presentation.Web.Dashboard
@using BridgingIT.DevKit.Presentation.Web.Dashboard.Pages
@using BridgingIT.DevKit.Presentation.Web.Logging.Dashboard
@using Microsoft.Extensions.DependencyInjection
@using RazorSlices
@inherits RazorSlice
@implements IUsesLayout<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages._DashboardLayout, DashboardLayoutModel>

@{
    var dashboardOptions = HttpContext.RequestServices.GetService<DashboardEndpointsOptions>() ?? new DashboardEndpointsOptions();
    var contentPath = BridgingIT.DevKit.Presentation.Web.Logging.Dashboard.DashboardEndpoints.BuildErrorsContentPath(dashboardOptions);
    var purgePath = BridgingIT.DevKit.Presentation.Web.Logging.Dashboard.DashboardEndpoints.BuildLogEntriesPurgePath(dashboardOptions);
    var filter = LogEntriesDashboard.CreateFilter(HttpContext);
}

<div class="dashboard-page-toolbar">
    <div class="d-flex flex-wrap justify-content-end align-items-center gap-2">
        <div class="form-check form-switch m-0">
            <input id="dashboard-errors-tail" class="form-check-input" type="checkbox" role="switch">
            <label class="form-check-label small" for="dashboard-errors-tail">Tail</label>
        </div>
        <span id="dashboard-errors-refresh-status" class="text-muted small">Updated @DateTimeOffset.UtcNow.ToString("HH:mm:ss 'UTC'", CultureInfo.InvariantCulture)</span>

        <button type="button" id="dashboard-errors-refresh-now" class="btn btn-outline-secondary btn-sm" title="Refresh errors" aria-label="Refresh errors">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
        <details class="dashboard-tools"><summary class="btn btn-outline-secondary btn-sm">Tools</summary><div class="dashboard-tools-menu">        <button type="button" id="dashboard-errors-purge" class="btn btn-outline-danger btn-sm" title="Purge log entries" aria-label="Purge log entries">
            <i class="bi bi-trash3" aria-hidden="true"></i>
        </button>
</div></details>
    </div>
</div>

<form id="dashboard-errors-filter-form" class="card mb-2 dashboard-filter-panel" method="get">
    <div class="card-body p-3">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-lg-4">
                <label class="form-label small" for="dashboard-errors-q">Search</label>
                <input id="dashboard-errors-q" name="q" value="@filter.SearchText" class="form-control form-control-sm" placeholder="message, exception, trace, span, correlation, module">
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label small" for="dashboard-errors-from">From UTC</label>
                <div class="input-group input-group-sm">
                    @(await RenderPartialAsync<DateRange, DashboardDateRangeModel>(new("dashboard-errors-from", "dashboard-errors-to")))
                    <input id="dashboard-errors-from" name="from" type="datetime-local" step="60" value="@DashboardDateTime.FormatInput(filter.StartTime)" class="form-control form-control-sm" data-dashboard-date-picker>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label small" for="dashboard-errors-to">To UTC</label>
                <div class="input-group input-group-sm">
                    <input id="dashboard-errors-to" name="to" type="datetime-local" step="60" value="@DashboardDateTime.FormatInput(filter.EndTime)" class="form-control form-control-sm" data-dashboard-date-picker>
                </div>
            </div>
            <div class="col-12 col-lg-auto d-flex ms-auto">
                @(await RenderPartialAsync<FilterActions, DashboardFilterActionsModel>(new(ResetId: "dashboard-errors-reset")))
            </div>
        </div>
        <div class="row g-2 mt-1">
            <div class="col-6 col-lg-2"><label class="form-label small" for="errors-correlationId">Correlation ID</label><input id="errors-correlationId" name="correlationId" value="@filter.CorrelationId" class="form-control form-control-sm" placeholder="CorrelationId"></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="errors-traceId">Trace ID</label><input id="errors-traceId" name="traceId" value="@filter.TraceId" class="form-control form-control-sm" placeholder="TraceId"></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="errors-spanId">Span ID</label><input id="errors-spanId" name="spanId" value="@filter.SpanId" class="form-control form-control-sm" placeholder="SpanId"></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="errors-logKey">Log key</label><input id="errors-logKey" name="logKey" value="@filter.LogKey" class="form-control form-control-sm" placeholder="LogKey"></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="errors-moduleName">Module</label><input id="errors-moduleName" name="moduleName" value="@filter.ModuleName" class="form-control form-control-sm" placeholder="ModuleName"></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="errors-shortTypeName">Type</label><input id="errors-shortTypeName" name="shortTypeName" value="@filter.ShortTypeName" class="form-control form-control-sm" placeholder="ShortTypeName"></div>
        </div>
    </div>
</form>

<div id="dashboard-errors-content">
    @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Logging.Dashboard.Pages.ErrorsContent>())
</div>

<script>
    (() => {
        const contentUrl = '@contentPath';
        const contentElement = document.getElementById('dashboard-errors-content');
        const formElement = document.getElementById('dashboard-errors-filter-form');
        const resetElement = document.getElementById('dashboard-errors-reset');
        const statusElement = document.getElementById('dashboard-errors-refresh-status');
        const refreshButton = document.getElementById('dashboard-errors-refresh-now');
        const purgeButton = document.getElementById('dashboard-errors-purge');
        const tailElement = document.getElementById('dashboard-errors-tail');

        let tailTimeoutId = null;
        let appendedHistory = false;
        let abortController = null;

        let appliedQuery = null;
        function formQuery() { return new URLSearchParams(appliedQuery ?? draftQuery()); }
        function draftQuery() {
            const data = new FormData(formElement);
            const query = new URLSearchParams();
            for (const [key, value] of data.entries()) {
                if (value !== null && value.toString().trim() !== '') {
                    const text = value.toString().trim();
                    query.set(key, (key === 'from' || key === 'to') ? text + 'Z' : text);
                }
            }

            return query;
        }

        function setStatus(text, isError) {
            statusElement.textContent = text;
            statusElement.classList.toggle('text-danger', isError === true);
            statusElement.classList.toggle('text-muted', isError !== true);
        }

        function updatePageUrl(query) {
            const url = new URL(window.location.href);
            const view = url.searchParams.get('dashboardView');
            url.search = query.toString();
            if (view) url.searchParams.set('dashboardView', view);
            window.history.replaceState(null, '', url.toString());
        }

        function utcDayStartInputValue(date) {
            return date.toISOString().slice(0, 10) + 'T00:00';
        }

        function resetFilters() {
            formElement.querySelectorAll('input').forEach(input => {
                input.value = '';
            });

            const from = formElement.elements.namedItem('from');
            if (from) {
                from.value = utcDayStartInputValue(new Date());
            }
        }

        function maxLogId() {
            const ids = [...contentElement.querySelectorAll('[data-error-item][data-log-id]')]
                .map(item => Number(item.getAttribute('data-log-id')))
                .filter(value => Number.isFinite(value));

            return ids.length === 0 ? null : Math.max(...ids);
        }

        function clearTail() {
            if (tailTimeoutId !== null) {
                window.clearTimeout(tailTimeoutId);
                tailTimeoutId = null;
            }
        }

        async function fetchHtml(url) {
            if (abortController !== null) {
                abortController.abort();
            }

            const ownController = new AbortController();
            abortController = ownController;
            const response = await fetch(url, {
                headers: { 'X-Requested-With': 'fetch' },
                signal: ownController.signal
            });

            if (!response.ok || response.redirected || !(response.headers.get('content-type') || '').includes('text/html')) {
                throw new Error(`HTTP ${response.status}`);
            }

            const html = await response.text();
            const validation = document.createElement('template'); validation.innerHTML = html;
            if (validation.content.querySelector('[data-dashboard-query-error]')) throw new Error('Query failed');
            if (ownController.signal.aborted || abortController !== ownController) throw new DOMException("Canceled", "AbortError");
            return html;
        }

        async function refreshContent(candidate = null) {
            clearTail();
            const query = candidate instanceof URLSearchParams ? candidate : formQuery();

            try {
                const html = await fetchHtml(`${contentUrl}?${query}`);
                if (appendedHistory && candidate === null) {
                    const template = document.createElement('template'); template.innerHTML = html;
                    const incoming = new Map([...template.content.querySelectorAll('[data-error-item]')].map(row => [row.dataset.logId, row]));
                    contentElement.querySelectorAll('[data-error-item]').forEach(row => { if (incoming.has(row.dataset.logId)) row.replaceWith(incoming.get(row.dataset.logId)); });
                } else { contentElement.innerHTML = html; appendedHistory = false; }
                appliedQuery = new URLSearchParams(query);
                updatePageUrl(query);
                window.bdkDashboard.clearRefreshError(contentElement);
                setStatus(`Updated ${new Date().toISOString().slice(11, 19)} UTC`, false);
            } catch (error) {
                if (error.name !== 'AbortError') {
                    window.bdkDashboard.showRefreshError(contentElement);
                    setStatus('Refresh failed', true);
                }
            } finally {
                scheduleTail();
            }
        }

        async function loadOlder(button) {
            const continuationToken = button.getAttribute('data-next-cursor');
            if (!continuationToken) {
                return;
            }

            button.disabled = true;
            const query = formQuery();
            query.set('continuationToken', continuationToken);

            try {
                const html = await fetchHtml(`${contentUrl}?${query}`);
                const template = document.createElement('template');
                template.innerHTML = html.trim();
                const seen = new Set([...contentElement.querySelectorAll('[data-error-item]')].map(row => row.dataset.logId));
                const items = [...template.content.querySelectorAll('[data-error-item]')].filter(row => !seen.has(row.dataset.logId));
                const list = contentElement.querySelector('[data-error-list]');
                items.forEach(item => list.appendChild(item));

                const next = template.content.querySelector('#errors-load-more-button')?.getAttribute('data-next-cursor');
                if (next) {
                    button.setAttribute('data-next-cursor', next);
                    button.disabled = false;
                } else {
                    button.disabled = true; button.removeAttribute('data-next-cursor');
                }

                appendedHistory = true;
                updateLoadedCount();
                window.bdkDashboard.clearRefreshError(contentElement);
                setStatus(`Loaded ${items.length} older errors`, false);
            } catch (error) {
                button.disabled = false;
                if (error.name !== 'AbortError') {
                    window.bdkDashboard.showRefreshError(contentElement);
                    setStatus('Load failed', true);
                }
            } finally {
            }
        }

        async function loadNewer() {
            if (!tailElement.checked || document.hidden || appendedHistory) {
                scheduleTail();
                return;
            }

            const afterId = maxLogId();
            if (afterId === null) {
                await refreshContent();
                return;
            }

            const query = formQuery();
            query.set('afterId', afterId.toString());

            try {
                const html = await fetchHtml(`${contentUrl}?${query}`);
                const template = document.createElement('template');
                template.innerHTML = html.trim();
                const seen = new Set([...contentElement.querySelectorAll('[data-error-item]')].map(row => row.dataset.logId));
                const items = [...template.content.querySelectorAll('[data-error-item]')].filter(row => !seen.has(row.dataset.logId));
                const list = contentElement.querySelector('[data-error-list]');
                items.reverse().forEach(item => list.prepend(item));

                window.bdkDashboard.clearRefreshError(contentElement);
                if (items.length > 0) {
                    setStatus(`Added ${items.length} new errors`, false);
                }
            } catch (error) {
                if (error.name !== 'AbortError') {
                    window.bdkDashboard.showRefreshError(contentElement);
                    setStatus('Tail failed', true);
                }
            } finally {
                scheduleTail();
            }
        }

        function scheduleTail() {
            clearTail();
            if (!tailElement.checked || document.hidden || appendedHistory) {
                return;
            }

            tailTimeoutId = window.setTimeout(loadNewer, 2000);
        }

        appliedQuery = draftQuery();
        function updateLoadedCount() {
            contentElement.querySelectorAll('[data-dashboard-loaded-count]').forEach(value => value.textContent = contentElement.querySelectorAll('[data-log-id]').length);
            const label = contentElement.querySelector('[data-dashboard-list-status]');
            if (label) label.textContent = `${contentElement.querySelectorAll('[data-log-id]').length} rows loaded`;
        }
        contentElement.addEventListener('change', event => {
            if (!event.target.matches('[data-dashboard-batch-size]')) return;
            const query = formQuery(); query.set('pageSize', event.target.value);
            window.bdkDashboard.state.set('bdk.dashboard.errors.rowsPerLoad', event.target.value);
            refreshContent(query);
        });
        try {
            const size = window.bdkDashboard.state.get('bdk.dashboard.errors.rowsPerLoad');
            const select = contentElement.querySelector('[data-dashboard-batch-size]');
            if (!new URL(location.href).searchParams.has('pageSize') && size && select && [...select.options].some(option => option.value === size) && select.value !== size) { const query = formQuery(); query.set('pageSize', size); refreshContent(query); }
        } catch { }

        formElement.addEventListener('submit', event => {
            event.preventDefault();
            if (formElement.reportValidity()) refreshContent(draftQuery());
        });

        resetElement.addEventListener('click', () => {
            resetFilters();
            refreshContent(draftQuery());
        });

        refreshButton.addEventListener('click', () => refreshContent());

        purgeButton.addEventListener('click', async () => {
            if (!await window.bdkDashboard.confirmAction({ title: 'Purge log entries', message: 'Purge retained log entries? This cannot be undone.', confirmText: 'Purge' })) {
                return;
            }

            await window.bdkDashboard.postAction('@purgePath', {
                refresh: () => refreshContent(formQuery()),
                errorMessage: 'Log purge failed:'
            });
        });

        tailElement.addEventListener('change', () => { if (appendedHistory && tailElement.checked) setStatus('Tail paused while browsing history; Apply to resume.', false); scheduleTail(); });

        contentElement.addEventListener('click', event => {
            const loadMoreButton = event.target.closest('#errors-load-more-button');
            if (loadMoreButton) {
                loadOlder(loadMoreButton);
                return;
            }

            const filterButton = event.target.closest('[data-filter-name]');
            if (filterButton) {
                const input = formElement.elements.namedItem(filterButton.getAttribute('data-filter-name'));
                if (input) {
                    input.value = filterButton.getAttribute('data-filter-value') ?? '';
                    refreshContent(draftQuery());
                }
            }
        });

        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                clearTail();
                return;
            }

            scheduleTail();
        });
    })();
</script>

@functions {
    public DashboardLayoutModel LayoutModel => new() { Title = "Errors" };
}
