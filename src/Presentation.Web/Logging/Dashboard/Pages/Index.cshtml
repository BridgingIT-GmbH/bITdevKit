@using System.Globalization
@using BridgingIT.DevKit.Presentation.Web.Dashboard
@using BridgingIT.DevKit.Presentation.Web.Dashboard.Pages
@using BridgingIT.DevKit.Presentation.Web.Logging.Dashboard
@using Microsoft.Extensions.DependencyInjection
@using RazorSlices
@inherits RazorSlice
@implements IUsesLayout<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages._DashboardLayout, DashboardLayoutModel>

@{
    var dashboardOptions = HttpContext.RequestServices.GetService<DashboardEndpointsOptions>() ?? new DashboardEndpointsOptions();
    var contentPath = BridgingIT.DevKit.Presentation.Web.Logging.Dashboard.DashboardEndpoints.BuildLogEntriesContentPath(dashboardOptions);
    var rowsPath = BridgingIT.DevKit.Presentation.Web.Logging.Dashboard.DashboardEndpoints.BuildLogEntriesRowsPath(dashboardOptions);
    var exportPath = BridgingIT.DevKit.Presentation.Web.Logging.Dashboard.DashboardEndpoints.BuildLogEntriesExportPath(dashboardOptions);
    var purgePath = BridgingIT.DevKit.Presentation.Web.Logging.Dashboard.DashboardEndpoints.BuildLogEntriesPurgePath(dashboardOptions);
    var filter = LogEntriesDashboard.CreateFilter(HttpContext);
}

<style>
    .dashboard-logentries-toggle-column {
        width: 1.75rem;
    }

    .dashboard-logentries-toggle-cell {
        text-align: center;
        width: 1.75rem;
    }

    .dashboard-logentries-toggle i {
        display: inline-block;
        transition: transform .12s ease;
    }

    .dashboard-logentries-toggle[aria-expanded="true"] i {
        transform: rotate(90deg);
    }

    .dashboard-logentry-details-cell {
        background: color-mix(in srgb, var(--bs-body-bg) 92%, var(--bs-body-color) 8%);
        border-top: 0;
        padding: .75rem 1rem;
    }

    .dashboard-logentry-details {
        display: grid;
        gap: .75rem 1rem;
        grid-template-columns: minmax(16rem, .9fr) minmax(20rem, 1.1fr);
    }

    .dashboard-logentry-detail-block {
        grid-column: 1 / -1;
    }

    .dashboard-logentry-details-title {
        color: var(--bs-secondary-color);
        font-size: .75rem;
        font-weight: 600;
        margin-bottom: .4rem;
        text-transform: uppercase;
    }

    .dashboard-logentry-details-list {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        margin: 0;
    }

    .dashboard-logentry-details-list dt,
    .dashboard-logentry-details-list dd {
        border-bottom: 1px solid var(--bs-border-color);
        margin: 0;
        padding: .28rem .4rem;
    }

    .dashboard-logentry-details-list dt {
        color: var(--bs-secondary-color);
        font-weight: 500;
        white-space: nowrap;
    }

    .dashboard-logentry-details-list dd {
        overflow-wrap: anywhere;
    }

    .dashboard-logentry-properties {
        max-height: 18rem;
        overflow: auto;
    }

    .dashboard-logentry-pre {
        border: 1px solid var(--bs-border-color);
        border-radius: .35rem;
        font-size: .78rem;
        margin: 0;
        max-height: 18rem;
        overflow: auto;
        padding: .5rem;
        white-space: pre-wrap;
    }

    @@media (max-width: 991.98px) {
        .dashboard-logentry-details {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-page-toolbar">
    <div class="d-flex flex-wrap justify-content-end align-items-center gap-2">
        <div class="form-check form-switch m-0">
            <input id="logentries-tail" class="form-check-input" type="checkbox" role="switch">
            <label class="form-check-label small" for="logentries-tail">Tail</label>
        </div>
        <span id="logentries-refresh-status" class="text-muted small">Updated @DateTimeOffset.UtcNow.ToString("HH:mm:ss 'UTC'", CultureInfo.InvariantCulture)</span>

        <button type="button" id="logentries-refresh-now" class="btn btn-outline-secondary btn-sm" title="Refresh log entries" aria-label="Refresh log entries">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
        <details class="dashboard-tools"><summary class="btn btn-outline-secondary btn-sm">Tools</summary><div class="dashboard-tools-menu">
        <a id="logentries-export" class="btn btn-outline-secondary btn-sm" href="@(exportPath + LogEntriesDashboard.BuildQuery(filter))" title="Export filtered log entries" aria-label="Export filtered log entries">
            <i class="bi bi-download" aria-hidden="true"></i>
        </a>
        <button type="button" id="logentries-purge" class="btn btn-outline-danger btn-sm" title="Purge log entries" aria-label="Purge log entries">
            <i class="bi bi-trash3" aria-hidden="true"></i>
        </button>
        </div></details>
    </div>
</div>

<form id="logentries-filter-form" class="card mb-2 dashboard-filter-panel" method="get">
    <div class="card-body p-3">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-lg-3">
                <label class="form-label small" for="logentries-q">Search</label>
                <input id="logentries-q" name="q" value="@filter.SearchText" class="form-control form-control-sm" placeholder="message, trace, span, correlation, module">
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label small" for="logentries-level">Minimum level</label>
                <select id="logentries-level" name="level" class="form-select form-select-sm">
                    @if (filter.Level is null)
                    {
                        <option value="All" selected>All levels</option>
                    }
                    else
                    {
                        <option value="All">All levels</option>
                    }
                    @foreach (var level in new[] { "Trace", "Debug", "Information", "Warning", "Error", "Critical" })
                    {
                        if (string.Equals(filter.Level?.ToString(), level, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@level" selected>@LogEntriesDashboard.DisplayLevel(level)</option>
                        }
                        else
                        {
                            <option value="@level">@LogEntriesDashboard.DisplayLevel(level)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label small" for="logentries-from">From UTC</label>
                <div class="input-group input-group-sm">
                    @(await RenderPartialAsync<DateRange, DashboardDateRangeModel>(new("logentries-from", "logentries-to")))
                    <input id="logentries-from" name="from" type="datetime-local" step="60" value="@DashboardDateTime.FormatInput(filter.StartTime)" class="form-control form-control-sm" data-dashboard-date-picker>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label small" for="logentries-to">To UTC</label>
                <div class="input-group input-group-sm">
                    <input id="logentries-to" name="to" type="datetime-local" step="60" value="@DashboardDateTime.FormatInput(filter.EndTime)" class="form-control form-control-sm" data-dashboard-date-picker>
                </div>
            </div>
            <div class="col-12 col-lg-auto d-flex ms-auto">
                @(await RenderPartialAsync<FilterActions, DashboardFilterActionsModel>(new(ResetId: "logentries-reset")))
            </div>
        </div>
        <div class="row g-2 mt-1">
            <div class="col-6 col-lg-2"><label class="form-label small" for="logentries-correlationId">Correlation ID</label><input id="logentries-correlationId" name="correlationId" value="@filter.CorrelationId" class="form-control form-control-sm" placeholder="CorrelationId"></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="logentries-traceId">Trace ID</label><input id="logentries-traceId" name="traceId" value="@filter.TraceId" class="form-control form-control-sm" placeholder="TraceId"></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="logentries-spanId">Span ID</label><input id="logentries-spanId" name="spanId" value="@filter.SpanId" class="form-control form-control-sm" placeholder="SpanId"></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="logentries-logKey">Log key</label><input id="logentries-logKey" name="logKey" value="@filter.LogKey" class="form-control form-control-sm" placeholder="LogKey"></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="logentries-moduleName">Module</label><input id="logentries-moduleName" name="moduleName" value="@filter.ModuleName" class="form-control form-control-sm" placeholder="ModuleName"></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="logentries-shortTypeName">Type</label><input id="logentries-shortTypeName" name="shortTypeName" value="@filter.ShortTypeName" class="form-control form-control-sm" placeholder="ShortTypeName"></div>
        </div>
    </div>
</form>

<div id="dashboard-logentries-content">
    @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Logging.Dashboard.Pages.Content>())
</div>

<script>
    (() => {
        const contentUrl = '@contentPath';
        const rowsUrl = '@rowsPath';
        const exportUrl = '@exportPath';
        const contentElement = document.getElementById('dashboard-logentries-content');
        const formElement = document.getElementById('logentries-filter-form');
        const resetElement = document.getElementById('logentries-reset');
        const statusElement = document.getElementById('logentries-refresh-status');
        const refreshButton = document.getElementById('logentries-refresh-now');
        const tailElement = document.getElementById('logentries-tail');
        const exportElement = document.getElementById('logentries-export');
        const purgeElement = document.getElementById('logentries-purge');

        let tailTimeoutId = null;
        let appendedHistory = false;
        let abortController = null;

        let appliedQuery = null;
        function formQuery() { return new URLSearchParams(appliedQuery ?? draftQuery()); }
        function draftQuery() {
            const data = new FormData(formElement);
            const query = new URLSearchParams();
            for (const [key, value] of data.entries()) {
                if (value !== null && value.toString().trim() !== '') {
                    const text = value.toString().trim();
                    query.set(key, (key === 'from' || key === 'to') ? text + 'Z' : text);
                }
            }

            return query;
        }

        function setStatus(text, isError) {
            statusElement.textContent = text;
            statusElement.classList.toggle('text-danger', isError === true);
            statusElement.classList.toggle('text-muted', isError !== true);
        }

        function updatePageUrl(query) {
            const url = new URL(window.location.href);
            const view = url.searchParams.get('dashboardView');
            url.search = query.toString();
            if (view) url.searchParams.set('dashboardView', view);
            window.history.replaceState(null, '', url.toString());
        }

        function updateExportUrl(query) {
            exportElement.href = query.toString() ? `${exportUrl}?${query}` : exportUrl;
        }

        function utcDayStartInputValue(date) {
            return date.toISOString().slice(0, 10) + 'T00:00';
        }

        function resetFilters() {
            formElement.querySelectorAll('input').forEach(input => {
                input.value = '';
            });

            const level = formElement.elements.namedItem('level');
            if (level) {
                level.value = 'Information';
            }

            const from = formElement.elements.namedItem('from');
            if (from) {
                from.value = utcDayStartInputValue(new Date());
            }
        }

        function maxLogId() {
            const ids = [...contentElement.querySelectorAll('[data-log-id]')]
                .map(row => Number(row.getAttribute('data-log-id')))
                .filter(value => Number.isFinite(value));

            return ids.length === 0 ? null : Math.max(...ids);
        }

        function collectLogRowGroups(fragment) {
            return [...fragment.querySelectorAll('tr[data-log-id]')].map(row => {
                const detailsRow = row.nextElementSibling?.matches('[data-logentry-details]') === true
                    ? row.nextElementSibling
                    : null;

                return { row, detailsRow };
            });
        }

        function clearTail() {
            if (tailTimeoutId !== null) {
                window.clearTimeout(tailTimeoutId);
                tailTimeoutId = null;
            }
        }

        async function fetchHtml(url) {
            if (abortController !== null) {
                abortController.abort();
            }

            const ownController = new AbortController();
            abortController = ownController;
            const response = await fetch(url, {
                headers: { 'X-Requested-With': 'fetch' },
                signal: ownController.signal
            });

            if (!response.ok || response.redirected || !(response.headers.get('content-type') || '').includes('text/html')) {
                throw new Error(`HTTP ${response.status}`);
            }

            const html = await response.text();
            const validation = document.createElement('template'); validation.innerHTML = html;
            if (validation.content.querySelector('[data-dashboard-query-error]')) throw new Error('Query failed');
            if (ownController.signal.aborted || abortController !== ownController) throw new DOMException("Canceled", "AbortError");
            return html;
        }

        async function refreshContent(candidate = null) {
            clearTail();
            const query = candidate instanceof URLSearchParams ? candidate : formQuery();

            try {
                const html = await fetchHtml(`${contentUrl}?${query}`);
                if (appendedHistory && candidate === null) {
                    const template = document.createElement('template'); template.innerHTML = html;
                    const incoming = new Map(collectLogRowGroups(template.content).map(group => [group.row.dataset.logId, group]));
                    for (const group of collectLogRowGroups(contentElement)) {
                        const updated = incoming.get(group.row.dataset.logId);
                        if (updated) { group.row.replaceWith(updated.row); group.detailsRow?.replaceWith(updated.detailsRow); }
                    }
                } else { contentElement.innerHTML = html; appendedHistory = false; }
                appliedQuery = new URLSearchParams(query);
                updatePageUrl(query);
                updateExportUrl(query);
                window.bdkDashboard.clearRefreshError(contentElement);
                setStatus(`Updated ${new Date().toISOString().slice(11, 19)} UTC`, false);
            } catch (error) {
                if (error.name !== 'AbortError') {
                    window.bdkDashboard.showRefreshError(contentElement);
                    setStatus('Refresh failed', true);
                }
            } finally {
                scheduleTail();
            }
        }

        async function loadOlder(button) {
            const continuationToken = button.getAttribute('data-next-cursor');
            if (!continuationToken) {
                return;
            }

            button.disabled = true;
            const query = formQuery();
            query.set('continuationToken', continuationToken);

            try {
                const html = await fetchHtml(`${rowsUrl}?${query}`);
                const template = document.createElement('template');
                template.innerHTML = html.trim();
                const marker = template.content.querySelector('[data-next-continuation-token]');
                const seen = new Set([...contentElement.querySelectorAll('tr[data-log-id]')].map(row => row.dataset.logId));
                const rowGroups = collectLogRowGroups(template.content).filter(group => !seen.has(group.row.dataset.logId));
                const tbody = contentElement.querySelector('#logentries-table-body');
                rowGroups.forEach(group => {
                    tbody.appendChild(group.row);
                    if (group.detailsRow) {
                        tbody.appendChild(group.detailsRow);
                    }
                });

                const next = marker?.getAttribute('data-next-continuation-token');
                if (next) {
                    button.setAttribute('data-next-cursor', next);
                    button.disabled = false;
                } else {
                    button.disabled = true; button.removeAttribute('data-next-cursor');
                }

                appendedHistory = true;
                updateLoadedCount();
                window.bdkDashboard.clearRefreshError(contentElement);
                setStatus(`Loaded ${rowGroups.length} older entries`, false);
            } catch (error) {
                button.disabled = false;
                if (error.name !== 'AbortError') {
                    window.bdkDashboard.showRefreshError(contentElement);
                    setStatus('Load failed', true);
                }
            } finally {
            }
        }

        async function loadNewer() {
            if (!tailElement.checked || document.hidden || appendedHistory) {
                scheduleTail();
                return;
            }

            const afterId = maxLogId();
            if (afterId === null) {
                await refreshContent();
                return;
            }

            const query = formQuery();
            query.set('afterId', afterId.toString());

            try {
                const html = await fetchHtml(`${rowsUrl}?${query}`);
                const template = document.createElement('template');
                template.innerHTML = html.trim();
                const seen = new Set([...contentElement.querySelectorAll('tr[data-log-id]')].map(row => row.dataset.logId));
                const rowGroups = collectLogRowGroups(template.content).filter(group => !seen.has(group.row.dataset.logId));
                const tbody = contentElement.querySelector('#logentries-table-body');
                rowGroups.reverse().forEach(group => {
                    if (group.detailsRow) {
                        tbody.prepend(group.detailsRow);
                    }

                    tbody.prepend(group.row);
                });

                window.bdkDashboard.clearRefreshError(contentElement);
                if (rowGroups.length > 0) {
                    setStatus(`Added ${rowGroups.length} new entries`, false);
                }
            } catch (error) {
                if (error.name !== 'AbortError') {
                    window.bdkDashboard.showRefreshError(contentElement);
                    setStatus('Tail failed', true);
                }
            } finally {
                scheduleTail();
            }
        }

        function scheduleTail() {
            clearTail();
            if (!tailElement.checked || document.hidden || appendedHistory) {
                return;
            }

            tailTimeoutId = window.setTimeout(loadNewer, 2000);
        }

        appliedQuery = draftQuery();
        function updateLoadedCount() {
            contentElement.querySelectorAll('[data-dashboard-loaded-count]').forEach(value => value.textContent = contentElement.querySelectorAll('tr[data-log-id]').length);
            const label = contentElement.querySelector('[data-dashboard-list-status]');
            if (label) label.textContent = `${contentElement.querySelectorAll('tr[data-log-id]').length} rows loaded`;
        }
        contentElement.addEventListener('change', event => {
            if (!event.target.matches('[data-dashboard-batch-size]')) return;
            const query = formQuery(); query.set('pageSize', event.target.value);
            window.bdkDashboard.state.set('bdk.dashboard.logentries.rowsPerLoad', event.target.value);
            refreshContent(query);
        });
        try {
            const size = window.bdkDashboard.state.get('bdk.dashboard.logentries.rowsPerLoad');
            const select = contentElement.querySelector('[data-dashboard-batch-size]');
            if (!new URL(location.href).searchParams.has('pageSize') && size && select && [...select.options].some(option => option.value === size) && select.value !== size) { const query = formQuery(); query.set('pageSize', size); refreshContent(query); }
        } catch { }

        formElement.addEventListener('submit', event => {
            event.preventDefault();
            if (formElement.reportValidity()) refreshContent(draftQuery());
        });

        resetElement.addEventListener('click', () => {
            resetFilters();
            refreshContent(draftQuery());
        });

        refreshButton.addEventListener('click', () => refreshContent());

        purgeElement.addEventListener('click', async () => {
            if (!await window.bdkDashboard.confirmAction({ title: 'Purge log entries', message: 'Purge retained log entries? This cannot be undone.', confirmText: 'Purge' })) {
                return;
            }

            await window.bdkDashboard.postAction('@purgePath', {
                refresh: () => refreshContent(formQuery()),
                errorMessage: 'Log purge failed:'
            });
        });

        tailElement.addEventListener('change', () => { if (appendedHistory && tailElement.checked) setStatus('Tail paused while browsing history; Apply to resume.', false); scheduleTail(); });


        contentElement.addEventListener('click', event => {
            const loadMoreButton = event.target.closest('#logentries-load-more-button');
            if (loadMoreButton) {
                loadOlder(loadMoreButton);
                return;
            }

            const toggleButton = event.target.closest('[data-logentry-toggle]');
            if (toggleButton) {
                const detailsRow = document.getElementById(toggleButton.getAttribute('data-logentry-toggle'));
                const expanded = toggleButton.getAttribute('aria-expanded') === 'true';
                toggleButton.setAttribute('aria-expanded', (!expanded).toString());
                toggleButton.title = expanded ? 'Show log entry details' : 'Hide log entry details';
                detailsRow?.classList.toggle('d-none', expanded);
                return;
            }

            const filterButton = event.target.closest('[data-filter-name]');
            if (filterButton) {
                const input = formElement.elements.namedItem(filterButton.getAttribute('data-filter-name'));
                if (input) {
                    input.value = filterButton.getAttribute('data-filter-value') ?? '';
                    refreshContent(draftQuery());
                }
            }
        });

        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                clearTail();
                return;
            }

            scheduleTail();
        });
    })();
</script>

@functions {
    public DashboardLayoutModel LayoutModel => new() { Title = "Logs" };
}
