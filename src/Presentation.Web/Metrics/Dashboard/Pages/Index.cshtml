@using BridgingIT.DevKit.Presentation.Web.Dashboard
@using BridgingIT.DevKit.Presentation.Web.Dashboard.Pages
@using BridgingIT.DevKit.Presentation.Web.Metrics.Dashboard.Pages
@using Microsoft.Extensions.DependencyInjection
@using MetricsEndpoints = BridgingIT.DevKit.Presentation.Web.Metrics.Dashboard.DashboardEndpoints
@inherits RazorSlice
@implements IUsesLayout<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages._DashboardLayout, DashboardLayoutModel>

@{
    var dashboardOptions = HttpContext.RequestServices.GetService<DashboardEndpointsOptions>() ?? new DashboardEndpointsOptions();
    var segment = HttpContext.Request.Path.Value?.TrimEnd('/').Split('/').LastOrDefault();
    var view = MetricsEndpoints.Views.Contains(segment) ? segment : "app";
    var contentPath = DashboardPath.Combine(dashboardOptions.GroupPath, dashboardOptions.EndpointPaths.MetricsContent) + "?view=" + view;
    var labels = new Dictionary<string, string> { ["app"] = "App", ["dotnet"] = ".NET", ["aspnet"] = "ASP.NET", ["routes"] = "Routes" };
}

<div class="dashboard-page-toolbar">
    <div class="d-flex align-items-center gap-2">
        @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages.RefreshControls, DashboardRefreshModel>(new("metrics", "Refresh metrics")))
    </div>
</div>
<nav class="nav nav-pills mb-2" aria-label="Metrics views" data-dashboard-view="@view">
    @foreach (var item in MetricsEndpoints.Views)
    {
        <a class="nav-link @(item == view ? "active" : "")" aria-current="@(item == view ? "page" : null)" href="@MetricsEndpoints.BuildMetricsPath(dashboardOptions, item)">@labels[item]</a>
    }
</nav>

<div id="dashboard-metrics-content">
    @(await RenderPartialAsync<Content>())
</div>

<script>
    (() => {
        window.bdkDashboard.createRefresher({
            contentUrl: '@contentPath',
            contentSelector: '#dashboard-metrics-content',
            statusSelector: '#metrics-refresh-status',
            intervalSelector: '#metrics-refresh-interval',
            refreshButtonSelector: '#metrics-refresh-now',
            storageKey: 'bdk.dashboard.metrics.refreshInterval'
        });
    })();
</script>

@functions {
    public DashboardLayoutModel LayoutModel => new() { Title = "Metrics" };

}
