                red: "#50f872", yellow: "#50f7d4", orange: "#50f7a3", green: "#4fe88f", cyan: "#7cf8f7", blue: "#829dd4", magenta: "#86a7df", brown: "#287b51",
                bright_red: "#85ff9d", bright_yellow: "#a4ffec", bright_green: "#9cf7c2", bright_cyan: "#d1fffe", bright_blue: "#c4d2ed", bright_magenta: "#cddbf4"
            }),
            "osaka-jade": Object.freeze({ label: "Osaka Jade",
                mode: "dark", accent: "#509475", selection: "#32473B", muted: "#53685B",
                background: "#111c18", dark_background: "#0c1512", darker_background: "#090f0d", lighter_background: "#23372B",
                foreground: "#C1C497", dark_foreground: "#81B8A8", light_foreground: "#D6D5BC", bright_foreground: "#F7E8B2",
                red: "#FF5345", yellow: "#459451", orange: "#a2734b", green: "#549e6a", cyan: "#2DD5B7", blue: "#509475", magenta: "#D2689C", brown: "#513925",
                bright_red: "#db9f9c", bright_yellow: "#E5C736", bright_green: "#63b07a", bright_cyan: "#8CD3CB", bright_blue: "#ACD4CF", bright_magenta: "#75bbb3"
            }),
            "kanagawa": Object.freeze({ label: "Kanagawa",
                mode: "dark", accent: "#dcd7ba", selection: "#363646", muted: "#54546D",
                background: "#1f1f28", dark_background: "#17171e", darker_background: "#111116", lighter_background: "#223249",
                foreground: "#dcd7ba", dark_foreground: "#727169", light_foreground: "#c8c093", bright_foreground: "#dcd7ba",
                red: "#c34043", yellow: "#c0a36e", orange: "#c17158", green: "#76946a", cyan: "#6a9589", blue: "#7e9cd8", magenta: "#957fb8", brown: "#60382c",
                bright_red: "#e82424", bright_yellow: "#e6c384", bright_green: "#98bb6c", bright_cyan: "#7aa89f", bright_blue: "#7fb4ca", bright_magenta: "#938aa9"
            }),
            "vantablack": Object.freeze({ label: "Vantablack",
                mode: "dark", accent: "#8d8d8d", selection: "#1a1a1a", muted: "#7a7a7a",
                background: "#000000", dark_background: "#090909", darker_background: "#070707", lighter_background: "#1a1a1a",
                foreground: "#ffffff", dark_foreground: "#505050", light_foreground: "#ececec", bright_foreground: "#ffffff",
                red: "#a4a4a4", yellow: "#cecece", orange: "#b9b9b9", green: "#b6b6b6", cyan: "#b0b0b0", blue: "#8d8d8d", magenta: "#9b9b9b", brown: "#5c5c5c",
                bright_red: "#a4a4a4", bright_yellow: "#cecece", bright_green: "#b6b6b6", bright_cyan: "#b0b0b0", bright_blue: "#8d8d8d", bright_magenta: "#9b9b9b"
            }),
            "matte-black": Object.freeze({ label: "Matte Black",
                mode: "dark", accent: "#e68e0d", selection: "#2a2a2a", muted: "#333333",
                background: "#121212", dark_background: "#0d0d0d", darker_background: "#090909", lighter_background: "#1e1e1e",
                foreground: "#bebebe", dark_foreground: "#555555", light_foreground: "#8a8a8d", bright_foreground: "#bebebe",
                red: "#D35F5F", yellow: "#b91c1c", orange: "#c63d3d", green: "#FFC107", cyan: "#bebebe", blue: "#e68e0d", magenta: "#D35F5F", brown: "#631e1e",
                bright_red: "#B91C1C", bright_yellow: "#b90a0a", bright_green: "#FFC107", bright_cyan: "#eaeaea", bright_blue: "#f59e0b", bright_magenta: "#B91C1C"
            }),
            "ristretto": Object.freeze({ label: "Ristretto",
                mode: "dark", accent: "#f38d70", selection: "#403e41", muted: "#72696a",
                background: "#2c2525", dark_background: "#211b1b", darker_background: "#181414", lighter_background: "#3d2f2a",
                foreground: "#e6d9db", dark_foreground: "#72696a", light_foreground: "#c3b7b8", bright_foreground: "#e6d9db",
                red: "#fd6883", yellow: "#f9cc6c", orange: "#fb9a77", green: "#adda78", cyan: "#85dacc", blue: "#f38d70", magenta: "#a8a9eb", brown: "#7d4d3b",
                bright_red: "#ff8297", bright_yellow: "#fcd675", bright_green: "#c8e292", bright_cyan: "#9bf1e1", bright_blue: "#f8a788", bright_magenta: "#bebffd"
            }),
            "retro-82": Object.freeze({ label: "Retro 82",
                mode: "dark", accent: "#faa968", selection: "#134e5a", muted: "#2a6b78",
                background: "#05182e", dark_background: "#031222", darker_background: "#020c17", lighter_background: "#0a2540",
                foreground: "#f6dcac", dark_foreground: "#3f8f8a", light_foreground: "#a7c9c6", bright_foreground: "#f6dcac",
                red: "#f85525", yellow: "#e97b3c", orange: "#faa968", green: "#028391", cyan: "#8cbfb8", blue: "#3f8f8a", magenta: "#3f8f8a", brown: "#743d1e",
                bright_red: "#f85525", bright_yellow: "#e97b3c", bright_green: "#028391", bright_cyan: "#8cbfb8", bright_blue: "#faa968", bright_magenta: "#3f8f8a"
            }),
            "flexoki-light": Object.freeze({ label: "Flexoki Light",
                mode: "light", accent: "#205EA6", selection: "#CECDC3", muted: "#B7B5AC",
                background: "#FFFCF0", dark_background: "#f2efe4", darker_background: "#e5e2d8", lighter_background: "#E6E4D9",
                foreground: "#100F0F", dark_foreground: "#878580", light_foreground: "#403E3C", bright_foreground: "#100F0F",
                red: "#D14D41", yellow: "#D0A215", orange: "#d0772b", green: "#879A39", cyan: "#3AA99F", blue: "#205EA6", magenta: "#CE5D97", brown: "#683b15",
                bright_red: "#D14D41", bright_yellow: "#D0A215", bright_green: "#879A39", bright_cyan: "#3AA99F", bright_blue: "#4385BE", bright_magenta: "#CE5D97"
            }),
            "catppuccin-latte": Object.freeze({ label: "Catppuccin Latte",
                mode: "light", accent: "#1e66f5", selection: "#ccd0da", muted: "#acb0be",
                background: "#eff1f5", dark_background: "#e3e4e8", darker_background: "#d7d8dc", lighter_background: "#dce0e8",
                foreground: "#4c4f69", dark_foreground: "#9ca0b0", light_foreground: "#5c5f77", bright_foreground: "#4c4f69",
                red: "#d20f39", yellow: "#df8e1d", orange: "#d84e2b", green: "#40a02b", cyan: "#179299", blue: "#1e66f5", magenta: "#ea76cb", brown: "#6c2715",
                bright_red: "#d20f39", bright_yellow: "#df8e1d", bright_green: "#40a02b", bright_cyan: "#179299", bright_blue: "#1e66f5", bright_magenta: "#ea76cb"
            }),
            "white": Object.freeze({ label: "White",
                mode: "light", accent: "#6e6e6e", selection: "#c0c0c0", muted: "#808080",
                background: "#ffffff", dark_background: "#f5f5f5", darker_background: "#e8e8e8", lighter_background: "#c0c0c0",
                foreground: "#000000", dark_foreground: "#c0c0c0", light_foreground: "#000000", bright_foreground: "#000000",
                red: "#2a2a2a", yellow: "#4a4a4a", orange: "#4a4a4a", green: "#3a3a3a", cyan: "#3e3e3e", blue: "#1a1a1a", magenta: "#2e2e2e", brown: "#252525",
                bright_red: "#2a2a2a", bright_yellow: "#4a4a4a", bright_green: "#3a3a3a", bright_cyan: "#3e3e3e", bright_blue: "#1a1a1a", bright_magenta: "#2e2e2e"
            }),
        });
        const themes = Object.freeze({ ...Object.fromEntries(Object.keys(palettes).map(name => [name, name])), dark: 'matte-black', light: 'white' });
        const defaultTheme = themes['tokyo-night'];
        const labels = Object.freeze(Object.fromEntries(Object.entries(palettes).map(([name, palette]) => [name, palette.label])));
        const themeValues = Object.keys(palettes);
        const legacyThemes = Object.freeze({ dark: 'matte-black', light: 'white', tokionights: 'tokyo-night', darkforest: 'osaka-jade', carbon: 'catppuccin', matrix: 'hackerman' });

        const readPreference = (key, fallback) => {
            try {
                return window.localStorage.getItem(key) ?? fallback;
            } catch {
                return fallback;
            }
        };

        const writePreference = (key, value) => {
            try {
                window.localStorage.setItem(key, value);
            } catch {
                // The selected theme still applies for this document when storage is unavailable.
            }
        };

        const rgb = hex => [1, 3, 5].map(index => parseInt(hex.slice(index, index + 2), 16));
        const mix = (start, end, amount) => '#' + rgb(start).map((value, index) => Math.round(value * (1 - amount) + rgb(end)[index] * amount).toString(16).padStart(2, '0')).join('');
        const luminance = hex => rgb(hex).map(value => value / 255).map(value => value <= .04045 ? value / 12.92 : ((value + .055) / 1.055) ** 2.4).reduce((sum, value, index) => sum + value * [.2126, .7152, .0722][index], 0);
        const contrast = (foreground, background) => (Math.max(luminance(foreground), luminance(background)) + .05) / (Math.min(luminance(foreground), luminance(background)) + .05);
        const readable = (color, background) => {
            if (contrast(color, background) >= 4.5) return color;
            const target = contrast('#000000', background) > contrast('#ffffff', background) ? '#000000' : '#ffffff';
            for (let amount = .01; amount <= 1; amount += .01) {
                const candidate = mix(color, target, amount);
                if (contrast(candidate, background) >= 4.5) return candidate;
            }
            return target;
        };

        function themeVariables(palette) {
            const foregroundRgb = rgb(palette.foreground).join(',');
            const surface = palette.lighter_background;
            const activeBackground = mix(palette.background, palette.accent, .14);
            const muted = [surface, mix(surface, palette.accent, .04), ...['accent', 'magenta', 'green', 'cyan', 'yellow', 'red'].map(key => mix(surface, palette[key], .09))]
                .reduce((text, background) => readable(text, background), palette.light_foreground);
            const variables = {
                'color-scheme': palette.mode,
                '--bs-body-bg': palette.background,
                '--bs-body-bg-rgb': rgb(palette.background).join(','),
                '--bs-body-color': palette.foreground,
                '--bs-body-color-rgb': foregroundRgb,
                '--bs-emphasis-color': palette.bright_foreground,
                '--bs-emphasis-color-rgb': rgb(palette.bright_foreground).join(','),
                '--bs-secondary-color': muted,
                '--bs-secondary-bg': palette.dark_background,
                '--bs-tertiary-bg': palette.lighter_background,
                '--bs-tertiary-color': palette.dark_foreground,
                '--bs-border-color': `rgba(${foregroundRgb},.4)`,
                '--bs-border-color-translucent': `rgba(${foregroundRgb},.18)`,
                '--bs-link-color': readable(palette.accent, palette.background),
                '--bs-link-hover-color': readable(mix(palette.accent, palette.foreground, .18), palette.background),
                '--bs-focus-ring-color': `rgba(${rgb(palette.accent).join(',')},.25)`,
                '--bs-code-color': readable(palette.accent, palette.dark_background),
                '--dashboard-surface': surface,
                '--dashboard-surface-inset': palette.dark_background,
                '--dashboard-surface-header': mix(surface, palette.accent, .04),
                '--dashboard-surface-muted': mix(palette.background, surface, .5),
                '--dashboard-border': `rgba(${foregroundRgb},.4)`,
                '--dashboard-border-rgb': foregroundRgb,
                '--dashboard-panel-border': `rgba(${foregroundRgb},.18)`,
                '--dashboard-panel-border-hover': `rgba(${foregroundRgb},.4)`,
                '--dashboard-text': palette.foreground,
                '--dashboard-muted': muted,
                '--dashboard-code-bg': palette.dark_background,
                '--dashboard-navbar-bg': palette.background,
                '--dashboard-sidebar-bg': palette.background,
                '--dashboard-nav-icon': [palette.background, activeBackground, surface]
                    .reduce((color, background) => readable(color, background), palette.blue),
                '--dashboard-active-bg': activeBackground,
                '--dashboard-selected-bg': palette.selection,
                '--dashboard-active-fg': readable(palette.accent, mix(surface, palette.accent, .14)),
                '--dashboard-selected-fg': readable(palette.foreground, palette.selection)
            };
            variables['--bs-link-color-rgb'] = rgb(variables['--bs-link-color']).join(',');
            variables['--bs-link-hover-color-rgb'] = rgb(variables['--bs-link-hover-color']).join(',');
            for (const [key, color] of Object.entries(palette)) {
                if (!/^#[0-9a-f]{6}$/i.test(color)) continue;
                const name = key.replaceAll('_', '-');
                variables[`--dashboard-palette-${name}`] = color;
                variables[`--dashboard-palette-${name}-rgb`] = rgb(color).join(',');
            }
            for (const [index, key] of ['blue', 'yellow', 'magenta', 'green', 'red', 'cyan', 'orange', 'bright_blue'].entries()) {
                variables[`--dashboard-series-${index + 1}-text`] = [surface, mix(surface, palette[key], .1), mix(palette.background, palette[key], .22)]
                    .reduce((text, background) => readable(text, background), palette[key]);
            }
            for (const [role, key] of Object.entries({ primary: 'accent', secondary: 'light_foreground', success: 'green', info: 'cyan', warning: 'yellow', danger: 'red', analysis: 'magenta' })) {
                const color = palette[key];
                const onColor = [palette.foreground, palette.background].find(candidate => contrast(candidate, color) >= 4.5)
                    || (contrast('#000000', color) > contrast('#ffffff', color) ? '#000000' : '#ffffff');
                variables[`--bs-${role}`] = color;
                variables[`--bs-${role}-rgb`] = rgb(color).join(',');
                variables[`--bs-${role}-bg-subtle`] = mix(palette.background, color, .1);
                variables[`--bs-${role}-border-subtle`] = mix(palette.background, color, .35);
                variables[`--bs-${role}-text-emphasis`] = readable(color, mix(surface, color, .15));
                variables[`--dashboard-${role}-text`] = variables[`--bs-${role}-text-emphasis`];
                variables[`--dashboard-on-${role}`] = onColor;
                variables[`--dashboard-${role}-hover-bg`] = mix(color, contrast('#000000', color) > contrast('#ffffff', color) ? '#ffffff' : '#000000', .1);
            }
            return variables;
        }

        window.bdkTheme = window.bdkTheme || {
            themes,
            labels,
            palettes,
            initialized: false,

            normalizeTheme(theme) {
                return themeValues.includes(theme) ? theme : Object.hasOwn(legacyThemes, theme) ? legacyThemes[theme] : defaultTheme;
            },

            getCurrentTheme() {
                const stored = readPreference('theme', defaultTheme);
                const normalized = this.normalizeTheme(stored);
                if (stored !== normalized) writePreference('theme', normalized);
                return normalized;
            },

            applyTheme(theme, persist = true) {
                const selectedTheme = this.normalizeTheme(theme);
                const effectiveTheme = selectedTheme;

                const palette = palettes[effectiveTheme];
                for (const [key, value] of Object.entries(themeVariables(palette))) document.documentElement.style.setProperty(key, value);
                document.documentElement.setAttribute('data-bs-theme', palette.mode);
                document.documentElement.setAttribute('data-dashboard-theme', selectedTheme);
                document.documentElement.setAttribute('data-dashboard-palette', effectiveTheme);
                if (persist) {
                    writePreference('theme', selectedTheme);
                }

                this.updateThemePickers(selectedTheme);
                document.dispatchEvent(new CustomEvent('bdk-dashboard-theme-changed', {
                    detail: { theme: selectedTheme, effectiveTheme, mode: palette.mode }
                }));
            },

            getCurrentTexture() {
                return readPreference('dashboardTexture', 'false') === 'true';
            },

            applyTexture(enabled, persist = true) {
                const isEnabled = enabled === true;
                document.documentElement.setAttribute('data-dashboard-texture', isEnabled ? 'on' : 'off');
                if (persist) {
                    writePreference('dashboardTexture', isEnabled ? 'true' : 'false');
                }

                document.querySelectorAll('.dashboard-texture-toggle').forEach(toggle => {
                    toggle.setAttribute('aria-pressed', isEnabled ? 'true' : 'false');
                });
            },

            setupThemePickers() {
                document.querySelectorAll('.dashboard-theme-picker').forEach(picker => {
                    if (picker.dataset.themePickerReady === 'true') {
                        return;
                    }

                    const toggle = picker.querySelector('.theme-toggle');
                    if (!toggle) {
                        return;
                    }

                    const options = picker.querySelector('[data-theme-options]');
                    if (options) {
                        for (const name of themeValues) {
                            const palette = palettes[name];
                            const item = document.createElement('li');
                            const option = document.createElement('button');
                            option.type = 'button';
                            option.className = 'dropdown-item d-flex align-items-center gap-2';
                            option.dataset.themeOption = name;
                            const swatch = document.createElement('span');
                            swatch.className = 'dashboard-theme-swatch';
                            swatch.setAttribute('aria-hidden', 'true');
                            swatch.style.setProperty('--theme-bg', palette.background);
                            swatch.style.setProperty('--theme-swatch', palette.foreground);
                            swatch.style.setProperty('--theme-accent', palette.accent);
                            option.append(swatch, document.createTextNode(labels[name]));
                            item.append(option);
                            options.append(item);
                        }
                    }

                    picker.dataset.themePickerReady = 'true';
                    toggle.addEventListener('click', event => {
                        event.stopPropagation();
                        const isOpen = picker.classList.toggle('is-open');
                        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    });

                    picker.querySelectorAll('[data-theme-option]').forEach(option => {
                        option.addEventListener('click', event => {
                            event.stopPropagation();
                            this.applyTheme(option.dataset.themeOption);
                            picker.classList.remove('is-open');
                            toggle.setAttribute('aria-expanded', 'false');
                        });
                    });
                });

                this.updateThemePickers(this.getCurrentTheme());
            },

            updateThemePickers(theme) {
                const label = labels[theme] || labels[defaultTheme];
                const palette = palettes[theme] || palettes[defaultTheme];
                document.querySelectorAll('.dashboard-theme-picker').forEach(picker => {
                    const toggle = picker.querySelector('.theme-toggle');
                    toggle?.setAttribute('aria-label', 'Select global theme: ' + label);
                    const titleAttribute = toggle?.hasAttribute('data-bs-original-title') ? 'data-bs-original-title' : 'title';
                    toggle?.setAttribute(titleAttribute, 'Theme: ' + label);
                    const swatch = picker.querySelector('[data-theme-selected-swatch]');
                    if (swatch) {
                        swatch.style.setProperty('--theme-bg', palette.background);
                        swatch.style.setProperty('--theme-swatch', palette.foreground);
                        swatch.style.setProperty('--theme-accent', palette.accent);
                    }
                });

                document.querySelectorAll('[data-theme-option]').forEach(option => {
                    const isActive = option.dataset.themeOption === theme;
                    option.classList.toggle('active', isActive);
                    option.setAttribute('aria-current', isActive ? 'true' : 'false');
                });
            },

            closeThemePickers() {
                document.querySelectorAll('.dashboard-theme-picker.is-open').forEach(picker => {
                    picker.classList.remove('is-open');
                    picker.querySelector('.theme-toggle')?.setAttribute('aria-expanded', 'false');
                });
            },

            initialize() {
                this.applyTheme(this.getCurrentTheme(), false);
                this.applyTexture(this.getCurrentTexture(), false);
                this.setupThemePickers();
                if (this.initialized) {
                    return;
                }

                this.initialized = true;
                document.addEventListener('click', event => {
                    if (!event.target.closest('.dashboard-theme-picker')) {
                        this.closeThemePickers();
                    }
                });
                document.addEventListener('keydown', event => {
                    if (event.key === 'Escape') {
                        this.closeThemePickers();
                    }
                });
                window.addEventListener('storage', event => {
                    if (event.key === 'theme' || event.key === null) {
                        this.applyTheme(event.newValue || defaultTheme, false);
                    }

                    if (event.key === 'dashboardTexture' || event.key === null) {
                        this.applyTexture(event.newValue === 'true', false);
                    }
                });
            }
        };

        window.bdkTheme.applyTheme(window.bdkTheme.getCurrentTheme(), false);
        window.bdkTheme.applyTexture(window.bdkTheme.getCurrentTexture(), false);
    })();
</script>

