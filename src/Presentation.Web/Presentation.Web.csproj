<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BridgingIT.DevKit.Presentation.Web</AssemblyName>
    <RootNamespace>BridgingIT.DevKit.Presentation.Web</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BridgingIT.DevKit.Presentation.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../docs/assets/features/dashboard.svg;
                               ../../docs/assets/features/system.svg;
                               ../../docs/assets/features/metrics.svg;
                               ../../docs/assets/features/profiling.svg;
                               ../../docs/assets/features/profiling-operations.svg;
                               ../../docs/assets/features/profiling-requests.svg;
                               ../../docs/assets/features/health.svg;
                               ../../docs/assets/features/identity.svg;
                               ../../docs/assets/features/log-entries.svg;
                               ../../docs/assets/features/errors.svg;
                               ../../docs/assets/features/streams.svg;
                               ../../docs/assets/features/console-commands.svg;
                               ../../docs/assets/features/mcp.svg;
                               ../../docs/assets/features/broadcasting.svg;
                               ../../docs/assets/features/jobs.svg;
                               ../../docs/assets/features/orchestrations.svg;
                               ../../docs/assets/features/messaging.svg;
                               ../../docs/assets/features/queueing.svg;
                               ../../docs/assets/features/storage-files.svg;
                               ../../docs/assets/features/storage-documents.svg;
                               ../../docs/assets/features/storage-blobs.svg;
                               ../../docs/assets/features/storage-permalinks.svg;
                               ../../docs/assets/features/change-history.svg"
                      LogicalName="BridgingIT.DevKit.Presentation.Web.Dashboard.Icons.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hellang.Middleware.ProblemDetails" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="NSwag.AspNetCore" />
    <PackageReference Include="RazorSlices" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application.Identity\Application.Identity.csproj" />
    <ProjectReference Include="..\Application.Utilities\Application.Utilities.csproj" />
    <ProjectReference Include="..\Common.Extensions.Web\Common.Extensions.Web.csproj" />
    <ProjectReference Include="..\Common.Mapping\Common.Mapping.csproj" />
    <ProjectReference Include="..\Common.Utilities\Common.Utilities.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Presentation\Presentation.csproj" />
  </ItemGroup>

</Project>
