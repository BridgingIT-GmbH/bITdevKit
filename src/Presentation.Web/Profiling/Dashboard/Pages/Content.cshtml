@using BridgingIT.DevKit.Common
@using BridgingIT.DevKit.Presentation.Web.Dashboard
@using BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard.Pages
@using ProfilingDashboardEndpoints = BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard.DashboardEndpoints
@using Microsoft.Extensions.DependencyInjection
@using RazorSlices
@inherits RazorSlice

@{
    var model = await BuildModelAsync();
}

@(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard.Pages.Data, DashboardProfilingViewModel>(model))

@functions {
    private async Task<DashboardProfilingViewModel> BuildModelAsync()
    {
        var services = this.HttpContext.RequestServices;
        var dashboardOptions = services.GetService<DashboardEndpointsOptions>() ?? new DashboardEndpointsOptions();
        var profilingOptions = services.GetService<ProfilingOptions>() ?? new ProfilingOptions();
        var control = services.GetService<IProfilingControlService>();
        var queries = services.GetService<IProfilingQueryService>();
        var requestedSession = this.HttpContext.Request.Query["session"].FirstOrDefault();
        var requestedNode = this.HttpContext.Request.Query["node"].FirstOrDefault();
        var requestedSnapshot = this.HttpContext.Request.Query["snapshot"].FirstOrDefault();
        var model = new DashboardProfilingViewModel
        {
            RefreshIntervalMilliseconds = Math.Max(1000, (int)profilingOptions.RefreshInterval.TotalMilliseconds),
            PagePath = ProfilingDashboardEndpoints.BuildProfilingPath(dashboardOptions),
            ContentPath = ProfilingDashboardEndpoints.BuildContentPath(dashboardOptions),
            StartPath = ProfilingDashboardEndpoints.BuildStartPath(dashboardOptions),
            StopPath = ProfilingDashboardEndpoints.BuildStopPath(dashboardOptions),
            SnapshotPath = ProfilingDashboardEndpoints.BuildSnapshotPath(dashboardOptions),
            GarbageCollectionPath = ProfilingDashboardEndpoints.BuildGarbageCollectionPath(dashboardOptions),
            StressPath = ProfilingDashboardEndpoints.BuildStressPath(dashboardOptions),
            MarkerPath = ProfilingDashboardEndpoints.BuildMarkerPath(dashboardOptions),
            DeleteUnpinnedPath = ProfilingDashboardEndpoints.BuildDeleteUnpinnedPath(dashboardOptions),
            ClearPath = ProfilingDashboardEndpoints.BuildClearPath(dashboardOptions),
            ComparePath = ProfilingDashboardEndpoints.BuildComparePath(dashboardOptions),
            AnalyzePath = ProfilingDashboardEndpoints.BuildAnalyzePath(dashboardOptions),
            ArchiveImportPath = ProfilingDashboardEndpoints.BuildArchiveImportPath(dashboardOptions),
        };

        if (control is null || queries is null)
        {
            model.Error = "Profiling services are unavailable in this host.";
            return model;
        }

        var statusResult = await control.GetStatusAsync(this.HttpContext.RequestAborted);
        var sessionsResult = await queries.ListSessionsAsync(this.HttpContext.RequestAborted);
        if (!statusResult.IsSuccess || !sessionsResult.IsSuccess)
        {
            model.Error = "Profiling data could not be loaded. Verify feature and provider registration.";
            return model;
        }

        model.Status = statusResult.Value;
        model.Sessions = sessionsResult.Value ?? [];
        var sessionKey = model.Sessions.Any(item => item.Identity.Key == requestedSession)
            ? requestedSession
            : model.Status?.Session?.Identity.Key ?? model.Sessions.FirstOrDefault()?.Identity.Key;
        if (string.IsNullOrWhiteSpace(sessionKey))
        {
            return model;
        }

        var sessionResult = await queries.GetSessionAsync(sessionKey, this.HttpContext.RequestAborted);
        if (!sessionResult.IsSuccess)
        {
            model.Error = $"Profiling session '{sessionKey}' could not be loaded.";
            return model;
        }

        model.SessionKey = sessionKey;
        model.SelectedSession = sessionResult.Value;
        var nodeKeys = model.NodeKeys;
        var nodeKey = nodeKeys.Contains(requestedNode, StringComparer.Ordinal)
            ? requestedNode
            : model.SelectedSession.Participations
                .OrderBy(item => item.Role)
                .ThenBy(item => item.NodeKey, StringComparer.Ordinal)
                .Select(item => item.NodeKey)
                .FirstOrDefault() ?? nodeKeys.FirstOrDefault();

        if (!string.IsNullOrWhiteSpace(nodeKey))
        {
            var nodeResult = await queries.GetNodeSessionAsync(sessionKey, nodeKey, this.HttpContext.RequestAborted);
            if (nodeResult.IsSuccess)
            {
                model.NodeKey = nodeKey;
                model.SelectedNode = nodeResult.Value;
                model.SnapshotKey = model.SelectedNode.Snapshots.Any(
                    item => item.Identity.Key == requestedSnapshot
                )
                    ? requestedSnapshot
                    : null;
            }
            else
            {
                model.Error = $"Profiling node '{nodeKey}' could not be loaded.";
            }
        }

        model.MetadataPath = ProfilingDashboardEndpoints.BuildMetadataPath(dashboardOptions, sessionKey);
        model.DeleteSessionPath = ProfilingDashboardEndpoints.BuildDeleteSessionPath(dashboardOptions, sessionKey);
        model.NodeExportPath = ProfilingDashboardEndpoints.BuildExportPath(dashboardOptions, sessionKey, model.NodeKey);
        model.SessionExportPath = ProfilingDashboardEndpoints.BuildSessionArchivePath(dashboardOptions, sessionKey);
        model.SessionArchivePath = ProfilingDashboardEndpoints.BuildSessionArchivePath(dashboardOptions, sessionKey);
        model.SessionPerfettoPath = ProfilingDashboardEndpoints.BuildSessionPerfettoPath(dashboardOptions, sessionKey);
        if (model.SelectedNode?.LatestSnapshot is { } latestSnapshot)
        {
            model.SnapshotArchivePath = ProfilingDashboardEndpoints.BuildSnapshotArchivePath(
                dashboardOptions,
                sessionKey,
                model.NodeKey,
                latestSnapshot.Identity.Key
            );
            model.SnapshotArchivePaths = model.SelectedNode.Snapshots.ToDictionary(
                item => item.Identity.Key,
                item => ProfilingDashboardEndpoints.BuildSnapshotArchivePath(
                    dashboardOptions,
                    sessionKey,
                    model.NodeKey,
                    item.Identity.Key
                ),
                StringComparer.Ordinal
            );
        }
        return model;
    }
}
