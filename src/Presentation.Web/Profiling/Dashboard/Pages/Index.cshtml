@using BridgingIT.DevKit.Presentation.Web.Dashboard.Pages
@using RazorSlices
@inherits RazorSlice
@implements IUsesLayout<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages._DashboardLayout, DashboardLayoutModel>

<div class="d-flex justify-content-end align-items-center py-2 mb-2 border-bottom">
    <div class="d-flex align-items-center gap-2">
        <span id="profiling-refresh-status" class="text-muted small" role="status">Updated @DateTimeOffset.UtcNow.LocalDateTime.ToString("T", CultureInfo.InvariantCulture)</span>
        <button type="button" id="profiling-stress" class="btn btn-outline-warning btn-sm profiling-tool-button profiling-stress-button" aria-label="Run a 30-second profiling stress workload" title="Stress this process for 30 seconds with high CPU, managed allocations, and retained memory"><i class="bi bi-fire" aria-hidden="true"></i></button>
        <label for="profiling-refresh-interval" class="visually-hidden">Profiling refresh interval</label>
        <select id="profiling-refresh-interval" class="form-select form-select-sm" style="width: 8.5rem">
            <option value="">Off</option>
            <option value="1000">1 sec</option>
            <option value="5000" selected>5 sec</option>
            <option value="10000">10 sec</option>
            <option value="15000">15 sec</option>
            <option value="30000">30 sec</option>
            <option value="60000">60 sec</option>
        </select>
        <button type="button" id="profiling-refresh-now" class="btn btn-outline-secondary btn-sm" aria-label="Refresh profiling dashboard now" title="Refresh now"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
    </div>
</div>

<div id="dashboard-profiling-content">
    @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard.Pages.Content>())
</div>

<div class="modal fade" id="profiling-chart-focus-modal" tabindex="-1" aria-labelledby="profiling-chart-focus-title" aria-hidden="true">
    <div class="modal-dialog profiling-chart-focus-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="profiling-chart-focus-title">Session charts</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body profiling-chart-focus-body">
                <section class="profiling-focused-panel" aria-labelledby="profiling-focused-memory-title">
                    <h3 id="profiling-focused-memory-title" class="h6 mb-1">Memory History</h3>
                    <div id="profiling-focused-memory-chart" class="profiling-focused-chart" role="img" aria-label="Focused Memory History chart"></div>
                </section>
                <section class="profiling-focused-panel" aria-labelledby="profiling-focused-gc-title">
                    <h3 id="profiling-focused-gc-title" class="h6 mb-1">GC Pressure History</h3>
                    <div id="profiling-focused-gc-chart" class="profiling-focused-chart" role="img" aria-label="Focused GC Pressure History chart"></div>
                </section>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="profiling-snapshot-focus-modal" tabindex="-1" aria-labelledby="profiling-snapshot-focus-title" aria-hidden="true">
    <div class="modal-dialog profiling-snapshot-focus-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title h5" id="profiling-snapshot-focus-title">Snapshot metrics</h2>
                    <div id="profiling-snapshot-focus-subtitle" class="small text-muted"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="profiling-snapshot-focus-content" class="modal-body profiling-snapshot-focus-content"></div>
        </div>
    </div>
</div>

<style>
    .profiling-panel { border-color: var(--dashboard-panel-border, var(--bs-border-color)); border-radius: 0; overflow: hidden; box-shadow: none; }
    .profiling-context-card { overflow: visible; }
    .profiling-context-card .form-label { margin-bottom: .2rem; color: var(--bs-secondary-color); font-size: .7rem; letter-spacing: .04em; text-transform: uppercase; }
    .profiling-sessions-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .55rem; border-bottom: 1px solid var(--dashboard-panel-border, var(--bs-border-color)); background: transparent; }
    .profiling-session-actions { display: flex; align-items: center; justify-content: flex-end; flex: 1 1 auto; flex-wrap: wrap; gap: .35rem; min-width: 0; }
    .profiling-marker-control { flex: 0 1 16rem; width: 16rem; min-width: 11rem; }
    .profiling-sessions-body[hidden] { display: none !important; }
    .profiling-tool-button { display: inline-flex; align-items: center; justify-content: center; width: 2.15rem; height: 2rem; padding: 0; }
    .profiling-compact-focus-button { width: 1.8rem; height: 1.8rem; font-size: .76rem; }
    .profiling-session-control { display: flex; align-items: flex-end; }
    .profiling-session-toggle { display: inline-flex; align-items: center; justify-content: center; width: 2.65rem; height: 2rem; padding: 0; border-width: 2px; border-radius: 0; background-image: none; font-size: 1.05rem; box-shadow: 0 0 0 2px color-mix(in srgb, currentColor 16%, transparent); transition: color .15s ease, background-color .15s ease, border-color .15s ease, box-shadow .15s ease, transform .15s ease; }
    .profiling-session-toggle:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 22%, transparent); }
    .profiling-session-toggle.is-running { animation: profiling-running-pulse 1.8s ease-in-out infinite; }
    @@keyframes profiling-running-pulse { 0%, 100% { box-shadow: 0 0 0 2px color-mix(in srgb, var(--bs-danger) 18%, transparent); } 50% { box-shadow: 0 0 0 4px color-mix(in srgb, var(--bs-danger) 28%, transparent); } }
    .profiling-stress-button.is-running { color: var(--bs-dark); background: var(--bs-warning); border-color: var(--bs-warning); }
    .profiling-tools-menu { position: relative; }
    .profiling-tools-menu > summary { list-style: none; cursor: pointer; }
    .profiling-tools-menu > summary::-webkit-details-marker { display: none; }
    .profiling-tools-menu[open] > summary { color: var(--bs-body-color); background: color-mix(in srgb, var(--bs-info) 16%, transparent); }
    .profiling-tools-popover { z-index: 15; position: absolute; top: calc(100% + .45rem); right: 0; width: min(22rem, calc(100vw - 2rem)); padding: .75rem; border: 1px solid var(--dashboard-panel-border-hover, var(--bs-border-color)); border-radius: 0; background: var(--bs-body-bg); box-shadow: 0 .8rem 2rem rgba(0, 0, 0, .32); }
    .profiling-tabs { display: flex; align-items: stretch; gap: .25rem; overflow-x: auto; border-bottom: 1px solid var(--bs-border-color); }
    .profiling-tab { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: .45rem; min-width: 8.5rem; padding: .65rem .9rem; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--bs-secondary-color); font-size: .82rem; font-weight: 650; letter-spacing: .02em; }
    .profiling-tab:hover { color: var(--bs-body-color); background: color-mix(in srgb, var(--bs-info) 6%, transparent); }
    .profiling-tab:focus-visible { z-index: 1; outline: 2px solid var(--bs-info); outline-offset: -2px; }
    .profiling-tab.is-active { border-bottom-color: var(--bs-info); color: var(--bs-body-color); background: transparent; }
    .profiling-tab-panel[hidden] { display: none; }
    .profiling-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--dashboard-panel-border, var(--bs-border-color)); background: transparent; }
    .profiling-vitals-grid { display: grid; grid-template-columns: repeat(7, minmax(8rem, 1fr)); gap: .55rem; }
    .profiling-vital { min-height: 7rem; display: flex; flex-direction: column; padding: .75rem; border: 1px solid var(--dashboard-panel-border, var(--bs-border-color)); border-radius: 0; background: transparent; }
    .profiling-vital > span { display: flex; align-items: center; gap: .3rem; color: var(--bs-secondary-color); font-size: .72rem; letter-spacing: .035em; text-transform: uppercase; }
    .profiling-vital > strong { margin: auto 0 .2rem; font-size: 1.18rem; font-weight: 600; line-height: 1.1; overflow-wrap: anywhere; }
    .profiling-vital > small { color: var(--bs-secondary-color); line-height: 1.2; }
    .profiling-info { display: inline-flex; align-items: center; justify-content: center; width: 1.15rem; height: 1.15rem; padding: 0; border: 0; border-radius: 0; background: transparent; color: var(--bs-info); font-size: .8rem; line-height: 1; vertical-align: text-bottom; }
    .profiling-info:hover, .profiling-info:focus-visible { color: var(--bs-body-color); background: color-mix(in srgb, var(--bs-info) 18%, transparent); outline: 2px solid color-mix(in srgb, var(--bs-info) 45%, transparent); outline-offset: 1px; }
    .profiling-tooltip { z-index: 1090; position: fixed; width: min(20rem, calc(100vw - 1rem)); padding: .55rem .65rem; border: 1px solid var(--dashboard-panel-border-hover, var(--bs-border-color)); border-radius: 0; background: var(--bs-emphasis-color); color: var(--bs-body-bg); box-shadow: 0 .5rem 1.4rem rgba(0, 0, 0, .24); font-size: .78rem; font-weight: 400; line-height: 1.35; letter-spacing: normal; text-align: left; text-transform: none; pointer-events: none; }
    .profiling-snapshot-controls { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: .4rem; min-width: 0; }
    .profiling-snapshot-picker { width: min(31rem, 52vw); }
    .profiling-snapshot-body[hidden] { display: none !important; }
    .profiling-context-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: .75rem; }
    .profiling-context-grid span { min-width: 0; }
    .profiling-context-grid small, .profiling-context-grid strong { display: block; }
    .profiling-context-grid small { color: var(--bs-secondary-color); text-transform: uppercase; font-size: .65rem; letter-spacing: .08em; }
    .profiling-context-grid strong { margin-top: .2rem; font-size: .82rem; overflow-wrap: anywhere; }
    .profiling-chart-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(34rem, 100%), 1fr)); gap: .75rem; }
    .profiling-chart-panel { min-width: 0; }
    .profiling-primary-chart { width: 100%; height: 25rem; min-height: 20rem; }
    .profiling-chart-focus-dialog { width: calc(100vw - 2rem); max-width: none; height: calc(100vh - 2rem); margin: 1rem; }
    .profiling-chart-focus-dialog .modal-content { height: 100%; border-radius: 0; }
    .profiling-chart-focus-body { display: grid; grid-template-rows: repeat(2, minmax(0, 1fr)); gap: .65rem; min-height: 0; padding: .75rem; }
    .profiling-focused-panel { display: grid; grid-template-rows: auto minmax(0, 1fr); min-width: 0; min-height: 0; padding: .5rem; border: 1px solid var(--dashboard-panel-border, var(--bs-border-color)); }
    .profiling-focused-chart { width: 100%; min-width: 0; min-height: 13rem; height: 100%; }
    .profiling-snapshot-focus-dialog { width: calc(100vw - 2rem); max-width: none; height: calc(100vh - 2rem); margin: 1rem; }
    .profiling-snapshot-focus-dialog .modal-content { height: 100%; border-radius: 0; }
    .profiling-snapshot-focus-content { overflow-y: auto; }
    .profiling-snapshot-metric-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(26rem, 100%), 1fr)); gap: .75rem; align-items: start; }
    .profiling-snapshot-metric-group { min-width: 0; border: 1px solid var(--dashboard-panel-border, var(--bs-border-color)); }
    .profiling-snapshot-metric-group > h3 { margin: 0; padding: .55rem .7rem; border-bottom: 1px solid var(--dashboard-panel-border, var(--bs-border-color)); color: var(--bs-info); font-size: .75rem; letter-spacing: .06em; text-transform: uppercase; }
    .profiling-snapshot-metric-list { margin: 0; }
    .profiling-snapshot-metric-row { display: grid; grid-template-columns: minmax(11rem, 1fr) minmax(8rem, auto); gap: 1rem; align-items: center; min-height: 2.5rem; padding: .4rem .7rem; border-bottom: 1px solid color-mix(in srgb, var(--bs-border-color) 58%, transparent); }
    .profiling-snapshot-metric-row:last-child { border-bottom: 0; }
    .profiling-snapshot-metric-row dt { min-width: 0; color: var(--bs-secondary-color); font-size: .72rem; font-weight: 500; }
    .profiling-snapshot-metric-row dt > span { display: flex; align-items: center; gap: .3rem; }
    .profiling-snapshot-metric-row dt code { display: block; margin-top: .08rem; color: var(--bs-secondary-color); font-size: .62rem; font-weight: 400; }
    .profiling-snapshot-metric-row dd { margin: 0; overflow-wrap: anywhere; color: var(--bs-body-color); font-variant-numeric: tabular-nums; font-weight: 650; text-align: right; }
    .profiling-chart-filters { padding: .55rem .75rem; border: 1px dashed var(--bs-border-color); font-size: .8rem; }
    .profiling-analysis-summary { list-style: none; cursor: pointer; user-select: none; }
    .profiling-analysis-summary::-webkit-details-marker { display: none; }
    .profiling-analysis-result { border: 1px solid var(--dashboard-panel-border, var(--bs-border-color)); }
    .profiling-analysis-result .profiling-analysis-inner { padding: .75rem; background: transparent; }
    .profiling-signal { padding: .65rem .75rem; margin-top: .55rem; border: 1px solid var(--dashboard-panel-border, var(--bs-border-color)); }
    .profiling-signal-title { display: flex; align-items: center; flex-wrap: wrap; gap: .35rem; }
    .profiling-evidence { display: inline-flex; align-items: center; gap: .2rem; margin: .25rem .35rem 0 0; padding: .18rem .35rem; border: 1px solid var(--bs-border-color); border-radius: 0; background: transparent; }
    .profiling-kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: .4rem; margin-top: .65rem; }
    .profiling-kpi { padding: .45rem .55rem; border: 1px solid var(--bs-border-color); font-size: .74rem; }
    .profiling-kpi-label { display: flex; align-items: center; gap: .25rem; color: var(--bs-secondary-color); }
    .profiling-kpi strong { display: block; margin-top: .2rem; }
    .profiling-metric-name { display: flex; align-items: center; gap: .3rem; font-weight: 600; }
    .profiling-technical-name { display: block; margin-top: .15rem; color: var(--bs-secondary-color); font-size: .68rem; font-weight: 400; }
    .profiling-empty { padding: .9rem; border: 1px dashed var(--bs-border-color); color: var(--bs-secondary-color); font-size: .85rem; }
    .profiling-workbench table { font-size: .78rem; }
    .profiling-workbench code { color: var(--bs-info); }
    @@media (max-width: 1399.98px) { .profiling-vitals-grid { grid-template-columns: repeat(4, minmax(9rem, 1fr)); } .profiling-context-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @@media (max-width: 767.98px) { .profiling-session-actions { flex-basis: 100%; justify-content: flex-start; } .profiling-marker-control { flex: 1 1 14rem; width: auto; } .profiling-vitals-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .profiling-context-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .profiling-primary-chart { height: 20rem; } .profiling-panel-header { align-items: flex-start; flex-wrap: wrap; } .profiling-snapshot-controls, .profiling-snapshot-picker { width: 100%; } .profiling-tab { min-width: 7.5rem; } .profiling-chart-focus-dialog, .profiling-snapshot-focus-dialog { width: 100vw; height: 100vh; margin: 0; } .profiling-chart-focus-body { grid-template-rows: repeat(2, minmax(18rem, 1fr)); overflow-y: auto; } .profiling-snapshot-metric-row { grid-template-columns: 1fr; gap: .2rem; } .profiling-snapshot-metric-row dd { text-align: left; } }
    @@media (max-width: 420px) { .profiling-vitals-grid, .profiling-context-grid { grid-template-columns: 1fr; } }
</style>

<script>
    (() => {
        const storage = {
            refresh: 'bdk.dashboard.profiling.refreshInterval',
            session: 'bdk.dashboard.profiling.session',
            node: 'bdk.dashboard.profiling.node',
            filters: 'bdk.dashboard.profiling.filters',
            live: 'bdk.dashboard.profiling.liveAnalysis',
            tab: 'bdk.dashboard.profiling.activeTab',
            sessions: 'bdk.dashboard.profiling.sessionsExpanded',
            snapshotDetails: 'bdk.dashboard.profiling.snapshotDetailsExpanded'
        };
        const state = {
            root: null,
            data: null,
            refresher: null,
            analysisInFlight: false,
            lastObservedSnapshot: null,
            observationScope: null,
            sessionAnalysis: null,
            pairAnalysis: null,
            comparison: null,
            lastOutcome: null,
            stressTimeout: null,
            copyFeedbackTimeout: null,
            copyFeedbackUntil: 0,
            chartSpecs: null,
            chartRenderVersion: 0,
            chartRenderPromise: Promise.resolve()
        };

        const plotlyConfig = Object.freeze({ displayModeBar: true, displaylogo: false, responsive: true, scrollZoom: false });

        const escapeHtml = value => String(value ?? '').replace(/[&<>'"]/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]);
        const display = value => value === null || value === undefined || value === '' ? 'unavailable' : String(value);
        const formatNumber = value => value === null || value === undefined ? 'unavailable' : Number(value).toLocaleString(undefined, { maximumFractionDigits: 2 });
        const enumName = (value, names) => typeof value === 'number' ? (names[value] || String(value)) : display(value);

        const profilingGlossary = Object.freeze({
            'snapshot-key': 'Readable identity of this immutable snapshot.',
            'session-key': 'Readable identity of the profiling session that owns this snapshot.',
            'node-key': 'Readable identity of the process node that captured this snapshot.',
            'timestamp': 'Browser-local date and time at which this snapshot capture began.',
            'host-name': 'Machine name reported by the process that captured this snapshot.',
            'process-id': 'Operating-system process identifier for the captured application instance.',
            'sequence': 'The capture order within this node. A gap can indicate a skipped or failed capture.',
            'scheduled-elapsed': 'Time from session start to when this snapshot was scheduled.',
            'capture-started-elapsed': 'Time from session start to when measurement actually began.',
            'capture-duration': 'Time spent collecting this snapshot. Large values can add measurement overhead.',
            'sampling-delay': 'Delay between the scheduled capture time and the actual capture start.',
            'skipped-capture-count': 'Cumulative captures skipped because a previous capture was still running or collection could not start.',
            'failed-capture-count': 'Cumulative snapshot captures that ended in failure.',
            'cpu-usage': 'Process CPU utilization during the interval, normalized across the available logical processors.',
            'process-cpu-duration': 'Cumulative processor time consumed by the process.',
            'logical-processor-count': 'Logical processors used to normalize process CPU utilization.',
            'working-set': 'Physical memory pages currently resident for this process. The operating system can reclaim some of them.',
            'private-memory': 'Committed process memory that cannot be shared with other processes. This includes managed and native memory.',
            'managed-memory': 'Managed bytes currently reported by the runtime for live .NET objects.',
            'total-physical-memory': 'Total physical memory installed or available to the operating system.',
            'available-physical-memory': 'Physical memory currently available to the operating system.',
            'used-physical-memory': 'Machine physical memory currently in use.',
            'managed-heap-size': 'Current size of the managed garbage-collected heap.',
            'fragmented': 'Managed heap bytes left in free regions between live objects.',
            'heap-fragmentation': 'Fragmented managed heap bytes as a percentage of heap size.',
            'memory-load': 'Runtime estimate of the physical memory load relevant to garbage collection.',
            'total-available-memory': 'Runtime estimate of memory available before stronger GC pressure is expected.',
            'high-memory-load-threshold': 'Runtime threshold at which memory load is considered high.',
            'total-committed': 'Memory committed by the runtime for managed heaps and related GC structures.',
            'total-allocated': 'Cumulative managed bytes allocated since process start. This only increases unless the process or counter resets.',
            'allocation-rate': 'Managed allocation throughput per second. A high rate can cause frequent garbage collections even when heap size stays stable.',
            'memory-pressure': 'Runtime memory load as a percentage of its available-memory estimate.',
            'gen0-collection-count': 'Cumulative generation 0 collections, primarily reclaiming short-lived objects.',
            'gen1-collection-count': 'Cumulative generation 1 collections, reclaiming objects that survived generation 0.',
            'gen2-collection-count': 'Cumulative full generation 2 collections, including older long-lived objects.',
            'latest-gc-index': 'Sequence number of the latest directly observed garbage collection.',
            'latest-gc-generation': 'Highest generation collected by the latest directly observed garbage collection.',
            'latest-gc-managed-heap': 'Managed heap size measured immediately after the latest directly observed garbage collection.',
            'latest-gc-loh': 'Large Object Heap size measured immediately after the latest directly observed garbage collection.',
            'latest-gc-compacting': 'Whether the latest directly observed garbage collection compacted surviving objects.',
            'latest-gc-concurrent': 'Whether the latest directly observed garbage collection ran concurrently with application work.',
            'latest-gen2-gc-index': 'Sequence number of the latest directly observed full generation 2 collection.',
            'latest-gen2-managed-heap': 'Managed heap remaining immediately after the latest directly observed generation 2 collection. Persistent growth here is stronger retention evidence.',
            'latest-gen2-loh': 'Large Object Heap remaining immediately after the latest directly observed generation 2 collection.',
            'latest-gen2-gc-compacting': 'Whether the latest directly observed generation 2 collection compacted surviving objects.',
            'latest-gen2-gc-concurrent': 'Whether the latest directly observed generation 2 collection ran concurrently with application work.',
            'cumulative-gc-pause': 'Cumulative time application threads were paused for garbage collection.',
            'gc-pause': 'Share of the measured interval spent paused for garbage collection.',
            'pinned-object-count': 'Managed objects pinned in place and unavailable for relocation by the garbage collector.',
            'finalization-pending-count': 'Objects waiting for their finalizers to execute.',
            'loh-size': 'Current size of the Large Object Heap, normally used for objects of about 85 KB or larger.',
            'loh-fragmented': 'Free fragmented bytes inside the Large Object Heap.',
            'loh-fragmentation': 'Fragmented Large Object Heap bytes as a percentage of LOH size.',
            'server-garbage-collection': 'Whether the process uses server GC instead of workstation GC.',
            'garbage-collection-latency-mode': 'Current .NET garbage-collector latency mode for this process.',
            'process-handle-count': 'Operating-system handles currently held by the process.',
            'process-thread-count': 'Operating-system threads currently owned by the process.',
            'thread-pool-thread-count': 'Worker threads currently managed by the .NET thread pool.',
            'thread-pool-completed-work-item-count': 'Cumulative work items completed by the .NET thread pool.',
            'thread-pool-pending-work-item-count': 'Work items queued and waiting for a .NET thread-pool worker.',
            'thread-pool-available-worker-thread-count': 'Additional worker threads the thread pool can make available.',
            'thread-pool-available-completion-port-thread-count': 'Additional asynchronous I/O completion threads the thread pool can make available.',
            'active-tcp-connection-count': 'TCP connections currently active for the machine.',
            'tcp-listener-count': 'TCP endpoints currently listening for incoming connections.',
            'udp-listener-count': 'UDP endpoints currently bound and listening.',
            'total-used-socket-count': 'Combined operating-system socket count currently in use.',
            'sampling-coverage': 'Successful captures as a percentage of expected captures in the evaluated window.',
            'capture-overhead-p95': 'At least 95% of captures used no more than this percentage of the configured sampling interval.',
            'capture-duration-p95': 'At least 95% of snapshot captures completed within this duration.',
            'sampling-delay-p95': 'At least 95% of snapshots started within this delay from their scheduled time.',
            'skipped-captures': 'Captures skipped during the evaluated window.',
            'failed-captures': 'Captures that failed during the evaluated window.'
        });

        const profilingConcepts = Object.freeze({
            'cpu': 'process CPU utilization',
            'managed-heap': 'managed garbage-collected heap size',
            'private-memory': 'private committed process memory',
            'loh-fragmentation': 'Large Object Heap fragmentation',
            'heap-fragmentation': 'managed heap fragmentation',
            'loh': 'Large Object Heap size',
            'allocation': 'managed allocation throughput',
            'gc-pause': 'garbage-collection pause burden',
            'gen0': 'generation 0 garbage collections',
            'gen1': 'generation 1 garbage collections',
            'gen2': 'full generation 2 garbage collections'
        });

        const humanizeIdentifier = value => {
            const acronyms = { cpu: 'CPU', gc: 'GC', loh: 'LOH', p95: 'P95', tcp: 'TCP', udp: 'UDP', gen0: 'Gen0', gen1: 'Gen1', gen2: 'Gen2' };
            const parts = String(value ?? '').split('-').filter(Boolean).map(part => acronyms[part] || part);
            if (!parts.length) return 'Unknown metric';
            const label = parts.join(' ');
            return `${label.charAt(0).toUpperCase()}${label.slice(1)}`;
        };

        function descriptionFor(identifier) {
            if (profilingGlossary[identifier]) return profilingGlossary[identifier];
            const concept = Object.entries(profilingConcepts).find(([prefix]) => identifier === prefix || identifier.startsWith(`${prefix}-`));
            if (concept) {
                const [, meaning] = concept;
                if (identifier.endsWith('-average')) return `Time-weighted average ${meaning} across the evaluated window.`;
                if (identifier.endsWith('-peak')) return `Highest observed ${meaning} in the evaluated window.`;
                if (identifier.endsWith('-ending') || identifier.endsWith('-end')) return `${humanizeIdentifier(identifier)} at the end of the evaluated window.`;
                if (identifier.endsWith('-start')) return `${humanizeIdentifier(identifier)} at the beginning of the evaluated window.`;
                if (identifier.endsWith('-change-percent')) return `Percentage change in ${meaning} from the beginning to the end of the evaluated window.`;
                if (identifier.endsWith('-change')) return `End value minus start value for ${meaning}.`;
                if (identifier.endsWith('-count-delta')) return `Number of additional ${meaning} observed in the evaluated window.`;
                if (identifier.endsWith('-rate')) return `Average ${meaning} per second in the evaluated window.`;
                return `Evidence about ${meaning} used by a fixed Profiling evaluation rule.`;
            }

            if (identifier.endsWith('-threshold') || identifier.endsWith('-floor')) return 'Built-in rule boundary shown so the signal can be verified against its evidence.';
            if (identifier.endsWith('-ratio')) return 'Share of the evaluated time intervals that met the rule condition.';
            if (identifier.endsWith('-delta')) return 'Later value minus earlier value in the evaluated window.';
            return `Captured evidence for ${humanizeIdentifier(identifier).toLowerCase()}.`;
        }

