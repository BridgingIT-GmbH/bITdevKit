        function formatSnapshotMetric(value, format) {
            if (value === null || value === undefined || value === '') return 'unavailable';
            if (format === 'timestamp') {
                const date = new Date(value);
                return Number.isNaN(date.getTime()) ? 'unavailable' : date.toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'long' });
            }
            if (format === 'bytes' || format === 'rate') {
                const bytes = Number(value);
                if (!Number.isFinite(bytes)) return 'unavailable';
                const units = [[1073741824, 'GiB'], [1048576, 'MiB'], [1024, 'KiB']];
                const unit = units.find(([threshold]) => Math.abs(bytes) >= threshold);
                const formatted = unit
                    ? `${(bytes / unit[0]).toLocaleString(undefined, { maximumFractionDigits: unit[0] === 1073741824 ? 2 : 1 })} ${unit[1]}`
                    : `${bytes.toLocaleString(undefined, { maximumFractionDigits: 0 })} B`;
                return format === 'rate' ? `${formatted}/s` : formatted;
            }
            if (format === 'percent') return `${Number(value).toLocaleString(undefined, { maximumFractionDigits: 1 })}%`;
            if (format === 'number') return Number(value).toLocaleString();
            if (format === 'boolean') return value ? 'Yes' : 'No';
            if (format === 'gc-mode') return value ? 'Server' : 'Workstation';
            return display(value);
        }

        let profilingTooltip = null;
        function showProfilingTooltip(control) {
            if (!control?.dataset.description) return;
            profilingTooltip?.remove();
            profilingTooltip = document.createElement('div');
            profilingTooltip.className = 'profiling-tooltip';
            profilingTooltip.setAttribute('role', 'tooltip');
            profilingTooltip.textContent = control.dataset.description;
            document.body.appendChild(profilingTooltip);
            const controlBounds = control.getBoundingClientRect();
            const tooltipBounds = profilingTooltip.getBoundingClientRect();
            const centered = controlBounds.left + controlBounds.width / 2 - tooltipBounds.width / 2;
            profilingTooltip.style.left = `${Math.max(8, Math.min(window.innerWidth - tooltipBounds.width - 8, centered))}px`;
            const below = controlBounds.bottom + 8;
            profilingTooltip.style.top = `${below + tooltipBounds.height <= window.innerHeight - 8 ? below : Math.max(8, controlBounds.top - tooltipBounds.height - 8)}px`;
            control.setAttribute('aria-describedby', 'profiling-active-tooltip');
            profilingTooltip.id = 'profiling-active-tooltip';
        }

        function hideProfilingTooltip(control) {
            control?.removeAttribute('aria-describedby');
            profilingTooltip?.remove();
            profilingTooltip = null;
        }

        document.addEventListener('mouseover', event => {
            const control = event.target.closest?.('.profiling-info');
            if (control && !control.contains(event.relatedTarget)) showProfilingTooltip(control);
        });
        document.addEventListener('mouseout', event => {
            const control = event.target.closest?.('.profiling-info');
            if (control && !control.contains(event.relatedTarget)) hideProfilingTooltip(control);
        });
        document.addEventListener('focusin', event => {
            const control = event.target.closest?.('.profiling-info');
            if (control) showProfilingTooltip(control);
        });
        document.addEventListener('focusout', event => {
            const control = event.target.closest?.('.profiling-info');
            if (control) hideProfilingTooltip(control);
        });
        document.addEventListener('click', event => {
            const control = event.target.closest?.('.profiling-info');
            if (!control) return;
            event.preventDefault();
            event.stopPropagation();
            showProfilingTooltip(control);
        });
        window.addEventListener('scroll', () => hideProfilingTooltip(document.querySelector('.profiling-info[aria-describedby]')), { passive: true });
        window.addEventListener('resize', () => hideProfilingTooltip(document.querySelector('.profiling-info[aria-describedby]')));

        function decodePayload(value) {
            if (!value) return null;
            try {
                const bytes = Uint8Array.from(atob(value), character => character.charCodeAt(0));
                return JSON.parse(new TextDecoder().decode(bytes));
            } catch { return null; }
        }

        function problemText(payload, fallback) {
            return payload?.detail || payload?.title || fallback;
        }

        async function request(url, method = 'GET', body = undefined) {
            if (!url) throw new Error('The requested action is unavailable for the current selection.');
            const response = await fetch(url, {
                method,
                cache: 'no-store',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' },
                body: body === undefined ? undefined : JSON.stringify(body)
            });
            const text = await response.text();
            let payload = null;
            try { payload = text ? JSON.parse(text) : null; } catch { payload = text; }
            if (!response.ok) throw new Error(problemText(payload, `Request failed (${response.status}).`));
            return payload;
        }

        async function importArchive(form) {
            const response = await fetch(state.root?.dataset.archiveImportPath, {
                method: 'POST',
                cache: 'no-store',
                headers: { 'X-Requested-With': 'fetch' },
                body: new FormData(form)
            });
            const text = await response.text();
            let payload = null;
            try { payload = text ? JSON.parse(text) : null; } catch { payload = text; }
            if (!response.ok) throw new Error(problemText(payload, `Import failed (${response.status}).`));
            return payload;
        }

        function showOutcome(message, kind = 'info') {
            state.lastOutcome = { message, kind };
            const target = document.querySelector('#profiling-action-outcomes');
            if (target) target.innerHTML = `<div class="alert alert-${kind} py-2 mb-2">${escapeHtml(message)}</div>`;
        }

        function summarizeControl(payload, label) {
            const outcomes = payload?.nodeOutcomes || [];
            if (!outcomes.length) return label;
            return `${label} ${outcomes.map(item => `${item.nodeKey}: ${item.outcome}`).join(' · ')}`;
        }

        function toTimeSpan(milliseconds) {
            const totalMilliseconds = Math.max(0, Math.round(Number(milliseconds) || 0));
            const days = Math.floor(totalMilliseconds / 86400000);
            const withinDay = totalMilliseconds % 86400000;
            const hours = Math.floor(withinDay / 3600000).toString().padStart(2, '0');
            const minutes = Math.floor((withinDay % 3600000) / 60000).toString().padStart(2, '0');
            const seconds = Math.floor((withinDay % 60000) / 1000).toString().padStart(2, '0');
            const fractionMilliseconds = withinDay % 1000;
            const dayPrefix = days > 0 ? `${days}.` : '';
            const fraction = fractionMilliseconds > 0
                ? `.${fractionMilliseconds.toString().padStart(3, '0')}0000`
                : '';
            return `${dayPrefix}${hours}:${minutes}:${seconds}${fraction}`;
        }

        function formatLocalSnapshotTimestamp(value) {
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return 'invalid date';
            const pad = (part, length = 2) => String(part).padStart(length, '0');
            return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}`;
        }

        function localizeSnapshotOptions() {
            document.querySelectorAll('[data-profiling-snapshot-option]').forEach(option => {
                option.textContent = `#${option.dataset.sequence} · ${formatLocalSnapshotTimestamp(option.dataset.timestampUtc)} · ${option.dataset.key}`;
            });
        }

        function inspectedSnapshot() {
            const selectedKey = state.root?.dataset.snapshotKey;
            return selectedKey
                ? state.data?.snapshots?.find(item => item.identity?.key === selectedKey)
                : state.data?.latestSnapshot;
        }

        function synchronizeSnapshotCopyFeedback() {
            if (Date.now() >= state.copyFeedbackUntil) return;
            const button = document.querySelector('#profiling-copy-snapshot');
            if (!button) return;
            button.disabled = true;
            button.innerHTML = '<i class="bi bi-check2 me-1" aria-hidden="true"></i>Copied';
        }

        function showSnapshotCopiedFeedback() {
            window.clearTimeout(state.copyFeedbackTimeout);
            state.copyFeedbackUntil = Date.now() + 1200;
            synchronizeSnapshotCopyFeedback();
            state.copyFeedbackTimeout = window.setTimeout(() => {
                state.copyFeedbackUntil = 0;
                const button = document.querySelector('#profiling-copy-snapshot');
                if (!button) return;
                button.innerHTML = '<i class="bi bi-copy me-1" aria-hidden="true"></i>Copy JSON';
                button.disabled = !inspectedSnapshot();
            }, 1200);
        }

        function renderSnapshotFocus() {
            const snapshot = inspectedSnapshot();
            const content = document.querySelector('#profiling-snapshot-focus-content');
            const subtitle = document.querySelector('#profiling-snapshot-focus-subtitle');
            if (!content || !subtitle) return false;
            if (!snapshot) {
                subtitle.textContent = '';
                content.innerHTML = '<div class="profiling-empty">No snapshot is available.</div>';
                return false;
            }

            subtitle.textContent = `#${snapshot.sequence} · ${formatLocalSnapshotTimestamp(snapshot.timestampUtc)} · ${snapshot.identity?.key || 'unavailable'}`;
            content.innerHTML = `<div class="profiling-snapshot-metric-groups">${snapshotMetricGroups.map(group => `
                <section class="profiling-snapshot-metric-group">
                    <h3>${escapeHtml(group.title)}</h3>
                    <dl class="profiling-snapshot-metric-list">${group.metrics.map(([identifier, label, getValue, format]) => {
                        const description = descriptionFor(identifier);
                        return `<div class="profiling-snapshot-metric-row"><dt><span>${escapeHtml(label)} ${infoHtml(description, label)}</span><code>${escapeHtml(identifier)}</code></dt><dd>${escapeHtml(formatSnapshotMetric(getValue(snapshot), format))}</dd></div>`;
                    }).join('')}</dl>
                </section>`).join('')}</div>`;
            return true;
        }

        function openSnapshotFocus() {
            const modal = document.querySelector('#profiling-snapshot-focus-modal');
            if (!modal || !renderSnapshotFocus()) {
                showOutcome('No snapshot is available to focus.', 'warning');
