        function setSnapshotDetailsExpanded(expanded, persist = false) {
            const toggle = document.querySelector('#profiling-toggle-snapshot-details');
            const body = document.querySelector('#profiling-current-snapshot-body');
            if (!toggle || !body) return;
            body.hidden = !expanded;
            toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
            toggle.title = expanded ? 'Collapse snapshot details' : 'Expand snapshot details';
            toggle.setAttribute('aria-label', toggle.title);
            const icon = toggle.querySelector('i');
            if (icon) icon.className = `bi bi-chevron-${expanded ? 'up' : 'down'}`;
            if (persist) localStorage.setItem(storage.snapshotDetails, expanded ? 'true' : 'false');
        }

        function setSessionsExpanded(expanded, persist = false) {
            const toggle = document.querySelector('#profiling-toggle-sessions');
            const body = document.querySelector('#profiling-sessions-body');
            if (!toggle || !body) return;
            body.hidden = !expanded;
            toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
            toggle.title = expanded ? 'Collapse sessions' : 'Expand sessions';
            toggle.setAttribute('aria-label', toggle.title);
            const icon = toggle.querySelector('i');
            if (icon) icon.className = `bi bi-chevron-${expanded ? 'up' : 'down'}`;
            if (persist) localStorage.setItem(storage.sessions, expanded ? 'true' : 'false');
        }

        async function copyText(value) {
            if (navigator.clipboard?.writeText) {
                try {
                    await navigator.clipboard.writeText(value);
                    return true;
                } catch {
                    // Fall through for browsers that block the async clipboard API.
                }
            }

            const textarea = document.createElement('textarea');
            textarea.value = value;
            textarea.setAttribute('readonly', '');
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            const copied = document.execCommand('copy');
            textarea.remove();
            return copied;
        }

        function selectedContextUrl(session, node) {
            const pagePath = state.root?.dataset.pagePath || window.location.pathname;
            const url = new URL(pagePath, window.location.origin);
            if (session) url.searchParams.set('session', session);
            if (node) url.searchParams.set('node', node);
            return url;
        }

        async function selectContext(session, node) {
            if (session) localStorage.setItem(storage.session, session); else localStorage.removeItem(storage.session);
            if (node) localStorage.setItem(storage.node, node); else localStorage.removeItem(storage.node);
            history.replaceState({}, '', selectedContextUrl(session, node));
            state.lastObservedSnapshot = null;
            state.observationScope = null;
            state.sessionAnalysis = null;
            state.pairAnalysis = null;
            state.comparison = null;
            await state.refresher?.refresh(true);
        }

        async function selectSnapshot(snapshot) {
            const url = new URL(window.location.href);
            if (snapshot) url.searchParams.set('snapshot', snapshot); else url.searchParams.delete('snapshot');
            history.replaceState({}, '', url);
            if (document.activeElement?.closest?.('#profiling-current-snapshot')) document.activeElement.blur();
            await state.refresher?.refresh(true);
        }

        function buildContentUrl() {
            const root = document.querySelector('#profiling-dashboard-data') || state.root;
            const url = new URL(root?.dataset.contentPath || window.location.pathname, window.location.origin);
            const page = new URL(window.location.href);
            const session = page.searchParams.get('session') || root?.dataset.sessionKey;
            const node = page.searchParams.get('node') || root?.dataset.nodeKey;
            const snapshot = page.searchParams.get('snapshot');
            if (session) url.searchParams.set('session', session);
            if (node) url.searchParams.set('node', node);
            if (snapshot) url.searchParams.set('snapshot', snapshot);
            return url;
        }

        function synchronizeAttributes(current, next, dataOnly = false) {
            const included = attribute => !dataOnly || attribute.name.startsWith('data-');
            Array.from(current.attributes)
                .filter(attribute => included(attribute) && attribute.name !== 'id')
                .forEach(attribute => current.removeAttribute(attribute.name));
            Array.from(next.attributes)
                .filter(attribute => included(attribute) && attribute.name !== 'id')
                .forEach(attribute => current.setAttribute(attribute.name, attribute.value));
        }

        function synchronizeSelect(nextRoot, selector, preferredValue) {
            const current = document.querySelector(selector);
            const next = nextRoot.querySelector(selector);
            if (!current || !next) return;
            if (preferredValue === undefined && current === document.activeElement) return;
            const value = preferredValue === undefined ? current.value : preferredValue;
            current.replaceChildren(...Array.from(next.options, option => option.cloneNode(true)));
            if (Array.from(current.options).some(option => option.value === value)) current.value = value;
            else current.value = next.value;
        }

        function updateRegion(current, next) {
            if (!current || !next || current.contains(document.activeElement)) return;
            const selections = new Map(Array.from(current.querySelectorAll('select[id]'), select => [select.id, select.value]));
            synchronizeAttributes(current, next);
            current.replaceChildren(...Array.from(next.childNodes, child => child.cloneNode(true)));
            selections.forEach((value, id) => {
                const select = current.querySelector(`#${id}`);
                if (select && Array.from(select.options).some(option => option.value === value)) select.value = value;
            });
        }

        function updateContextRegion(nextRoot, selector) {
            const current = document.querySelector(selector);
            const next = nextRoot.querySelector(selector);
            if (current && next) {
                synchronizeAttributes(current, next);
                current.replaceChildren(...Array.from(next.childNodes, child => child.cloneNode(true)));
            }
        }

        function applyContentRefresh(contentElement, responseText) {
            const scrollPosition = { x: window.scrollX, y: window.scrollY };
            const template = document.createElement('template');
            template.innerHTML = responseText.trim();
            const nextRoot = template.content.querySelector('#profiling-dashboard-data');
            const currentRoot = document.querySelector('#profiling-dashboard-data');
            if (!nextRoot || !currentRoot) throw new Error('The Profiling refresh response is incomplete.');

            const currentScope = `${currentRoot.dataset.sessionKey || ''}/${currentRoot.dataset.nodeKey || ''}`;
            const nextScope = `${nextRoot.dataset.sessionKey || ''}/${nextRoot.dataset.nodeKey || ''}`;
            const contextChanged = currentScope !== nextScope;
            const snapshotChanged = (currentRoot.dataset.snapshotKey || '') !== (nextRoot.dataset.snapshotKey || '');
            synchronizeAttributes(currentRoot, nextRoot, true);

            synchronizeSelect(nextRoot, '#profiling-session-select', contextChanged ? nextRoot.dataset.sessionKey || '' : undefined);
            synchronizeSelect(nextRoot, '#profiling-node-select', contextChanged ? nextRoot.dataset.nodeKey || '' : undefined);
            synchronizeSelect(nextRoot, '#profiling-snapshot-a', contextChanged ? '' : undefined);
            synchronizeSelect(nextRoot, '#profiling-snapshot-b', contextChanged ? '' : undefined);

            nextRoot.querySelectorAll('[data-profiling-live-region][id]').forEach(next => {
                updateRegion(document.getElementById(next.id), next);
            });

            if ((contextChanged || snapshotChanged) && document.activeElement?.id !== 'profiling-snapshot-select') {
                synchronizeSelect(nextRoot, '#profiling-snapshot-select', nextRoot.dataset.snapshotKey || '');
            }

            if (contextChanged) {
                ['#profiling-start-form', '#profiling-metadata-form', '#profiling-runtime-context', '#profiling-pair-validation', '#profiling-pair-analysis', '#profiling-delta-table tbody', '#profiling-session-analysis-result']
                    .forEach(selector => updateContextRegion(nextRoot, selector));
                state.sessionAnalysis = null;
                state.pairAnalysis = null;
                state.comparison = null;
                state.lastObservedSnapshot = null;
                state.observationScope = null;
            }
            window.scrollTo(scrollPosition.x, scrollPosition.y);
        }

        function getFilters() {
            try { return { phases: true, actions: true, segments: true, ...JSON.parse(localStorage.getItem(storage.filters) || '{}') }; }
            catch { return { phases: true, actions: true, segments: true }; }
        }

        function toPlotlyLocalTime(value) {
            if (!value) return value;
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return value;
            const offsetMilliseconds = date.getTimezoneOffset() * 60 * 1000;
            return new Date(date.getTime() - offsetMilliseconds).toISOString().replace(/Z$/, '');
        }

        function annotationLayers(data, selectedSnapshotKey, selectedColor) {
            const filters = getFilters();
            const shapes = [];
            const annotations = [];
            if (filters.segments) {
                (data?.segments || []).forEach((segment, index) => {
                    const started = toPlotlyLocalTime(segment.startedUtc);
                    const ended = toPlotlyLocalTime(segment.endedUtc || data?.latestSnapshot?.timestampUtc || segment.startedUtc);
                    const color = index % 2 ? '#fd971f' : '#66d9ef';
                    shapes.push({ type: 'rect', xref: 'x', yref: 'paper', x0: started, x1: ended, y0: 0, y1: 1, fillcolor: index % 2 ? 'rgba(253,151,31,.08)' : 'rgba(102,217,239,.08)', line: { width: 1, dash: 'dot', color: 'rgba(165,159,153,.55)' }, layer: 'below' });
                    annotations.push({ x: started, y: 0.98, xref: 'x', yref: 'paper', text: `SEGMENT · ${escapeHtml(segment.name)}`, showarrow: false, xanchor: 'left', yanchor: 'top', font: { size: 9, color }, bgcolor: 'rgba(0,0,0,.58)', borderpad: 2 });
                });
            }
            const addMarker = (marker, color, dash, prefix) => {
                const timestamp = toPlotlyLocalTime(marker.timestampUtc);
                shapes.push({ type: 'line', xref: 'x', yref: 'paper', x0: timestamp, x1: timestamp, y0: 0, y1: 1, line: { color, width: 1.4, dash } });
                annotations.push({ x: timestamp, y: 1.035, xref: 'x', yref: 'paper', text: `${prefix}${escapeHtml(marker.name)}`, showarrow: false, yanchor: 'bottom', textangle: -35, font: { size: 9, color } });
            };
            if (filters.phases) (data?.phaseMarkers || []).forEach(marker => addMarker(marker, '#fd971f', 'dash', 'PHASE · '));
            if (filters.actions) (data?.actionMarkers || []).forEach(marker => addMarker(marker, '#66d9ef', 'dot', 'ACTION · '));
            const selectedSnapshot = selectedSnapshotKey
                ? (data?.snapshots || []).find(item => item.identity?.key === selectedSnapshotKey)
                : null;
            if (selectedSnapshot) {
                const timestamp = toPlotlyLocalTime(selectedSnapshot.timestampUtc);
                shapes.push({ type: 'line', xref: 'x', yref: 'paper', x0: timestamp, x1: timestamp, y0: 0, y1: 1, line: { color: selectedColor, width: 2.5 } });
                annotations.push({ x: timestamp, y: 1.035, xref: 'x', yref: 'paper', text: `SELECTED · #${selectedSnapshot.sequence}`, showarrow: false, yanchor: 'bottom', textangle: -35, font: { size: 10, color: selectedColor } });
            }
            return { shapes, annotations };
        }

        function scheduleChartRender() {
            const renderVersion = ++state.chartRenderVersion;
            window.requestAnimationFrame(() => {
                state.chartRenderPromise = state.chartRenderPromise
                    .catch(() => undefined)
                    .then(() => renderCharts(renderVersion));
            });
        }

        async function renderCharts(renderVersion) {
            const memory = document.querySelector('#profiling-memory-chart');
            const gc = document.querySelector('#profiling-gc-chart');
            if (!memory || !gc) return;
            if (renderVersion !== state.chartRenderVersion) return;
            const data = state.data;
            const selectedSnapshotKey = state.root?.dataset.snapshotKey;
            try {
                const Plotly = await window.bdkDashboard.loadPlotly();
                if (renderVersion !== state.chartRenderVersion) return;
                if (!data?.snapshots?.length) {
                    state.chartSpecs = null;
                    Plotly.purge(memory);
                    Plotly.purge(gc);
                    memory.innerHTML = '<div class="profiling-empty m-3">No retained points are available.</div>';
                    gc.innerHTML = '<div class="profiling-empty m-3">No retained points are available.</div>';
                    if (document.querySelector('#profiling-chart-focus-modal.show')) await renderFocusedChart();
                    return;
                }
                const points = data.snapshots;
                const x = points.map(item => toPlotlyLocalTime(item.timestampUtc));
                const mb = values => values.map(value => value === null || value === undefined ? null : value / 1048576);
                const trace = (name, values, color, axis = 'y') => ({ name, x, y: values, type: 'scatter', mode: 'lines', connectgaps: false, yaxis: axis, line: { width: 1.7, color }, hovertemplate: `%{y:.2f}<extra>${name}</extra>` });
                const theme = window.bdkDashboard.getChartTheme();
                const layers = annotationLayers(data, selectedSnapshotKey, theme.danger);
                const memoryLayout = window.bdkDashboard.createPlotlyLayout({ margin: { l: 56, r: 22, t: 84, b: 58 }, showlegend: true, legend: { orientation: 'h', x: 0, y: -0.18 } });
                memoryLayout.dragmode = 'zoom';
                memoryLayout.yaxis.title = { text: 'MiB' };
                memoryLayout.xaxis.hoverformat = '%Y-%m-%d %H:%M:%S.%L';
                memoryLayout.shapes = layers.shapes;
                memoryLayout.annotations = layers.annotations;
                const memoryTraces = [
                    trace('Managed memory', mb(points.map(item => item.managedMemoryBytes)), theme.primary),
                    trace('Managed heap', mb(points.map(item => item.managedHeapSizeBytes)), theme.success),
                    trace('Private memory', mb(points.map(item => item.privateMemoryBytes)), theme.warning),
                    trace('Working set', mb(points.map(item => item.workingSetBytes)), theme.secondary),
                    trace('Committed', mb(points.map(item => item.totalCommittedBytes)), theme.info),
                    trace('LOH', mb(points.map(item => item.largeObjectHeapBytes)), theme.danger)
                ];
                const gcLayout = window.bdkDashboard.createPlotlyLayout({ margin: { l: 56, r: 64, t: 84, b: 58 }, showlegend: true, legend: { orientation: 'h', x: 0, y: -0.18 } });
                gcLayout.dragmode = 'zoom';
                gcLayout.yaxis.title = { text: 'Percent' };
                gcLayout.xaxis.hoverformat = '%Y-%m-%d %H:%M:%S.%L';
                gcLayout.yaxis.range = [0, 100];
                gcLayout.yaxis2 = { title: { text: 'MiB/s' }, overlaying: 'y', side: 'right', rangemode: 'tozero', showgrid: false, color: theme.muted };
                gcLayout.shapes = layers.shapes;
                gcLayout.annotations = layers.annotations;
                const gcTraces = [
                    trace('CPU', points.map(item => item.cpuUsagePercent), theme.primary),
                    trace('Memory pressure', points.map(item => item.memoryPressurePercent), theme.warning),
                    trace('Heap fragmentation', points.map(item => item.heapFragmentationPercent), theme.secondary),
                    trace('LOH fragmentation', points.map(item => item.largeObjectHeapFragmentationPercent), theme.danger),
                    trace('GC pause', points.map(item => item.gcPausePercent), theme.success),
                    trace('Allocation rate', points.map(item => item.allocationRateBytesPerSecond === null || item.allocationRateBytesPerSecond === undefined ? null : item.allocationRateBytesPerSecond / 1048576), theme.info, 'y2')
                ];
                state.chartSpecs = {
                    memory: { title: 'Memory History', ariaLabel: 'Focused Memory History chart', traces: memoryTraces, layout: memoryLayout },
                    gc: { title: 'GC Pressure History', ariaLabel: 'Focused GC Pressure History chart', traces: gcTraces, layout: gcLayout }
                };
                await Promise.all([
                    Plotly.react(memory, memoryTraces, memoryLayout, plotlyConfig),
                    Plotly.react(gc, gcTraces, gcLayout, plotlyConfig)
                ]);
                if (renderVersion === state.chartRenderVersion && document.querySelector('#profiling-chart-focus-modal.show')) await renderFocusedChart();
            } catch {
                if (renderVersion !== state.chartRenderVersion) return;
                state.chartSpecs = null;
                memory.innerHTML = '<div class="alert alert-warning m-3">The chart library could not be loaded.</div>';
                gc.innerHTML = '<div class="alert alert-warning m-3">The chart library could not be loaded.</div>';
            }
        }

        async function renderFocusedChart() {
            const memoryTarget = document.querySelector('#profiling-focused-memory-chart');
            const gcTarget = document.querySelector('#profiling-focused-gc-chart');
            const memorySpec = state.chartSpecs?.memory;
            const gcSpec = state.chartSpecs?.gc;
            if (!memoryTarget || !gcTarget) return;
            if (!memorySpec || !gcSpec) {
                memoryTarget.innerHTML = '<div class="profiling-empty m-3">No chart data is available.</div>';
                gcTarget.innerHTML = '<div class="profiling-empty m-3">No chart data is available.</div>';
                return;
            }
            try {
                const Plotly = await window.bdkDashboard.loadPlotly();
                const timeline = memorySpec.traces?.[0]?.x || [];
                const timelineRange = timeline.length > 1 ? [timeline[0], timeline[timeline.length - 1]] : null;
                const createLayout = spec => ({
                    ...spec.layout,
                    autosize: true,
                    margin: { ...spec.layout.margin, l: 70, r: 80, t: 66, b: 58 },
                    xaxis: { ...spec.layout.xaxis, ...(timelineRange ? { range: timelineRange, autorange: false } : {}) }
                });
                await Promise.all([
                    Plotly.react(memoryTarget, memorySpec.traces, createLayout(memorySpec), plotlyConfig),
                    Plotly.react(gcTarget, gcSpec.traces, createLayout(gcSpec), plotlyConfig)
                ]);
                synchronizeFocusedTimelines(Plotly, memoryTarget, gcTarget);
            } catch {
                memoryTarget.innerHTML = '<div class="alert alert-warning m-3">The focused charts could not be rendered.</div>';
                gcTarget.innerHTML = '<div class="alert alert-warning m-3">The focused charts could not be rendered.</div>';
            }
        }

        function synchronizeFocusedTimelines(Plotly, memoryTarget, gcTarget) {
            let synchronizing = false;
            const synchronize = (source, target) => {
                source.removeAllListeners?.('plotly_relayout');
                source.on?.('plotly_relayout', changes => {
                    if (synchronizing) return;
                    let update = null;
                    if (changes['xaxis.range[0]'] !== undefined && changes['xaxis.range[1]'] !== undefined) {
                        update = { 'xaxis.range[0]': changes['xaxis.range[0]'], 'xaxis.range[1]': changes['xaxis.range[1]'], 'xaxis.autorange': false };
                    } else if (changes['xaxis.autorange'] === true) {
                        update = { 'xaxis.autorange': true };
                    }
                    if (!update) return;
                    synchronizing = true;
                    Promise.resolve(Plotly.relayout(target, update)).finally(() => { synchronizing = false; });
                });
            };
            synchronize(memoryTarget, gcTarget);
            synchronize(gcTarget, memoryTarget);
        }

        function openFocusedChart() {
            const modal = document.querySelector('#profiling-chart-focus-modal');
            if (!modal || !state.chartSpecs?.memory || !state.chartSpecs?.gc) {
                showOutcome('No chart data is available to focus.', 'warning');
                return;
            }
            window.bootstrap.Modal.getOrCreateInstance(modal).show();
        }

        function renderAnalysis(targetSelector, result) {
            const target = document.querySelector(targetSelector);
            if (!target || !result) return;
            const quality = result.dataQuality || {};
            const signals = result.signals || [];
            const kpis = result.kpIs || result.kpis || [];
            const limitations = result.limitations || [];
            const sufficiency = enumName(quality.sufficiency, ['Collecting', 'Sufficient', 'Limited']);
            const headline = signals.length ? `${signals.length} evidence-backed signal${signals.length === 1 ? '' : 's'}` : (sufficiency === 'Collecting' ? 'Collecting enough data for analysis.' : 'No notable behavior detected.');
            const signalsHtml = signals.map(signal => {
                const signalName = humanizeIdentifier(signal.identifier);
                const signalDescription = signal.explanation || descriptionFor(signal.identifier);
                const confidence = enumName(signal.confidence, ['Low', 'Medium', 'High']);
                const confidenceDescription = `${confidence} confidence describes how complete and independently supported the required evidence is. It is not a probability or severity score.`;
                const evidenceHtml = (signal.evidence || []).map(item => `<span class="profiling-evidence"><span>${escapeHtml(humanizeIdentifier(item.identifier))}: <strong>${formatNumber(item.value)} ${escapeHtml(item.unit)}</strong></span>${infoHtml(descriptionFor(item.identifier), humanizeIdentifier(item.identifier))}</span>`).join('');
                return `<article class="profiling-signal"><div class="d-flex justify-content-between gap-2"><div class="profiling-signal-title"><strong>${escapeHtml(enumName(signal.label, ['Notable', 'Investigate']))} · ${escapeHtml(signalName)}</strong>${infoHtml(signalDescription, signalName)}<code class="profiling-technical-name">${escapeHtml(signal.identifier)}</code></div><span class="badge text-bg-secondary">${escapeHtml(confidence)} confidence ${infoHtml(confidenceDescription, `${confidence} confidence`)}</span></div><p class="mb-1 mt-2">${escapeHtml(signalDescription)}</p><div class="small text-muted"><strong>Suggested next step:</strong> ${escapeHtml(signal.suggestedAction)}</div><div class="small mt-1" aria-label="Signal evidence">${evidenceHtml}</div></article>`;
            }).join('');
            const kpiHtml = kpis.map(item => {
                const label = humanizeIdentifier(item.identifier);
                return `<div class="profiling-kpi"><span class="profiling-kpi-label">${escapeHtml(label)} ${infoHtml(descriptionFor(item.identifier), label)}</span><strong>${formatNumber(item.value)} ${escapeHtml(item.unit)}</strong><code class="profiling-technical-name">${escapeHtml(item.identifier)}</code></div>`;
            }).join('');
            target.innerHTML = `<div class="profiling-analysis-inner"><div class="d-flex flex-wrap justify-content-between gap-2"><strong>${escapeHtml(headline)} ${infoHtml('A signal is emitted only when a fixed rule is supported by the available measurements. Signals remain independent and are never combined.', 'Evidence-backed signals')}</strong><span class="small text-muted">${result.scope?.snapshotCount ?? 0} snapshots · ${result.scope?.provisional ? 'provisional' : 'terminal'} · ${escapeHtml(sufficiency)}</span></div>${signalsHtml}<div class="profiling-kpi-grid" aria-label="Evaluation key performance indicators">${kpiHtml}</div>${limitations.length ? `<div class="small text-muted mt-2"><strong>Limitations:</strong> ${limitations.map(escapeHtml).join(' · ')}</div>` : ''}</div>`;
        }

        function renderComparison(result) {
            const body = document.querySelector('#profiling-delta-table tbody');
            if (!body || !result) return;
            const metrics = result.metrics || [];
            body.innerHTML = metrics.map(item => {
                const label = humanizeIdentifier(item.identifier);
                return `<tr><td><span class="profiling-metric-name">${escapeHtml(label)} ${infoHtml(descriptionFor(item.identifier), label)}</span><code class="profiling-technical-name">${escapeHtml(item.identifier)}</code></td><td>${escapeHtml(item.unit)}</td><td class="text-end">${formatNumber(item.earlierValue)}</td><td class="text-end">${formatNumber(item.laterValue)}</td><td class="text-end">${formatNumber(item.difference)}</td><td class="text-end">${item.percentageDifference === null || item.percentageDifference === undefined ? 'unavailable' : `${formatNumber(item.percentageDifference)}%`}</td></tr>`;
            }).join('') || '<tr><td colspan="6" class="text-muted">No comparable raw metrics were returned.</td></tr>';
        }

        async function analyzeTimeline(isAutomatic = false) {
            if (state.analysisInFlight || !state.root?.dataset.sessionKey || !state.root?.dataset.nodeKey) return;
            state.analysisInFlight = true;
            const button = document.querySelector('#profiling-analyze-now');
            if (button) button.disabled = true;
            try {
                state.sessionAnalysis = await request(state.root.dataset.analyzePath, 'POST', { sessionKey: state.root.dataset.sessionKey, nodeKey: state.root.dataset.nodeKey });
                renderAnalysis('#profiling-session-analysis-result', state.sessionAnalysis);
            } catch (error) { showOutcome(error.message, 'danger'); }
            finally { state.analysisInFlight = false; if (button) button.disabled = false; }
        }

        async function analyzePair() {
            const a = document.querySelector('#profiling-snapshot-a');
            const b = document.querySelector('#profiling-snapshot-b');
            const validation = document.querySelector('#profiling-pair-validation');
            const sequenceA = Number(a?.selectedOptions[0]?.dataset.sequence);
            const sequenceB = Number(b?.selectedOptions[0]?.dataset.sequence);
            if (!a?.value || !b?.value || !(sequenceA < sequenceB)) {
                if (validation) validation.textContent = 'Select exactly two snapshots with A earlier than B.';
                return;
            }
            validation.textContent = '';
            const selection = { sessionKey: state.root.dataset.sessionKey, nodeKey: state.root.dataset.nodeKey, snapshotAKey: a.value, snapshotBKey: b.value };
            try {
                [state.pairAnalysis, state.comparison] = await Promise.all([
                    request(state.root.dataset.analyzePath, 'POST', selection),
                    request(state.root.dataset.comparePath, 'POST', selection)
                ]);
                renderAnalysis('#profiling-pair-analysis', state.pairAnalysis);
                renderComparison(state.comparison);
            } catch (error) { validation.textContent = error.message; }
        }

        async function runAction(url, method, body, label, confirmation, selectResultSession = false) {
            if (confirmation && !window.confirm(confirmation)) return false;
            try {
                const result = await request(url, method, body);
                showOutcome(summarizeControl(result, label), 'success');
                const resultSession = result?.session?.identity?.key;
                if (selectResultSession && resultSession && resultSession !== state.root?.dataset.sessionKey) {
                    await selectContext(resultSession, null);
                    return true;
                }
                await state.refresher?.refresh(true);
                return true;
            } catch (error) {
                showOutcome(error.message, 'danger');
                return false;
            }
        }

        const wait = milliseconds => new Promise(resolve => window.setTimeout(resolve, milliseconds));

        async function waitForNewSnapshot(sessionKey, previousLatestSnapshotKey) {
            for (let attempt = 0; attempt < 15; attempt++) {
                const currentSessionKey = state.root?.dataset.sessionKey;
                const latestSnapshotKey = state.root?.dataset.latestSnapshotKey;
                if (currentSessionKey === sessionKey && latestSnapshotKey && latestSnapshotKey !== previousLatestSnapshotKey) {
                    return latestSnapshotKey;
                }

                await wait(200);
                await state.refresher?.refresh(true);
            }

            return null;
        }

        async function takeSnapshot() {
            const previousSessionKey = state.root?.dataset.sessionKey || null;
            const previousLatestSnapshotKey = state.root?.dataset.latestSnapshotKey || null;
            try {
                const result = await request(state.root.dataset.snapshotPath, 'POST', { name: null });
                showOutcome(summarizeControl(result, 'Snapshot requested.'), 'success');
                const resultSessionKey = result?.session?.identity?.key || previousSessionKey;
                if (!resultSessionKey) {
                    await state.refresher?.refresh(true);
                    return true;
                }

                if (resultSessionKey !== previousSessionKey) {
                    await selectContext(resultSessionKey, null);
                } else {
                    await selectSnapshot(null);
                }

                const baselineSnapshotKey = resultSessionKey === previousSessionKey
                    ? previousLatestSnapshotKey
                    : null;
                const latestSnapshotKey = await waitForNewSnapshot(resultSessionKey, baselineSnapshotKey);
                if (latestSnapshotKey) {
                    await selectSnapshot(latestSnapshotKey);
                    return true;
                }

                showOutcome('Snapshot was accepted but is not visible yet. Use Refresh to check again.', 'warning');
                return true;
            } catch (error) {
                showOutcome(error.message, 'danger');
                return false;
            }
        }

        function resetStressButton(button) {
            button.disabled = false;
            button.classList.remove('is-running');
            button.removeAttribute('aria-busy');
            button.title = 'Stress this process for 30 seconds with high CPU, managed allocations, and retained memory';
        }

        async function startStress(button) {
            button.disabled = true;
            button.classList.add('is-running');
            button.setAttribute('aria-busy', 'true');
            try {
                const result = await request(state.root?.dataset.stressPath, 'POST');
                const durationSeconds = Number(result?.durationSeconds) || 30;
                const retainedMiB = Math.round((Number(result?.retainedMemoryBytes) || 0) / 1048576);
                button.title = `Profiling stress workload running for ${durationSeconds} seconds`;
                showOutcome(`Stress workload started for ${durationSeconds} seconds with ${result?.workerCount || 1} CPU workers and ${retainedMiB} MiB retained memory.`, 'success');
                window.clearTimeout(state.stressTimeout);
                state.stressTimeout = window.setTimeout(() => resetStressButton(button), durationSeconds * 1000);
            } catch (error) {
                resetStressButton(button);
                showOutcome(error.message, 'danger');
            }
        }

        function activateTab(requestedTab, focus = false) {
            const tabs = Array.from(document.querySelectorAll('[data-profiling-tab]'));
            const panels = Array.from(document.querySelectorAll('[data-profiling-tab-panel]'));
            if (!tabs.length || !panels.length) return;
            const tab = tabs.some(item => item.dataset.profilingTab === requestedTab) ? requestedTab : 'overview';
            tabs.forEach(item => {
                const active = item.dataset.profilingTab === tab;
                item.classList.toggle('is-active', active);
                item.setAttribute('aria-selected', active ? 'true' : 'false');
                item.tabIndex = active ? 0 : -1;
                if (active && focus) item.focus();
            });
            panels.forEach(item => { item.hidden = item.dataset.profilingTabPanel !== tab; });
            localStorage.setItem(storage.tab, tab);
            if (tab === 'overview') scheduleChartRender();
        }

        function synchronizeCollectionControls() {
            const running = state.root?.dataset.sessionRunning === 'true';
            const sessionToggle = document.querySelector('#profiling-session-toggle');
            const markerInput = document.querySelector('#profiling-marker-name');
            const markerButton = document.querySelector('#profiling-add-marker');
            const metadataButton = document.querySelector('#profiling-edit-metadata');

            if (sessionToggle) {
                sessionToggle.dataset.sessionAction = running ? 'stop' : 'start';
                sessionToggle.title = running ? 'Stop the active profiling session' : 'Start a profiling session';
                sessionToggle.setAttribute('aria-label', running ? 'Stop profiling session' : 'Start profiling session');
                sessionToggle.classList.toggle('btn-danger', running);
                sessionToggle.classList.toggle('is-running', running);
                sessionToggle.classList.toggle('btn-success', !running);
                sessionToggle.classList.toggle('is-stopped', !running);
                const icon = sessionToggle.querySelector('i');
                if (icon) icon.className = `bi ${running ? 'bi-stop-fill' : 'bi-play-fill'}`;
            }

            if (markerInput) {
                markerInput.disabled = !running;
                markerInput.title = running
                    ? 'Name a marker for the active session'
                    : 'Start a session before adding a marker';
            }

            if (markerButton) {
                markerButton.disabled = !running;
                markerButton.title = running
                    ? 'Add phase marker'
                    : 'Start a session before adding a marker';
            }

            if (metadataButton) {
                const hasSession = Boolean(state.root?.dataset.sessionKey);
                metadataButton.disabled = !hasSession;
                metadataButton.title = hasSession
                    ? 'View or edit session metadata'
                    : 'Select a profiling session to view or edit metadata';
            }
        }

        function initializeContent() {
            state.root = document.querySelector('#profiling-dashboard-data');
            if (!state.root) return;
            state.data = decodePayload(state.root.dataset.profilingPayload);
            synchronizeCollectionControls();
            if (state.lastOutcome) showOutcome(state.lastOutcome.message, state.lastOutcome.kind);
            const scope = `${state.root.dataset.sessionKey || ''}/${state.root.dataset.nodeKey || ''}`;
            const latest = state.root.dataset.latestSnapshotKey || null;
            const isNew = state.observationScope === scope && state.lastObservedSnapshot !== null && latest !== null && latest !== state.lastObservedSnapshot;
            state.observationScope = scope;
            state.lastObservedSnapshot = latest;

            const live = localStorage.getItem(storage.live) === 'true';
            const liveSwitch = document.querySelector('#profiling-live-analysis');
            if (liveSwitch) liveSwitch.checked = live;
            const filters = getFilters();
            ['phases', 'actions', 'segments'].forEach(key => { const input = document.querySelector(`#profiling-filter-${key}`); if (input) input.checked = filters[key] !== false; });
            setSessionsExpanded(localStorage.getItem(storage.sessions) !== 'false');
            setSnapshotDetailsExpanded(localStorage.getItem(storage.snapshotDetails) !== 'false');
            localizeSnapshotOptions();
            activateTab(localStorage.getItem(storage.tab) || 'overview');
            if (state.sessionAnalysis) renderAnalysis('#profiling-session-analysis-result', state.sessionAnalysis);
            if (state.pairAnalysis) renderAnalysis('#profiling-pair-analysis', state.pairAnalysis);
            if (state.comparison) renderComparison(state.comparison);
            synchronizeSnapshotCopyFeedback();
            if (document.querySelector('#profiling-snapshot-focus-modal.show')) renderSnapshotFocus();
            if (live && isNew && !state.analysisInFlight) analyzeTimeline(true);
        }

        function bindEvents() {
            document.addEventListener('change', event => {
                if (event.target.matches('#profiling-session-select')) selectContext(event.target.value, null);
                if (event.target.matches('#profiling-node-select')) selectContext(state.root?.dataset.sessionKey, event.target.value);
                if (event.target.matches('#profiling-snapshot-select')) selectSnapshot(event.target.value);
                if (event.target.matches('#profiling-live-analysis')) localStorage.setItem(storage.live, event.target.checked ? 'true' : 'false');
                if (event.target.matches('.profiling-chart-filter')) {
                    const filters = { phases: document.querySelector('#profiling-filter-phases')?.checked !== false, actions: document.querySelector('#profiling-filter-actions')?.checked !== false, segments: document.querySelector('#profiling-filter-segments')?.checked !== false };
                    localStorage.setItem(storage.filters, JSON.stringify(filters));
                    scheduleChartRender();
                }
            });
            document.addEventListener('submit', event => {
                if (event.target.matches('#profiling-start-form')) {
                    event.preventDefault();
                    if (state.root?.dataset.sessionRunning === 'true') {
                        showOutcome('Stop the active session before starting another one.', 'warning');
                        return;
                    }
                    const name = document.querySelector('#profiling-start-name')?.value.trim() || null;
                    const interval = Number(document.querySelector('#profiling-start-interval')?.value);
                    const duration = Number(document.querySelector('#profiling-start-duration')?.value);
                    runAction(state.root.dataset.startPath, 'POST', { name, samplingInterval: toTimeSpan(interval), duration: toTimeSpan(duration * 1000), tags: [] }, 'Collection started.', undefined, true);
                }
                if (event.target.matches('#profiling-metadata-form')) {
                    event.preventDefault();
                    runAction(state.root.dataset.metadataPath, 'PUT', { name: document.querySelector('#profiling-metadata-name')?.value.trim() || null, tags: (document.querySelector('#profiling-metadata-tags')?.value || '').split(',').map(item => item.trim()).filter(Boolean), note: document.querySelector('#profiling-metadata-note')?.value.trim() || null, isPinned: document.querySelector('#profiling-metadata-pinned')?.checked === true }, 'Metadata saved.')
                        .then(succeeded => {
                            if (succeeded) window.bootstrap.Modal.getOrCreateInstance(document.querySelector('#profiling-metadata-modal')).hide();
                        });
                }
                if (event.target.matches('#profiling-archive-import-form')) {
                    event.preventDefault();
                    importArchive(event.target)
                        .then(result => {
                            showOutcome(`Session imported as ${result.sessionKey}.`, 'success');
                            selectContext(result.sessionKey, null);
                        })
                        .catch(error => showOutcome(error.message, 'danger'));
                }
            });
            document.addEventListener('click', event => {
                const tab = event.target.closest('[data-profiling-tab]');
                if (tab) {
                    activateTab(tab.dataset.profilingTab);
                    return;
                }
                const button = event.target.closest('button');
                if (!button) return;
                if (button.dataset.profilingChartFocus) {
                    openFocusedChart(button.dataset.profilingChartFocus);
                    return;
                }
                if (button.id === 'profiling-toggle-sessions') {
                    setSessionsExpanded(button.getAttribute('aria-expanded') !== 'true', true);
                    return;
                }
                if (button.id === 'profiling-session-toggle') {
                    if (state.root?.dataset.sessionRunning === 'true') {
                        runAction(state.root.dataset.stopPath, 'POST', undefined, 'Stop requested.');
                    } else {
                        document.querySelector('#profiling-start-form')?.requestSubmit();
                    }
                    return;
                }
                if (button.dataset.requiresRunning === 'true' && state.root?.dataset.sessionRunning !== 'true') { showOutcome('Start an active session before using this action.', 'warning'); return; }
                if (button.id === 'profiling-snapshot') takeSnapshot();
                if (button.id === 'profiling-gc') runAction(state.root.dataset.gcPath, 'POST', undefined, 'GC requested.');
                if (button.id === 'profiling-stress') startStress(button);
                if (button.id === 'profiling-add-marker') runAction(state.root.dataset.markerPath, 'POST', { name: document.querySelector('#profiling-marker-name')?.value.trim() }, 'Phase marker added.');
                if (button.id === 'profiling-delete-session') runAction(state.root.dataset.deletePath, 'DELETE', undefined, 'Session deleted.', 'Delete the selected terminal profiling session and all of its data?');
                if (button.id === 'profiling-delete-unpinned') runAction(state.root.dataset.deleteUnpinnedPath, 'DELETE', undefined, 'Unpinned sessions deleted.', 'Delete every unpinned terminal profiling session?');
                if (button.id === 'profiling-clear') runAction(state.root.dataset.clearPath, 'POST', { confirmed: true }, 'Profiling store cleared.', 'Clear ALL profiling data? This includes pinned sessions, snapshots, markers, segments, custom metrics, node records, and invalidated identities. This cannot be undone.');
                if (button.id === 'profiling-analyze-now') analyzeTimeline(false);
                if (button.id === 'profiling-compare') analyzePair();
                if (button.id === 'profiling-toggle-snapshot-details') {
                    setSnapshotDetailsExpanded(button.getAttribute('aria-expanded') !== 'true', true);
                    return;
                }
                if (button.id === 'profiling-reset-snapshot') {
                    const select = document.querySelector('#profiling-snapshot-select');
                    if (select) select.value = '';
                    selectSnapshot(null);
                }
                if (button.id === 'profiling-focus-snapshot') {
                    openSnapshotFocus();
                    return;
                }
                if (button.id === 'profiling-copy-snapshot') {
                    const inspected = inspectedSnapshot();
                    if (!inspected) { showOutcome('No snapshot is available to copy.', 'warning'); return; }
                    copyText(JSON.stringify(inspected, null, 2)).then(copied => {
                        if (copied) {
                            showSnapshotCopiedFeedback();
                        }
                        showOutcome(copied ? 'Snapshot copied as JSON.' : 'Clipboard access was denied.', copied ? 'success' : 'danger');
                    });
                }
            });
            const focusModal = document.querySelector('#profiling-chart-focus-modal');
            focusModal?.addEventListener('shown.bs.modal', renderFocusedChart);
            focusModal?.addEventListener('hidden.bs.modal', () => {
                const targets = [document.querySelector('#profiling-focused-memory-chart'), document.querySelector('#profiling-focused-gc-chart')].filter(Boolean);
                if (!targets.length) return;
                window.bdkDashboard.loadPlotly()
                    .then(Plotly => targets.forEach(target => Plotly.purge(target)))
                    .catch(() => targets.forEach(target => target.replaceChildren()));
            });
            document.addEventListener('keydown', event => {
                const tab = event.target.closest?.('[data-profiling-tab]');
                if (!tab || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
                const tabs = Array.from(document.querySelectorAll('[data-profiling-tab]'));
                const current = tabs.indexOf(tab);
                const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (current + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
                event.preventDefault();
                activateTab(tabs[next].dataset.profilingTab, true);
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            initializeContent();
            bindEvents();
            const refreshSelect = document.querySelector('#profiling-refresh-interval');
            if (refreshSelect && localStorage.getItem(storage.refresh) === null && state.root?.dataset.refreshInterval) refreshSelect.value = state.root.dataset.refreshInterval;
            state.refresher = window.bdkDashboard.createRefresher({
                buildUrl: buildContentUrl,
                contentSelector: '#dashboard-profiling-content',
                statusSelector: '#profiling-refresh-status',
                intervalSelector: '#profiling-refresh-interval',
                refreshButtonSelector: '#profiling-refresh-now',
                storageKey: storage.refresh,
                applyResponse: applyContentRefresh,
                onSuccess: initializeContent
            });

            const current = new URL(window.location.href);
            if (!current.searchParams.has('session')) {
                const savedSession = localStorage.getItem(storage.session);
                const savedNode = localStorage.getItem(storage.node);
                if (savedSession) selectContext(savedSession, savedNode);
            }
            document.addEventListener('bdk-dashboard-theme-changed', scheduleChartRender);
        });
    })();
</script>

@functions {
    public DashboardLayoutModel LayoutModel => new() { Title = "Profiling" };
}
