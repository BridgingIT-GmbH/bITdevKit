@using BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard.Pages.Operations
@using Microsoft.AspNetCore.Http
@using DashboardEndpoints = BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard.DashboardEndpoints
@using BridgingIT.DevKit.Common
@using BridgingIT.DevKit.Presentation.Web.Dashboard
@using BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard
@using Microsoft.Extensions.DependencyInjection
@inherits RazorSlice<OperationProfilingDashboardModel>
@{
    var options = HttpContext.RequestServices.GetRequiredService<DashboardEndpointsOptions>();
    var pagePath = DashboardEndpoints.BuildOperationsPath(options, Model.RequestsOnly);
}
<section data-operation-view data-refreshed-utc="@OperationProfilingViewModelBuilder.Utc(Model.RefreshedUtc)">
<template data-operation-node-options>@(await RenderPartialAsync<Nodes, OperationProfilingDashboardModel>(Model))</template>
@if (Model.Error is not null)
{
    <div class="alert alert-warning" role="alert">@Model.Error</div>
}
else
{
    <div class="operation-metrics mb-2">
        <article class="operation-metric"><span>Executions @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard.Pages.ProfilingHelp, string>("Retained, persisted executions matching these filters. Sampling and retention can reduce this count."))</span><strong>@Model.Groups.TotalOperationCount</strong></article>
        <article class="operation-metric"><span>Groups</span><strong>@Model.Groups.TotalGroupCount</strong></article>
        <article class="operation-metric"><span>Queued @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard.Pages.ProfilingHelp, string>("Pending persistence on the serving node. These executions are not yet included in the list."))</span><strong>@Model.Health?.QueueRecords</strong></article>
        <article class="operation-metric"><span>Dropped @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard.Pages.ProfilingHelp, string>("Executions dropped on the serving node. Stored counts may include other nodes when the provider is shared."))</span><strong class="@(Model.Health?.DroppedOperations > 0 ? "text-warning" : "")">@Model.Health?.DroppedOperations</strong></article>
    </div>
    <details data-preserve-key="health" class="mb-3"><summary>Capture health</summary><dl class="row small mt-2">
        <dt class="col-sm-4">Provider / serving node</dt><dd class="col-sm-8">@Model.Health?.ProviderScope / @Model.Health?.CountersNodeId</dd>
        <dt class="col-sm-4">Last local flush UTC</dt><dd class="col-sm-8">@OperationProfilingViewModelBuilder.Utc(Model.Health?.LastSuccessfulFlushUtc ?? default)</dd>
        <dt class="col-sm-4">Local admitted / active / rejected</dt><dd class="col-sm-8">@Model.Health?.AdmittedOperations / @Model.Health?.ActiveOperations / @Model.Health?.RejectedOperations</dd>
        <dt class="col-sm-4">Local queue / in flight / oldest age</dt><dd class="col-sm-8">@Model.Health?.QueueRecords / @Model.Health?.InFlightRecords / @(Model.Health?.QueueOldestAgeUnavailable == true ? "Unavailable" : OperationProfilingViewModelBuilder.Duration(Model.Health?.QueueOldestAge ?? default))</dd>
        <dt class="col-sm-4">Local dropped / unknown / administrative discards</dt><dd class="col-sm-8">@Model.Health?.DroppedOperations / @Model.Health?.UnknownCommits / @Model.Health?.AdministrativeDiscards</dd>
        <dt class="col-sm-4">Local eligible / selected / sampling errors</dt><dd class="col-sm-8">@Model.Health?.EligibleRequests / @Model.Health?.SelectedRequests / @Model.Health?.SamplingErrors</dd>
        <dt class="col-sm-4">Local policy / configuration</dt><dd class="col-sm-8">@Model.Health?.SamplingStrategyKey / @Model.Health?.SamplingConfigurationKey</dd>
        <dt class="col-sm-4">Capture / writer / stalled / retention removals</dt><dd class="col-sm-8">@Model.Health?.CaptureEnabled / @Model.Health?.WriterActive / @Model.Health?.WriterStalled / @Model.Health?.RetentionRemovals</dd>
    </dl></details>
    @if (Model.Groups.Groups.Count == 0) { <div class="alert alert-secondary">No retained executions match this selection.</div> }
    @foreach (var group in Model.Groups.Groups)
    {
        var rows = Model.Query.View == OperationProfilingView.ByCount ? new[] { group.Representative } : group.Occurrences;
        <details open data-preserve-key="group-@group.ComparisonKey" class="card mb-3">
            <summary class="card-header"><strong>@group.Key</strong> · @group.Kind · @group.HttpMethod <span class="badge text-bg-secondary" title="Retained executions matching this group">@group.Count</span> @foreach (var key in Model.Query.GroupingDimensions) { var dimension = group.Dimensions.FirstOrDefault(value => ProfilingKeyComparer.Instance.Equals(value.Key, key)); <span class="badge text-bg-secondary ms-1">@key = @(dimension?.Value?.Scalar ?? "Missing") @dimension?.Value?.Type</span> }</summary>
            <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Execution / completed UTC</th><th>Node</th><th>Outcome</th>@if (Model.RequestsOnly) { <th>HTTP</th> }<th>Duration</th><th style="min-width:16rem">Duration breakdown @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard.Pages.ProfilingHelp, string>("Percent of operation duration spent in each segment. Parallel work and time outside segments are separate buckets."))</th></tr></thead><tbody>
            @foreach (var record in rows.Where(value => value is not null))
            {
                var detailsPath = pagePath + "/" + record.Id.ToString("D");
                var byCount = Model.Query.View == OperationProfilingView.ByCount;
                <tr><td><div class="d-flex align-items-center gap-2"><a href="@detailsPath" title="@record.Id">@(record.Id.ToString("N")[..8])</a><a class="btn btn-outline-secondary btn-sm @(byCount ? "operation-expand-group" : "operation-view-execution")" href="@(byCount ? Expand(group) : detailsPath)" title="@(byCount ? "View executions" : "View execution")" aria-label="@(byCount ? "View executions" : "View execution")"><i class="bi bi-eye" aria-hidden="true"></i></a></div><div class="small text-muted">@OperationProfilingViewModelBuilder.Utc(record.CompletedUtc)</div></td>
                    <td>@(record.Node.DisplayName ?? record.Node.HostName)<div class="small text-muted">@record.Node.Identity.Key @if (!string.IsNullOrEmpty(record.Node.ApplicationVersion)) { <span>· @record.Node.ApplicationVersion</span> }</div></td>
                    <td>@record.Outcome<div class="small text-warning">@OperationProfilingViewModelBuilder.Quality(record)</div>@if (record.Segments.Any(value => value.Outcomes.Any(bucket => bucket.Outcome == ProfilingSegmentOutcome.Failed && bucket.Statistics.Count > 0))) { <span class="badge text-bg-warning">Segment failures</span> }</td>
                    @if (Model.RequestsOnly) { <td>@record.Http?.Method @record.Http?.StatusCode<div class="small" title="Response measurement: @record.Http?.ResponseBytesQuality">@(record.Http?.ResponseBytes?.ToString(CultureInfo.InvariantCulture) ?? "—") bytes</div><span class="visually-hidden">Sampling: @record.Http?.SamplingStrategyKey</span>@(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard.Pages.ProfilingHelp, string>($"Sampling: {record.Http?.SamplingStrategyKey} / {record.Http?.SamplingConfigurationKey}; inclusion probability: {record.Http?.SamplingInclusionProbability?.ToString("0.####", CultureInfo.InvariantCulture) ?? "unknown"}."))</td> }
                    <td class="text-nowrap">@OperationProfilingViewModelBuilder.Duration(record.Duration)</td><td>@(await RenderPartialAsync<WallTime, OperationProfilingRecord>(record))</td>
                </tr>
            }
            </tbody></table></div>
        </details>
    }
    @if (Model.Groups.NextCursor is not null) { <a class="btn btn-outline-secondary btn-sm operation-next-page" href="@Next()">Next page</a> }
}
</section>
@functions {
    private string Next()
    {
        var values = HttpContext.Request.Query.Where(value => value.Key != "cursor" && value.Key != "_").ToDictionary(value => value.Key, value => value.Value.ToString());
        values["cursor"] = Model.Groups.NextCursor;
        return (HttpContext.Request.Path.Value.EndsWith("/content", StringComparison.Ordinal) ? HttpContext.Request.Path.Value[..^8] : HttpContext.Request.Path.Value) + QueryString.Create(values);
    }
    private string Expand(OperationProfilingGroup group)
    {
        var selector = Model.Query with { View = OperationProfilingView.Slow, Key = group.Key, Kind = group.Kind, HttpMethod = group.HttpMethod ?? Model.Query.HttpMethod,
            GroupDimensions = Model.Query.GroupingDimensions.Select(key => { var value = group.Dimensions.FirstOrDefault(dimension => ProfilingKeyComparer.Instance.Equals(dimension.Key, key))?.Value; return new ProfilingDimensionPredicate { Key = key, Value = value, Operator = value is null ? ProfilingDimensionOperator.Missing : ProfilingDimensionOperator.Equal }; }).ToArray(),
            GroupingDimensions = [], GroupByHttpMethod = false, Cursor = null, Boundary = null, FromUtc = Model.Groups.Boundary.FromUtc, ToUtc = Model.Groups.Boundary.ToUtc };
        var options = HttpContext.RequestServices.GetRequiredService<DashboardEndpointsOptions>();
        return DashboardEndpoints.BuildOperationsPath(options, Model.RequestsOnly) + QueryString.Create("query", System.Text.Json.JsonSerializer.Serialize(selector));
    }
}
