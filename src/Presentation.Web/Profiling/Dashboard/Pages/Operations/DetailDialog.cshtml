@inherits RazorSlice
<div class="modal fade" id="operation-detail-modal" tabindex="-1" aria-labelledby="operation-detail-heading" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><h2 id="operation-detail-heading" class="modal-title h5">Execution details</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close execution details"></button></div>
        <div id="operation-detail-content" class="modal-body" aria-busy="false"></div>
        <div class="modal-footer"><button class="btn btn-outline-secondary btn-sm" type="button" data-bs-dismiss="modal">Close</button></div>
    </div></div>
</div>
