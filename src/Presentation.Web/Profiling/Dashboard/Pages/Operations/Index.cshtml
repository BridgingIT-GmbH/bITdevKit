@using BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard.Pages.Operations
@using Microsoft.AspNetCore.Http
@using DashboardEndpoints = BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard.DashboardEndpoints
@using System.Text.Json
@using BridgingIT.DevKit.Common
@using BridgingIT.DevKit.Presentation.Web.Dashboard
@using BridgingIT.DevKit.Presentation.Web.Dashboard.Pages
@using BridgingIT.DevKit.Presentation.Web.Profiling.Dashboard
@using Microsoft.Extensions.DependencyInjection
@inherits RazorSlice<OperationProfilingDashboardModel>
@implements IUsesLayout<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages._DashboardLayout, DashboardLayoutModel>
@{
    var options = HttpContext.RequestServices.GetRequiredService<DashboardEndpointsOptions>();
    var requestsOnly = Model.RequestsOnly;
    var query = Model.Query;
    var pagePath = DashboardEndpoints.BuildOperationsPath(options, requestsOnly);
    var advanced = JsonSerializer.Serialize(query with { Cursor = null, Boundary = null });
}
<nav class="nav nav-pills mb-3" aria-label="Profiling views"><a class="nav-link" href="@DashboardEndpoints.BuildProfilingPath(options)">Runtime</a><a class="nav-link @(!requestsOnly ? "active" : "")" href="@DashboardEndpoints.BuildOperationsPath(options)">Operations</a><a class="nav-link @(requestsOnly ? "active" : "")" href="@DashboardEndpoints.BuildOperationsPath(options, true)">Requests</a></nav>
<h1 class="h4">@(requestsOnly ? "Request" : "Operation") Profiling</h1>
<p class="small text-muted">Retained sampled executions, grouped by logical key, kind and selected typed dimensions. Counts represent retained observations.</p>
<form id="operation-filters" action="@pagePath" method="get" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-md-2"><label for="operation-view" class="form-label small">View</label><select id="operation-view" name="view" class="form-select form-select-sm">@foreach (var mode in Enum.GetValues<OperationProfilingView>()) { <option value="@mode" selected="@(query.View == mode)">@(mode == OperationProfilingView.ByCount ? "By count" : mode.ToString())</option> }</select></div>
        <div class="col-md-2"><label for="operation-limit" class="form-label small">Result limit</label><select id="operation-limit" name="limit" class="form-select form-select-sm">@foreach (var limit in new[] { 10, 25, 50, 100 }) { <option value="@limit" selected="@(query.PageSize == limit)">@limit</option> }</select></div>
        <div class="col-md-4"><label for="operation-key" class="form-label small">Logical key</label><input id="operation-key" name="key" value="@query.Key" class="form-control form-control-sm" maxlength="128" /></div>
        <div class="col-md-4"><label for="operation-kind" class="form-label small">Kind</label><input id="operation-kind" name="kind" value="@(requestsOnly ? OperationProfilingKind.HttpRequest.ToString() : query.Kind)" readonly="@requestsOnly" class="form-control form-control-sm" maxlength="128" /></div>
        <div class="col-md-4"><label for="operation-from" class="form-label small">From UTC (inclusive; default last 15 minutes)</label><input id="operation-from" name="fromUtc" value="@(query.FromUtc is DateTimeOffset from ? OperationProfilingViewModelBuilder.Utc(from) : "")" placeholder="2026-10-08T10:00:00.000Z" class="form-control form-control-sm" /></div>
        <div class="col-md-4"><label for="operation-to" class="form-label small">To UTC (exclusive; default now)</label><input id="operation-to" name="toUtc" value="@(query.ToUtc is DateTimeOffset to ? OperationProfilingViewModelBuilder.Utc(to) : "")" placeholder="2026-10-08T11:00:00.000Z" class="form-control form-control-sm" /></div>
        <div class="col-md-4"><label for="operation-node" class="form-label small">Exact node GUID</label><input id="operation-node" name="nodeId" value="@query.NodeId" class="form-control form-control-sm" /></div>
        <div class="col-md-4"><label for="operation-outcomes" class="form-label small">Root outcomes (comma separated; empty = all)</label><input id="operation-outcomes" name="outcomes" value="@string.Join(",", query.Outcomes)" class="form-control form-control-sm" /></div>
        <div class="col-md-4"><label for="operation-group" class="form-label small">Group dimensions (up to four names)</label><input id="operation-group" name="groupBy" value="@string.Join(",", query.GroupingDimensions)" class="form-control form-control-sm" /></div>
        <div class="col-md-4"><label for="operation-correlation" class="form-label small">Correlation ID</label><input id="operation-correlation" name="correlationId" value="@query.CorrelationId" class="form-control form-control-sm" maxlength="128" /></div>
    </div>
    <details class="mt-2" data-preserve-key="advanced-filters"><summary>Typed and advanced filters</summary><p class="small text-muted">This selector supports parent ID, application version, segment key/path/outcomes/dimensions, HTTP method/route/status, sampling policy and typed dimensions. Equality values retain their explicit type; this is a bounded selector, not an expression language. Basic controls override the corresponding selector fields.</p><label for="operation-query" class="form-label small">Typed selector JSON</label><textarea id="operation-query" name="query" rows="5" class="form-control font-monospace small" maxlength="16384">@advanced</textarea></details>
    <div class="d-flex gap-2 mt-3"><button class="btn btn-primary btn-sm" type="submit">Apply filters</button><a class="btn btn-outline-secondary btn-sm" href="@pagePath">Reset filters</a></div>
</form>
<div class="d-flex flex-wrap gap-2 align-items-center mb-3"><span id="operation-refresh-status" class="small text-muted" role="status">Showing retained data in UTC</span><label for="operation-refresh-interval" class="small">Auto refresh</label><select id="operation-refresh-interval" class="form-select form-select-sm" style="width:7rem"><option value="">Off</option><option value="1000">1 sec</option><option value="5000" selected>5 sec</option><option value="10000">10 sec</option><option value="30000">30 sec</option><option value="60000">60 sec</option></select><button id="operation-refresh-now" class="btn btn-outline-secondary btn-sm" type="button">Refresh latest</button></div>
<form id="operation-lookup" class="d-flex gap-2 mb-3"><label for="operation-id" class="visually-hidden">Diagnostics ID from response header</label><input id="operation-id" class="form-control form-control-sm" placeholder="Diagnostics ID from response header" pattern="[0-9a-fA-F-]{32,36}" required /><button class="btn btn-outline-primary btn-sm" type="submit">Find exact ID</button></form>
<div id="operation-content" data-content-url="@(pagePath + "/content")" data-page-url="@pagePath" data-requests-only="@requestsOnly" data-api-url="@(DashboardEndpoints.BuildOperationsPath(options) + "/api/analysis")">@(await RenderPartialAsync<Content, OperationProfilingDashboardModel>(Model))</div>
<details class="card card-body mt-3" data-preserve-key="comparison"><summary>Compare bounded retained timing distributions</summary><div class="d-flex gap-2 mt-2"><input id="operation-baseline-key" class="form-control form-control-sm" aria-label="Baseline logical key" placeholder="Baseline key" /><input id="operation-candidate-key" class="form-control form-control-sm" aria-label="Candidate logical key" placeholder="Candidate key" /><button type="button" id="operation-compare" class="btn btn-outline-primary btn-sm">Compare</button></div><p class="small text-muted">Uses the current selector with independently selected keys. Root midpoint medians and nearest-rank percentiles are calculated from retained observations; segment means use invocation counts.</p><pre id="operation-comparison" class="small text-wrap" role="status"></pre></details>
@(await RenderPartialAsync<Style>())
@(await RenderPartialAsync<Script>())
@functions {
    /// <summary>Gets the layout metadata for the Operations and Requests list.</summary>
    /// <example><code>var title = this.LayoutModel.Title;</code></example>
    public DashboardLayoutModel LayoutModel => new() { Title = "Operation Profiling" };
}
