@inherits RazorSlice
<script>
(() => {
    const content = document.getElementById('operation-content');
    if (!content) return;
    const detailModal = document.getElementById('operation-detail-modal');
    const detailBody = document.getElementById('operation-detail-content');
    const timingRoots = [content, detailBody].filter(Boolean);
    const form = document.getElementById('operation-filters');
    const tail = document.getElementById('operation-tail');
    const current = new URL(location.href);
    const stateKey = 'bdk.profiling.filters:' + content.dataset.pageUrl;
    let remembered = {};
    try { remembered = JSON.parse(localStorage.getItem(stateKey) || '{}') || {}; } catch { }
    const explicitSelection = form && [...form.elements].some(control => control.name && current.searchParams.has(control.name));
    const restoreFilters = form && !explicitSelection && !current.searchParams.has('cursor') && remembered.filters;
    if (restoreFilters) {
        for (const control of form.elements) {
            const value = remembered.filters[control.name];
            if (!control.name || typeof value !== 'string' || value.length > 16384) continue;
            if (control.name === 'limit' && ![...control.options].some(option => option.value === value)) { control.value = '50'; continue; }
            if (control.tagName === 'SELECT' && value && ![...control.options].some(option => option.value === value) && ['nodeId', 'kind'].includes(control.name)) control.add(new Option(value, value));
            control.value = control.type === 'datetime-local' ? value.slice(0, 16) : value;
        }
    }
    function remember() {
        if (!form) return;
        try { localStorage.setItem(stateKey, JSON.stringify({ filters: Object.fromEntries(new FormData(form)),
            details: remembered.details || {}, groupsCollapsed: remembered.groupsCollapsed === true })); } catch { }
    }
    document.addEventListener('toggle', event => {
        const key = event.target.dataset?.preserveKey;
        if (!form || !key) return;
        remembered.details = { ...(remembered.details || {}), [key]: event.target.open };
        remembered.details = Object.fromEntries(Object.entries(remembered.details).slice(-200));
        remember();
    }, true);
    function restoreDetails() {
        if (!form) return;
        document.querySelectorAll('details[data-preserve-key]').forEach(detail => {
            const value = remembered.details?.[detail.dataset.preserveKey];
            if (typeof value === 'boolean') detail.open = value;
            else if (detail.hasAttribute('data-operation-group') && remembered.groupsCollapsed === true) detail.open = false;
        });
    }
    document.getElementById('operation-collapse-all')?.addEventListener('click', () => {
        remembered.groupsCollapsed = true;
        remembered.details = Object.fromEntries(Object.entries(remembered.details || {}).map(([key, value]) => [key, key.startsWith('group-') ? false : value]));
        content.querySelectorAll('details[data-operation-group]').forEach(group => {
            group.open = false;
            remembered.details[group.dataset.preserveKey] = false;
        });
        remembered.details = Object.fromEntries(Object.entries(remembered.details).slice(-200));
        remember();
    });
    form?.addEventListener('input', remember);
    window.addEventListener('pagehide', remember);
    document.getElementById('operation-reset')?.addEventListener('click', event => {
        try { localStorage.removeItem(stateKey); } catch { }
        // Prevent pagehide from saving the discarded form over the reset state.
        window.removeEventListener('pagehide', remember);
        const url = new URL(event.currentTarget.href);
        if (current.searchParams.has('dashboardView')) url.searchParams.set('dashboardView', current.searchParams.get('dashboardView'));
        event.currentTarget.href = url;
    });
    let olderController = null;
    function cancelOlder() {
        olderController?.abort(); olderController = null;
        const button = content.querySelector('[data-operation-load-more]');
        if (button) { button.disabled = false; button.textContent = 'Load more'; }
    }
    function unpin() { cancelOlder(); cancelTail(); current.searchParams.delete('cursor'); document.getElementById('operation-refresh-status').removeAttribute('title'); }
    function selectionUrl() {
        const url = new URL(content.dataset.contentUrl, location.origin);
        if (current.searchParams.has('dashboardView')) url.searchParams.set('dashboardView', current.searchParams.get('dashboardView'));
        let advanced = {};
        try { advanced = JSON.parse(document.getElementById('operation-query')?.value || '{}') || {}; } catch { }
        const exactKey = advanced.key ?? advanced.Key;
        if (form) new FormData(form).forEach((value, key) => {
            // A group count link carries an exact selector. Preserve that scope while refreshing
            // its unchanged control; editing the key deliberately switches to contains matching.
            if (key === 'key' && value === exactKey && !(advanced.keyContains ?? advanced.KeyContains)) return;
            // datetime-local represents the explicitly labelled UTC clock, not the browser's timezone.
            url.searchParams.set(key, (key === 'fromUtc' || key === 'toUtc') && value ? value + 'Z' : value);
        });
        else current.searchParams.forEach((value, key) => url.searchParams.set(key, value));
        return url;
    }
    function pagingUrl(value) {
        const url = new URL(value, location.origin);
        const limit = form?.elements.namedItem('limit')?.value;
        if (limit) url.searchParams.set('limit', limit);
        return url;
    }
    function synchronizeNodes() {
        const select = document.getElementById('operation-node');
        const source = content.querySelector('template[data-operation-node-options]');
        if (!select || !source) return;
        const selected = select.value;
        select.replaceChildren(source.content.cloneNode(true));
        if (selected && ![...select.options].some(option => option.value === selected)) {
            select.add(new Option(`Node ${selected.replaceAll('-', '').slice(0, 8)}`, selected));
        }
        select.value = selected;
    }
    function synchronizeMetadata() {
        for (const [selector, targetId] of [['template[data-operation-health]', 'operation-health-content']]) {
            const source = content.querySelector(selector), target = document.getElementById(targetId);
            if (source && target) target.replaceChildren(source.content.cloneNode(true));
        }
        window.bdkOperationComparison?.synchronize();
        window.bdkOperationDimensions?.refreshChoices?.();
    }
    let timingMode = 'duration';
    try { if (localStorage.getItem('bdk.profiling.segment-timing') === 'percentage') timingMode = 'percentage'; } catch { }
    function applyTimingMode() {
        timingRoots.forEach(root => root.querySelectorAll('[data-segment-timing]').forEach(value => { value.textContent = value.dataset[timingMode]; }));
        timingRoots.forEach(root => root.querySelectorAll('[data-segment-timing-mode]').forEach(button => {
            const active = button.dataset.segmentTimingMode === timingMode;
            button.classList.toggle('active', active);
            button.setAttribute('aria-pressed', String(active));
        }));
    }
    timingRoots.forEach(root => root.addEventListener('click', event => {
        const button = event.target.closest('[data-segment-timing-mode]');
        if (!button) return;
        timingMode = button.dataset.segmentTimingMode;
        try { localStorage.setItem('bdk.profiling.segment-timing', timingMode); } catch { }
        applyTimingMode();
    }));
    function captureState() {
        return { open: new Set([...content.querySelectorAll('details[open][data-preserve-key]')].map(value => value.dataset.preserveKey)),
            closed: new Set([...content.querySelectorAll('details:not([open])[data-preserve-key]')].map(value => value.dataset.preserveKey)), x: scrollX, y: scrollY };
    }
    function restoreState(state) {
        content.querySelectorAll('details[data-preserve-key]').forEach(value => {
            if (state.open.has(value.dataset.preserveKey)) value.open = true;
            else if (state.closed.has(value.dataset.preserveKey)) value.open = false;
        });
        scrollTo(state.x, state.y);
    }
    function positionTooltip(target) {
        const tip = target.querySelector('.operation-wall-tip');
        if (!tip) return;
        const rect = target.getBoundingClientRect();
        tip.style.left = Math.max(8, Math.min(rect.left, innerWidth - Math.min(480, innerWidth - 16))) + 'px';
        tip.style.top = Math.max(8, rect.top - 45) + 'px';
    }
    timingRoots.forEach(root => {
        root.addEventListener('mouseover', event => { const target = event.target.closest('.operation-wall-bucket'); if (target) positionTooltip(target); });
        root.addEventListener('focusin', event => { const target = event.target.closest('.operation-wall-bucket'); if (target) positionTooltip(target); });
    });
    async function charts(root = content) {
        const host = root.querySelector('[data-runtime-overlay]');
        if (!host) return;
        let overlay;
        try { overlay = JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(host.dataset.runtimeOverlay), value => value.charCodeAt(0)))); }
        catch { return; }
        if (!overlay.samples?.length) return;
        const Plotly = await window.bdkDashboard.loadPlotly();
        if (!host.isConnected) return;
        const theme = window.bdkDashboard.getChartTheme();
        const colors = [theme.primary, theme.secondary, theme.warning];
        const timestamp = value => value ? new Date(value).toISOString().replace('T', ' ').replace('Z', ' UTC') : 'unavailable';
        const groups = new Map();
        overlay.samples.forEach(sample => { const key = sample.snapshot.sessionKey; if (!groups.has(key)) groups.set(key, []); groups.get(key).push(sample); });
        const specifications = [
            ['.operation-runtime-cpu', 'Process CPU (%) · UTC', '%', [['cpuUsagePercent','CPU',1]]],
            ['.operation-runtime-memory', 'Process memory (MiB) · UTC', 'MiB', [['workingSetBytes','Working set',1048576],['managedMemoryBytes','Managed',1048576]]],
            ['.operation-runtime-allocation', 'Process allocation (MiB/s; sample interval) · UTC', 'MiB/s', [['allocationRateBytesPerSecond','Allocation rate',1048576]]],
            ['.operation-runtime-gc', 'Process cumulative GC collections · UTC', 'collections', [['gen0CollectionCount','Gen 0',1],['gen1CollectionCount','Gen 1',1],['gen2CollectionCount','Gen 2',1]]]
        ];
        for (const [selector,title,unit,metrics] of specifications) {
            const traces = [];
            for (const [session,samples] of groups) for (let metricIndex = 0; metricIndex < metrics.length; metricIndex++) {
                const [field,label,scale] = metrics[metricIndex];
                const x = [], y = [], text = [];
                samples.forEach(sample => {
                    if (sample.samplingGap || sample.clockDiscontinuity) { x.push(sample.snapshot.timestampUtc); y.push(null); text.push('Sampling gap or clock discontinuity'); }
                    x.push(sample.snapshot.timestampUtc); y.push(sample.snapshot[field] == null ? null : sample.snapshot[field] / scale);
                    text.push(sample.relation + (field === 'allocationRateBytesPerSecond' ? `<br>Rate interval:<br>${timestamp(sample.metricIntervalFromUtc)}<br>→ ${timestamp(sample.metricIntervalToUtc)}` : ''));
                });
                traces.push({ x, y, text, name: groups.size > 1 ? `${label} · ${session}` : label, mode: 'lines+markers', connectgaps: false, hovertemplate: `%{fullData.name}: %{y:.2f} ${unit}<br>%{text}<extra></extra>`, line: { color: colors[metricIndex % colors.length] } });
            }
            const baseLayout = window.bdkDashboard.createPlotlyLayout({ margin: { l: 55, r: 20, t: 45, b: 85 }, legend: { orientation: 'h', x: 0, y: -0.4 } });
            const layout = { ...baseLayout, title: { text: title }, xaxis: { ...baseLayout.xaxis, type: 'date', hoverformat: '%Y-%m-%d %H:%M:%S.%L UTC' },
                shapes: [{ type: 'rect', xref: 'x', yref: 'paper', x0: overlay.startedUtc, x1: overlay.completedUtc, y0: 0, y1: 1, fillcolor: `rgba(${window.bdkDashboard.getCssValue('--bs-primary-rgb')},.13)`, line: { width: 0 }, layer: 'below' }] };
            if (!host.isConnected) return;
            await Plotly.react(host.querySelector(selector), traces, layout, { responsive: true, displaylogo: false });
        }
    }
    let detailController = null;
    let detailTrigger = null;
    function clearDetail() {
        if (!detailBody) return;
        window.bdkProfiling.disposeHelp(detailBody);
        detailBody.querySelectorAll('.js-plotly-plot').forEach(chart => window.Plotly?.purge(chart));
        detailBody.replaceChildren();
        detailBody.setAttribute('aria-busy', 'false');
    }
    async function openDetail(button, url = button?.dataset.operationDetailUrl) {
        if (!url || !detailModal || !window.bootstrap?.Modal) return;
        detailController?.abort();
        const controller = new AbortController();
        detailController = controller;
        detailTrigger = button;
        clearDetail();
        const loading = document.createElement('p');
        loading.className = 'small text-muted'; loading.setAttribute('role', 'status'); loading.textContent = 'Loading execution details…';
        detailBody.setAttribute('aria-busy', 'true');
        detailBody.append(loading);
        bootstrap.Modal.getOrCreateInstance(detailModal).show(button);
        try {
            const response = await fetch(url, { signal: controller.signal, cache: 'no-store' });
            if (response.redirected || !(response.headers.get('content-type') || '').includes('text/html')) throw new Error('Unexpected response');
            const html = await response.text();
            if (controller.signal.aborted || controller !== detailController) return;
            detailBody.innerHTML = html;
            window.bdkDashboard.applySeriesColors(detailBody);
            detailBody.setAttribute('aria-busy', 'false');
            applyTimingMode(); restoreDetails(); window.bdkProfiling.initializeHelp(detailBody);
            try { await charts(detailBody); }
            catch {
                if (controller.signal.aborted || controller !== detailController) return;
                const notice = document.createElement('p'); notice.className = 'small text-warning'; notice.textContent = 'Runtime charts unavailable.';
                detailBody.append(notice);
            }
        } catch (error) {
            if (controller.signal.aborted || controller !== detailController) return;
            clearDetail();
            const notice = document.createElement('div'); notice.className = 'alert alert-warning'; notice.setAttribute('role', 'alert');
            notice.textContent = 'Execution details could not be loaded. Close this dialog and try again.'; detailBody.append(notice);
        }
    }
    window.bdkOperationDetails = { open: (url, trigger) => openDetail(trigger, url) };
    document.addEventListener('click', event => {
        const button = event.target.closest('[data-operation-detail-url]');
        if (!button) return;
        event.preventDefault(); openDetail(button);
    });
    detailModal?.addEventListener('hide.bs.modal', () => { detailController?.abort(); });
    detailModal?.addEventListener('hidden.bs.modal', () => {
        clearDetail();
        const trigger = detailTrigger?.isConnected ? detailTrigger
            : [...content.querySelectorAll('[data-operation-detail-url]')].find(button => button.dataset.operationDetailUrl === detailTrigger?.dataset.operationDetailUrl);
        (trigger || document.getElementById('operation-refresh-now') || document.getElementById('timeline-refresh-now'))?.focus();
    });
    detailModal?.addEventListener('shown.bs.modal', () => {
        detailBody.querySelectorAll('.js-plotly-plot').forEach(chart => window.Plotly?.Plots.resize(chart).catch(() => {}));
    });
    document.addEventListener('bdk-dashboard-theme-changed', () => timingRoots.forEach(root => charts(root).catch(() => {})));
    if (content.dataset.timeline === "true" || content.dataset.insights === "true") { applyTimingMode(); return; }
    let tailTimer = null;
    let tailController = null;
    let tailRequested = false;
    let filtersDirty = false;
    let tailBlocked = false;
    let tailCheckpoint = null;
    const tailKey = stateKey + ':tail';
    try { tailRequested = localStorage.getItem(tailKey) === 'true'; } catch { }
    function setStatus(text, failed = false) {
        const status = document.getElementById('operation-refresh-status');
        status.textContent = text;
        status.classList.toggle('text-danger', failed); status.classList.toggle('text-muted', !failed);
    }
    function cancelTail() {
        if (tailTimer !== null) { clearTimeout(tailTimer); tailTimer = null; }
        tailController?.abort(); tailController = null;
    }
    function updateTailControl() {
        if (!tail) return;
        const available = !!content.querySelector('[data-operation-view]')?.dataset.tailUrl && !tailBlocked
            && (!form || form.elements.namedItem('view')?.value === 'Recent');
        tail.disabled = !available;
        tail.checked = available && tailRequested;
        tail.title = tailBlocked ? 'Refresh the selection to resume tailing.' : filtersDirty ? 'Apply filters to resume tailing.' : available ? 'Prepend newly retained recordings.' : 'Tail is available in the Recent view.';
    }
    function scheduleTail() {
        if (tailTimer !== null) clearTimeout(tailTimer);
        tailTimer = null;
        updateTailControl();
        if (!tail?.checked || tail.disabled || filtersDirty || document.hidden || tailController !== null) return;
        tailTimer = setTimeout(loadNewer, 2000);
    }
    function resetTail() {
        cancelTail(); filtersDirty = tailBlocked = false;
        const view = content.querySelector('[data-operation-view]');
        tailCheckpoint = view ? { watermark: view.dataset.tailWatermark, epoch: view.dataset.tailEpoch, revision: view.dataset.tailRevision } : null;
        scheduleTail();
    }
    function mergeGroups(views, prepend = false) {
        const state = captureState();
        const readingAnchor = prepend && state.y > 0 ? [...content.querySelectorAll('[data-operation-id]')].find(row => {
            const bounds = row.getBoundingClientRect(); return bounds.height > 0 && bounds.top >= 0 && bounds.top < innerHeight;
        }) : null;
        const anchorTop = readingAnchor?.getBoundingClientRect().top;
        const existingGroups = new Map([...content.querySelectorAll('[data-operation-group]')].map(group => [group.dataset.preserveKey, group]));
        const ids = new Set([...content.querySelectorAll('[data-operation-id]')].map(row => row.dataset.operationId));
        const incoming = new Map();
        let loaded = 0;
        for (const view of views) {
            view.querySelectorAll('[data-operation-group]').forEach(group => {
                group.querySelectorAll('[data-operation-id]').forEach(row => {
                    if (ids.has(row.dataset.operationId)) row.remove();
                    else { ids.add(row.dataset.operationId); loaded++; }
                });
                const previous = incoming.get(group.dataset.preserveKey);
                if (previous) previous.querySelector('tbody').append(...group.querySelectorAll('[data-operation-id]'));
                else incoming.set(group.dataset.preserveKey, group);
            });
            for (const selector of ['template[data-operation-comparison-keys]', 'template[data-operation-comparison-groups]']) {
                const target = content.querySelector(selector), source = view.querySelector(selector);
                if (!target || !source) continue;
                const options = new Map([...target.content.querySelectorAll('option')].map(option => [option.value, option]));
                source.content.querySelectorAll('option').forEach(option => {
                    if (options.has(option.value)) { if (prepend) options.get(option.value).replaceWith(option); }
                    else target.content.append(option);
                    options.set(option.value, option);
                });
            }
        }
        const host = content.querySelector('[data-operation-view]');
        let anchor = host.querySelector('[data-operation-group], [data-operation-paging]');
        const groups = [...incoming.values()];
        (prepend ? groups.reverse() : groups).forEach(group => {
            const existing = existingGroups.get(group.dataset.preserveKey);
            if (existing) {
                const rows = [...group.querySelectorAll('[data-operation-id]')];
                if (prepend) {
                    window.bdkProfiling.disposeHelp(existing.querySelector('summary'));
                    existing.querySelector('summary').replaceWith(group.querySelector('summary'));
                    const statistics = group.querySelector('.operation-group-statistics');
                    if (statistics) existing.querySelector('.operation-group-statistics')?.replaceWith(statistics);
                    existing.querySelector('tbody').prepend(...rows);
                } else existing.querySelector('tbody').append(...rows);
                group = existing;
            }
            if (prepend) {
                if (anchor) anchor.before(group); else host.append(group);
                anchor = group;
            } else if (!existing) {
                const more = host.querySelector('[data-operation-paging]');
                if (more) more.before(group); else host.append(group);
            }
        });
        if (prepend) {
            const view = views[0];
            for (const selector of ['[data-operation-metrics]', 'template[data-operation-health]', 'template[data-operation-node-options]']) {
                const source = view.querySelector(selector), target = host.querySelector(selector);
                if (source && target) { window.bdkProfiling.disposeHelp(target); target.replaceWith(source); }
            }
            if (loaded > 0) host.querySelector('.alert-secondary')?.remove();
            synchronizeNodes();
        }
        window.bdkDashboard.applySeriesColors(content); restoreDetails(); restoreState(state);
        if (readingAnchor?.isConnected) scrollBy(0, readingAnchor.getBoundingClientRect().top - anchorTop);
        synchronizeMetadata(); applyTimingMode(); window.bdkProfiling.initializeHelp(content);
        return loaded;
    }
    async function readView(url, controller) {
        const response = await fetch(url, { cache: 'no-store', headers: { 'X-Requested-With': 'fetch' }, signal: controller.signal });
        if (!response.ok || response.redirected || !(response.headers.get('content-type') || '').includes('text/html')) {
            const error = new Error('Unexpected response'); error.status = response.status(); throw error;
        }
        const template = document.createElement('template'); template.innerHTML = await response.text();
        const view = template.content.querySelector('[data-operation-view]');
        if (!view) throw new Error('Unexpected response');
        return view;
    }
    const refresher = window.bdkDashboard.createRefresher({ contentElement: content, statusSelector: '#operation-refresh-status', buildUrl: selectionUrl,
        applyResponse: (element, html) => { const state = captureState(); window.bdkProfiling.disposeHelp(element); element.querySelectorAll('.js-plotly-plot').forEach(chart => window.Plotly?.purge(chart)); element.innerHTML = html; window.bdkDashboard.applySeriesColors(element); restoreState(state); synchronizeNodes(); synchronizeMetadata(); restoreDetails(); applyTimingMode(); window.bdkProfiling.initializeHelp(element); },
        onSuccess: () => { resetTail(); return charts(); }, formatUpdatedAt: window.bdkProfiling.formatUpdatedAt, errorText: 'Refresh failed; showing previous data.' });
    async function loadNewer() {
        tailTimer = null;
        if (!tail?.checked || tail.disabled || filtersDirty || document.hidden || tailController !== null || !tailCheckpoint) return;
        const source = content.querySelector('[data-operation-view]');
        if (!source?.dataset.tailUrl) return;
        const controller = new AbortController(); tailController = controller;
        try {
            const url = pagingUrl(source.dataset.tailUrl);
            url.searchParams.set('afterCommitWatermark', tailCheckpoint.watermark);
            const views = [];
            let next = url.toString();
            do {
                const view = await readView(next, controller);
                if (controller.signal.aborted || controller !== tailController) return;
                if (tailCheckpoint.epoch && (view.dataset.tailEpoch !== tailCheckpoint.epoch || view.dataset.tailRevision !== tailCheckpoint.revision)) {
                    const error = new Error('Publication boundary changed'); error.status = 400; throw error;
                }
                views.push(view);
                next = view.querySelector('[data-operation-load-more]')?.dataset.nextUrl;
            } while (next);
            const loaded = mergeGroups(views, true);
            const head = views[0];
            tailCheckpoint = { watermark: head.dataset.tailWatermark, epoch: head.dataset.tailEpoch, revision: head.dataset.tailRevision };
            window.bdkDashboard.clearRefreshError(content);
            setStatus(loaded ? `Added ${loaded} new ${loaded === 1 ? 'recording' : 'recordings'}` : window.bdkProfiling.formatUpdatedAt(new Date()));
        } catch (error) {
            if (error.name !== 'AbortError' && controller === tailController) {
                if (error.status === 400) tailBlocked = true;
                setStatus(tailBlocked ? 'Tail paused; refresh the selection.' : 'Tail failed; showing previous data.', true);
            }
        } finally {
            if (controller === tailController) { tailController = null; scheduleTail(); }
        }
    }
    async function loadOlder(button) {
        if (button.disabled || !button.dataset.nextUrl) return;
        cancelOlder(); refresher.cancel();
        const controller = new AbortController(); olderController = controller;
        button.disabled = true; button.textContent = 'Loading…';
        try {
            const view = await readView(pagingUrl(button.dataset.nextUrl), controller);
            if (controller.signal.aborted || controller !== olderController || !button.isConnected) return;
            const loaded = mergeGroups([view]);
            const next = view.querySelector('[data-operation-load-more]')?.dataset.nextUrl;
            if (next) button.dataset.nextUrl = next; else button.closest('[data-operation-paging]').remove();
            window.bdkDashboard.clearRefreshError(content);
            setStatus(`Loaded ${loaded} more ${loaded === 1 ? 'recording' : 'recordings'}`);
        } catch (error) {
            if (error.name !== 'AbortError' && controller === olderController) setStatus('Load failed; refresh or try again.', true);
        } finally {
            if (controller === olderController) {
                olderController = null;
                if (button.isConnected) { button.disabled = false; button.textContent = 'Load more'; }
            }
        }
    }
    content.addEventListener('click', event => {
        const button = event.target.closest('[data-operation-load-more]');
        if (button) loadOlder(button);
    });
    tail?.addEventListener('change', () => {
        tailRequested = tail.checked;
        try { localStorage.setItem(tailKey, String(tailRequested)); } catch { }
        cancelTail();
        if (tailRequested) loadNewer();
    });
    document.addEventListener('visibilitychange', () => { if (document.hidden) cancelTail(); else scheduleTail(); });
    window.addEventListener('pagehide', () => { cancelTail(); cancelOlder(); });
    document.getElementById('operation-refresh-now')?.addEventListener('click', () => { unpin(); const url = selectionUrl(); url.pathname = content.dataset.pageUrl; if (form) history.replaceState(null, '', url); refresher.refresh(true); });
    window.addEventListener('bdk:operation-group-deleted', () => {
        unpin(); const url = selectionUrl(); url.pathname = content.dataset.pageUrl;
        if (form) history.replaceState(null, '', url);
        refresher.refresh(true);
    });
    form?.addEventListener('submit', event => {
        event.preventDefault(); unpin();
        const url = selectionUrl(); url.pathname = content.dataset.pageUrl;
        history.replaceState(null, '', url); remember(); refresher.refresh(true);
    });
    function pauseForFilters(event) {
        remember(); cancelOlder(); cancelTail(); refresher.cancel();
        if (event.target.name === 'limit') {
            const url = new URL(location.href); url.searchParams.set('limit', event.target.value); history.replaceState(null, '', url);
            scheduleTail(); return;
        }
        filtersDirty = true; updateTailControl();
    }
    form?.addEventListener('input', pauseForFilters);
    form?.addEventListener('change', pauseForFilters);
    function selectionQuery() {
        const url = selectionUrl();
        const normalize = window.bdkOperationDimensions.normalize;
        const query = normalize(JSON.parse(url.searchParams.get('query') || '{}'));
        for (const name of ['kind', 'correlationId', 'applicationVersion', 'fromUtc', 'toUtc', 'nodeId']) if (url.searchParams.has(name)) query[name] = url.searchParams.get(name) || null;
        if (content.dataset.requestsOnly?.toLowerCase() === 'true') query.kind = 'HttpRequest';
        if (url.searchParams.has('key')) { query.keyContains = url.searchParams.get('key') || null; query.key = null; }
        query.cursor = query.boundary = null;
        return query;
    }
    window.bdkOperationDimensions?.initializeList(selectionQuery);
    applyTimingMode();
    synchronizeMetadata();
    restoreDetails();
    if (!restoreFilters) resetTail();
    if (restoreFilters) { const url = selectionUrl(); url.pathname = content.dataset.pageUrl; history.replaceState(null, '', url); refresher.refresh(true); }
    charts().catch(() => { document.getElementById('operation-refresh-status').textContent = 'Charts unavailable'; });
})();
</script>
