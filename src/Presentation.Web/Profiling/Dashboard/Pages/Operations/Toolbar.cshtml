@using BridgingIT.DevKit.Presentation.Web.Dashboard
@inherits RazorSlice<string>
<div class="dashboard-page-toolbar operation-toolbar d-flex flex-wrap justify-content-between align-items-center gap-2 py-2 mb-2 border-bottom">
    @if (!string.IsNullOrEmpty(Model))
    {
        <a href="@Model" class="btn btn-outline-secondary btn-sm" title="Back to the list" aria-label="Back to the list"><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
    }
    <div class="d-flex align-items-center gap-2 ms-auto">
        @if (string.IsNullOrEmpty(Model))
        {
            <button id="operation-collapse-all" class="btn btn-outline-secondary btn-sm" type="button" title="Collapse all groups" aria-label="Collapse all groups"><i class="bi bi-arrows-collapse" aria-hidden="true"></i></button>
            <button class="btn btn-outline-primary btn-sm" type="button" data-operation-comparison-open title="Compare executions of the same operation" aria-label="Compare executions"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></button>
        }
        <button class="btn btn-outline-info btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#operation-health-modal" title="Capture health" aria-label="Capture health"><i class="bi bi-heart-pulse" aria-hidden="true"></i></button>
        @(await RenderPartialAsync<BridgingIT.DevKit.Presentation.Web.Dashboard.Pages.RefreshControls, DashboardRefreshModel>(new("operation", "Refresh operations", false, string.IsNullOrEmpty(Model) ? "operation-tail" : null)))
    </div>
</div>
